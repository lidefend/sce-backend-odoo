{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart_core.contract_runtime_semantic_registry",
  "title": "Contract V2.7 client-independent semantic specification",
  "type": "object",
  "required": [
    "registry",
    "native_widgets",
    "native_view_widget_default",
    "native_view_widgets",
    "derivation",
    "semantics",
    "node_semantics"
  ],
  "properties": {
    "registry": { "const": "semantic" },
    "native_widgets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/nativeWidgetStatus" }
    },
    "native_view_widget_default": {
      "$ref": "#/$defs/nativeViewWidget"
    },
    "native_view_widgets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/nativeViewWidget" }
    },
    "derivation": {
      "type": "object",
      "required": ["default", "rules"],
      "properties": {
        "default": { "$ref": "#/$defs/semanticKey" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/derivationRule" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/fieldSemantic" }
    },
    "node_semantics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/nodeSemantic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semanticCategory": {
      "type": "string",
      "enum": ["basic", "temporal", "business", "relation", "collection", "behavioral", "auth", "industry"]
    },
    "semanticKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "fieldTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "whenClause": {
      "type": "object",
      "description": "Ordered semantic-derivation conditions. Every supplied condition must hold.",
      "properties": {
        "field_types": { "$ref": "#/$defs/fieldTypes" },
        "widgets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "widgets_exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "widget_suffix": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "derivationRule": {
      "type": "object",
      "required": ["semantic", "when"],
      "properties": {
        "semantic": { "$ref": "#/$defs/semanticKey" },
        "when": { "$ref": "#/$defs/whenClause" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fieldSemantic": {
      "type": "object",
      "required": ["category", "applies_to", "field_types"],
      "properties": {
        "category": { "$ref": "#/$defs/semanticCategory" },
        "applies_to": { "const": "field" },
        "field_types": { "$ref": "#/$defs/fieldTypes" }
      },
      "additionalProperties": false
    },
    "nodeSemantic": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "$ref": "#/$defs/semanticCategory" }
      },
      "additionalProperties": false
    },
    "nativeWidgetStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "fallback", "unsupported"] },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "nativeViewWidget": {
      "type": "object",
      "required": ["status", "semantic"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "fallback", "unsupported"] },
        "semantic": { "$ref": "#/$defs/semanticKey" },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "payload_required": { "type": "boolean" },
        "payload_schema": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "additionalProperties": false
    }
  }
}
