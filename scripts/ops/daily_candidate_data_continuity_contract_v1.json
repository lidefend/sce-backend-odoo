{
  "schema_version": "daily_candidate_data_continuity.v1",
  "duty": "demo",
  "task_id": "DAILY-DATA-CONTINUITY-BASELINE-01",
  "environment_class": "DAILY_CANDIDATE_ENVIRONMENT",
  "data_authority": "CANDIDATE",
  "source_repository": "/opt/projects/repos/sce-product-odoo",
  "required_artifacts": [
    "database.dump",
    "filestore.tar.gz",
    "manifest.json",
    "SHA256SUMS"
  ],
  "sentinel_tables": [
    "res_company",
    "res_users",
    "project_project",
    "construction_contract",
    "payment_request",
    "ir_attachment",
    "ir_module_module"
  ],
  "sample_tables": [
    "project_project",
    "construction_contract",
    "payment_request",
    "ir_attachment"
  ],
  "relation_sample": {
    "table": "payment_request",
    "columns": [
      "project_id",
      "contract_id"
    ],
    "limit": 100
  },
  "data_classes": {
    "database_and_filestore": "CANDIDATE",
    "legacy_source": "LEGACY_SOURCE",
    "test_fixture": "TEST_FIXTURE",
    "personal_development": "DISPOSABLE"
  },
  "forbidden_on_candidate_database": [
    "database_recreate",
    "filestore_recreate",
    "demo_data_install",
    "fixture_reset",
    "module_uninstall",
    "temporary_sql_repair",
    "compose_down_with_volumes"
  ],
  "upgrade_contract": {
    "database_migration_declared": true,
    "versioned_migration_required": true,
    "clone_rehearsal_required": true,
    "paired_backup_required": true,
    "fixture_write_allowed": false,
    "demo_data_write_allowed": false,
    "database_recreate_required": false,
    "filestore_recreate_required": false
  },
  "identity_source": "config/ops/daily_runtime_database_duties.v1.json",
  "identity_note": "Runtime identity (database, application role, cluster, containers, volumes, filestore scope, backup namespace, backup id prefix) is resolved from the duty declaration. This contract deliberately restates none of it: the demo carrier was rebuilt onto its own cluster on 2026-10-16, and a restated identity here became a second authority that refused the move instead of following it. The pre-governance carrier that also answers to the same database name is the declaration's protected historic source, not a duty, so this contract can never select it."
}
