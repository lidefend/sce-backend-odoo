  "policy": {
    "isolation_dimensions": [
      "ownership_identity",
      "customer_demo_test_purpose",
      "company_industry_platform_sharing",
      "company_project_business_scope",
      "capability_acl_operation"
    ],
    "reuse_first": "Reuse native ACL, existing industry record rules and parent-relation anchors before introducing a new mechanism; a model must not duplicate every isolation dimension.",
    "coverage": "The coverage universe is every model defined by a product module in config/tenant/module_sets.v1.json that declares a company_id field. scripts/verify/sc_data_scope_rule_coverage_guard.py derives that universe from source and fails closed when a model has no ceiling, exemption, deferred decision or company-constraining rule."
  },
  "deferred": [
    {
      "issue": "DATA-SCOPE-CEILING-01",
      "dimension": "company_project_business_scope",
      "anchor": "company_id",
      "owner_module": "smart_construction_core",
      "reason": "P1 business models that expose a company_id column but carry only capability/project-scoped groups rules (domains such as (1,'=',1) or project-member predicates), so no group union is bounded by a company ceiling and a manager-level group can read other companies rows. Fix by deriving one global company ceiling from this declaration instead of hand-writing another near-duplicate ir.rule for each model.",
