{
  "schema": "business_entry_matrix_overlay.v1",
  "notes": [
    "Per-entry behaviour overlay for scripts/verify/business_entry_matrix_browser.mjs.",
    "Identity (menu_xmlid/action_xmlid/model/label/presentation) comes from docs/product/frontend_business_entry_acceptance_v1.csv;",
    "this file only declares behaviour the CSV does not carry.",
    "detail=true means: read back the record ui.contract.v2 envelope for the declared presentation.",
    "presentation, when set, is an expectation: the probe fails if the runtime declares a different surface.",
    "denied_role overrides the derived negative-authority role for one entry.",
    "denied_role_candidates lists the fixture role logins probed as negative authority. The capability",
    "closure is NOT declared here: the probe reads the acting principal's closure from the login envelope",
    "(`principal.role_xmlids`, the external ids of every effective group) and only accepts a candidate whose",
    "closure is disjoint from the entry's declared groups."
  ],
  "defaults": {
    "detail": true,
    "expect_write": null
  },
  "denied_role_candidates": [
    "fixture_role_project_a_member",
    "fixture_role_executive",
    "fixture_role_contract_operator",
    "fixture_role_owner",
    "fixture_role_pm",
    "fixture_role_finance",
    "fixture_role_activity_accounting",
    "fixture_role_config_admin",
    "fixture_role_system_admin",
    "fixture_role_partner_manager"
  ],
