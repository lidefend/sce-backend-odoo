        {"key": "data_space_scope", "kind": "hard", "authority": "config/ops/daily_runtime_database_duties.v1.json; scripts/demo/tenant_lifecycle.sh", "owner_layer": "P4", "repair_hint": "固定 demo 数据库、租户、dbfilter 与公司作用域"},
