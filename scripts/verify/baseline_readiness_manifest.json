        {"key": "project_membership_scope", "kind": "hard", "authority": "项目成员与项目数据范围", "owner_layer": "P3", "repair_hint": "补齐项目成员与数据范围"},
        {"key": "funding_baseline", "kind": "hard", "authority": "project.funding.baseline required version / control period / amount", "owner_layer": "P1", "repair_hint": "开启资金承载并建立生效资金基线"},
        {"key": "budget_boq_wbs", "kind": "hard", "authority": "预算/目标成本、BOQ 版本与清单、WBS/LBS/标段/执行范围", "owner_layer": "P1", "repair_hint": "补齐预算/目标成本、BOQ 清单与 WBS/LBS"},
        {"key": "settlement_anchor", "kind": "hard", "authority": "合同或采购订单等结算依据", "owner_layer": "P1", "repair_hint": "补齐合同或采购订单等结算依据"}
      ]
    },
    {
      "gate": "G5",
      "title": "transactional_facts",
      "applicable": true,
      "requirements": [
        {"key": "contract", "kind": "conditional", "authority": "contract state machine / approval instance", "owner_layer": "P1", "repair_hint": "由正式动作产生合同事实"},
        {"key": "procurement_acceptance", "kind": "conditional", "authority": "采购订单/材料验收/入库", "owner_layer": "P1", "repair_hint": "由正式动作产生采购与验收事实"},
        {"key": "progress_cost", "kind": "conditional", "authority": "进度计量/成本归集", "owner_layer": "P1", "repair_hint": "由正式动作产生进度与成本事实"},
        {"key": "settlement", "kind": "conditional", "authority": "sc.settlement.order business anchor guard", "owner_layer": "P1", "repair_hint": "由正式动作产生结算事实"},
        {"key": "payment_request", "kind": "conditional", "authority": "payment.request funding/settlement guards", "owner_layer": "P1", "repair_hint": "由正式动作产生付款申请事实"},
        {"key": "payment_execution", "kind": "conditional", "authority": "payment.execution create guard", "owner_layer": "P1", "repair_hint": "由正式动作产生付款登记事实"},
        {"key": "payment_ledger", "kind": "conditional", "authority": "付款台账有效/冲销", "owner_layer": "P1", "repair_hint": "由付款事实派生付款台账"}
      ]
    },
    {
      "gate": "G6",
      "title": "evidence_projection",
      "applicable": true,
      "requirements": [
        {"key": "role_workbench", "kind": "conditional", "authority": "sc.workbench.item / my.work.summary aggregation", "owner_layer": "P3", "repair_hint": "角色工作台由事实派生，禁止直接 seed"},
        {"key": "approval_history_audit", "kind": "conditional", "authority": "审计日志/审批历史", "owner_layer": "P0", "repair_hint": "审批历史由真实审批动作产生"},
        {"key": "cockpit_metrics", "kind": "conditional", "authority": "sc.dashboard.cockpit.fact / sc.operating.metrics.project", "owner_layer": "P1", "repair_hint": "驾驶舱与经营指标由事实派生，禁止直接 seed"},
        {"key": "role_visibility_negative", "kind": "conditional", "authority": "角色可见性与负例", "owner_layer": "P1", "repair_hint": "验证无权限角色不可见的负例"}
      ]
