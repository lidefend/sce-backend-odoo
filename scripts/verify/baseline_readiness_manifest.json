        {"key": "cost_structure_templates", "kind": "hard", "authority": "成本科目树、WBS/BOQ 模板、合同模板、资料类型", "owner_layer": "P1", "repair_hint": "补齐成本科目树、WBS/BOQ 模板、合同模板、资料类型"}
