        {"key": "view_policies", "kind": "conditional", "authority": "列表/表单/搜索/字段策略", "owner_layer": "P3", "repair_hint": "补齐列表/表单/搜索/字段策略"},
        {"key": "data_permissions", "kind": "hard", "authority": "数据权限与记录规则", "owner_layer": "P0", "repair_hint": "补齐数据权限与记录规则"}
      ]
    },
    {
      "gate": "G4",
      "title": "project_baseline",
      "applicable": true,
      "requirements": [
