{
  "schema_version": "verification-lane-coverage/v1",
  "rationale": "Frozen debt ratchet for the verification surface. Every list is an allowance, never a target: a batch may only shrink it. Growth fails --check until it is explicitly reviewed and the baseline is deliberately rewritten.",
  "review_triggers": [
    {
      "group": "targets_zero_reference",
      "trigger": "Any batch that wires a currently-zero-reference make target to a lane, retires one, or edits a recipe it names; re-measure and shrink the frozen identity set with --write-baseline."
    },
    {
      "group": "scripts_unreferenced_anywhere",
      "trigger": "Any batch whose diff adds or removes a scripts/** consumer, or retires a script; re-measure and re-freeze."
    },
    {
      "group": "targets_missing_asset",
      "trigger": "Any batch that restores, relocates or removes a recipe path recorded under absent_assets; the recorded list must match the measurement exactly or --check fails."
    },
    {
      "group": "local_only_scripts / remote_only_scripts",
      "trigger": "Any batch that changes which lane executes a guard (make/*.mk, ci.* targets); a divergence that is neither removed nor registered fails, and a registration without a live trigger fails."
    },
    {
      "group": "candidate_dispositions",
      "trigger": "The owning batch must wire-or-retire a 'candidate' registration before it is due; until then it holds no functional acceptance."
    }
  ],
  "metric_corrections": [
    {
      "metric": "max_scripts_unreferenced_anywhere",
      "previous_reading": 1,
      "observed_after_correction": 104,
      "batch": "B2",
      "defect": "The reference index counted a *mention* as a consumer. Guard registries, inventories and audit reports list every script by name, so writing about dead surface silently revived it and the raw count stayed flattering. Fixed by indexing real imports only."
    },
    {
      "metric": "max_targets_zero_reference",
      "previous_reading": 336,
      "observed_after_correction": 759,
      "batch": "B3",
      "defect": "Same defect on the make-target half: every docs/*.md $() mention counted as an invocation. Only the two binding execution-policy documents declare an entry point; a report that quotes a target name narrates it. Fixed, which added the 423 targets that this batch registered."
    },
    {
      "metric": "max_remote_only_scripts",
      "previous_reading": 74,
      "observed_after_correction": 83,
      "batch": "B3",
      "defect": "The recipe script token frame listed only .py/.sh/.js and had no path boundary, so the Node/TS probe surface was invisible to the lane-divergence count. Widening the frame to .mjs/.cjs/.ts exposed 9 genuinely remote-only frontend probes (registered), and the boundary fix removed 138 false 'absent path' readings that came from reading frontend/apps/web/scripts/* as a repo-root scripts/*."
    },
    {
      "metric": "recorded_targets_missing_asset",
      "previous_reading": null,
      "observed_after_correction": 226,
      "batch": "B3",
      "defect": "New hard-checked register: a make target whose recipe calls a path that is absent from the tree cannot run. 226 targets qualify (187 references to scripts/migration/*, which .gitignore line 116 keeps out of the clean product repository as customer migration collateral, plus relocated or never-added verify/root scripts). Each is registered with an owner, a reason and a review date; 0 may be unregistered."
    }
  ],
  "max_targets_zero_reference": 641,
  "max_scripts_unreferenced_anywhere": 104,
  "max_targets_missing_asset_unregistered": 0,
