ARG NGINX_BASE_IMAGE=nginx@sha256:332d0beea97cff8c0d5d27976c0778a4b00345b9d74c2feaaf8efde548314948

FROM ${NGINX_BASE_IMAGE}

ARG SOURCE_SHA
ARG PRODUCT_VERSION
ARG FRONTEND_BUILD_SHA256
ARG BUILD_TIME
ARG NODE_VERSION
ARG PNPM_VERSION

# This image owns only the static frontend and its reverse proxy. The Odoo
# runtime image never receives frontend files, nginx, or a Node toolchain.
COPY frontend/apps/web/dist-production-candidate/ /usr/share/nginx/html/
COPY config/nginx/conf.d/production-candidate.conf /etc/nginx/templates/default.conf.template
COPY scripts/render_nginx_conf.sh /usr/local/bin/render_nginx_conf.sh

RUN test -n "${FRONTEND_BUILD_SHA256}" \
    && test -s /usr/share/nginx/html/index.html \
    && printf '%s\n' "${FRONTEND_BUILD_SHA256}" > /usr/share/nginx/html/.build-sha256 \
    && chmod 0755 /usr/local/bin/render_nginx_conf.sh \
    && rm -f /etc/nginx/conf.d/default.conf

ENV FRONTEND_BUILD_SHA256="${FRONTEND_BUILD_SHA256}"

LABEL org.opencontainers.image.revision="${SOURCE_SHA}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.title="sce-frontend" \
      org.opencontainers.image.version="${PRODUCT_VERSION}" \
      io.sce.frontend.sha256="${FRONTEND_BUILD_SHA256}" \
      io.sce.node.version="${NODE_VERSION}" \
      io.sce.pnpm.version="${PNPM_VERSION}" \
      io.sce.node.runtime="absent" \
      io.sce.component="frontend-static"

USER root
ENTRYPOINT ["/usr/local/bin/render_nginx_conf.sh"]
