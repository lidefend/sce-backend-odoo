      <field name="amount_no_tax">341592.92</field>
      <field name="tax_amount">44407.08</field>
      <field name="amount_total">386000.0</field>
      <field name="currency_id" ref="base.CNY"/>
      <field name="handler_name">测试-财务专员</field>
      <field name="note">S70 发票登记样例</field>
    </record>

    <record id="sc_demo_tax_deduction_070_input" model="sc.tax.deduction.registration">
      <field name="name">S70-TAX-001</field>
      <field name="state">deducted</field>
      <field name="finance_identity_state">normalized</field>
      <field name="document_no">S70-TAX-DOC-001</field>
      <field name="document_date">2025-03-16</field>
      <field name="deduction_confirm_date">2025-03-20</field>
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_001"/>
      <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_vendor_steel"/>
      <field name="partner_name">德阳某某钢材贸易有限公司（示例）</field>
      <field name="invoice_no">S70INV0001</field>
      <field name="invoice_code">510000S70001</field>
      <field name="invoice_date">2025-03-14</field>
      <field name="invoice_amount_untaxed">341592.92</field>
      <field name="invoice_tax_amount">44407.08</field>
      <field name="invoice_amount_total">386000.0</field>
      <field name="deduction_amount">341592.92</field>
      <field name="deduction_tax_amount">44407.08</field>
      <field name="deduction_surcharge_amount">0.0</field>
      <field name="currency_id" ref="base.CNY"/>
      <field name="note">S70 进项税抵扣登记样例</field>
    </record>

    <record id="sc_demo_construction_diary_070_daily" model="sc.construction.diary">
      <field name="name">S70-DIARY-001</field>
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_001"/>
