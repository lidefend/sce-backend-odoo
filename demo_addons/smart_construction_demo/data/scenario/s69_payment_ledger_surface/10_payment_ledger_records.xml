<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <record id="sc_demo_project_069_payment_ledger" model="project.project">
      <field name="name">S69 支付台账演示项目</field>
      <field name="project_code">S69-PAY-2025-001</field>
      <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_owner_001"/>
      <field name="company_id" ref="base.main_company"/>
      <field name="funding_enabled">True</field>
      <field name="lifecycle_state">in_progress</field>
      <field name="active">True</field>
      <field name="description">S69 支出合同、结算单、付款申请和支付台账演示项目。</field>
    </record>

    <!-- 资金基线走受控生命周期：XML 只建草稿（含控制期与明细），
         由 scenario_loader 的 _ensure_funding_baseline 调 action_activate() 生效。 -->
    <record id="sc_demo_funding_baseline_069_payment" model="project.funding.baseline">
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_069_payment_ledger"/>
      <field name="total_amount">1000000.0</field>
      <field name="period_start">2025-01-01</field>
      <field name="period_end">2026-12-31</field>
    </record>

    <record id="sc_demo_funding_baseline_069_payment_line_labor" model="project.funding.baseline.line">
      <field name="baseline_id" ref="smart_construction_demo.sc_demo_funding_baseline_069_payment"/>
      <field name="sequence">10</field>
      <field name="name">人工费</field>
      <field name="planned_amount">600000.0</field>
    </record>

    <record id="sc_demo_funding_baseline_069_payment_line_material" model="project.funding.baseline.line">
      <field name="baseline_id" ref="smart_construction_demo.sc_demo_funding_baseline_069_payment"/>
      <field name="sequence">20</field>
      <field name="name">材料费</field>
      <field name="planned_amount">400000.0</field>
    </record>

  </data>

  <!-- 付款申请的 funding gate 要求装载时已有唯一生效基线。
       Odoo convert 的 _tag_function 在 noupdate 数据块内且 mode != 'init' 时会静默跳过，
       因此激活标签必须放在独立的 noupdate="0" 块中（先例：s00/s80/s89）。
       文档序保持在基线明细之后、payment.request 之前，经受控动作激活（跳过非草稿，幂等）。 -->
  <data noupdate="0">
    <function model="project.funding.baseline" name="sc_demo_activate">
      <value model="project.funding.baseline" eval="obj([ref('smart_construction_demo.sc_demo_funding_baseline_069_payment')]).filtered(lambda b: b.state == 'draft').ids"/>
    </function>
  </data>

  <data noupdate="1">

    <record id="sc_demo_contract_in_069_payment" model="construction.contract">
      <field name="subject">S69 支付台账支出合同</field>
      <field name="type">in</field>
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_069_payment_ledger"/>
      <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_vendor_steel"/>
      <field name="date_contract">2025-08-21</field>
      <field name="amount_total">240000.0</field>
      <field name="amount_final">240000.0</field>
      <field name="currency_id" ref="base.CNY"/>
    </record>

    <record id="sc_demo_contract_in_069_payment_line" model="construction.contract.line">
      <field name="contract_id" ref="smart_construction_demo.sc_demo_contract_in_069_payment"/>
      <field name="qty_contract">1.0</field>
      <field name="price_contract">240000.0</field>
      <field name="note">S69 支付台账合同明细</field>
    </record>

    <!-- 结算单走受控生命周期：XML 只建草稿（含审批批注字段），明细随后装载，
         由 scenario_loader 的 _ensure_s69_settlement_lifecycle 经 _write_lifecycle("approve") 生效。 -->
    <record id="sc_demo_settlement_069_payment" model="sc.settlement.order">
      <field name="name">S69-PAY-SET-001</field>
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_069_payment_ledger"/>
      <field name="contract_id" ref="smart_construction_demo.sc_demo_contract_in_069_payment"/>
      <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_vendor_steel"/>
      <field name="currency_id" ref="base.CNY"/>
      <field name="settlement_type">out</field>
      <field name="amount_total">240000.0</field>
      <field name="approved_amount">240000.0</field>
      <field name="date_settlement">2025-08-22</field>
      <field name="approved_date">2025-08-22</field>
    </record>

    <record id="sc_demo_settlement_line_069_payment" model="sc.settlement.order.line">
      <field name="settlement_id" ref="smart_construction_demo.sc_demo_settlement_069_payment"/>
      <field name="contract_id" ref="smart_construction_demo.sc_demo_contract_in_069_payment"/>
      <field name="name">S69 钢材到货结算</field>
      <field name="qty">1.0</field>
      <field name="price_unit">240000.0</field>
      <field name="amount">240000.0</field>
    </record>

    <record id="sc_demo_payment_request_069_pay" model="payment.request">
      <field name="name">S69-PAY-REQ-001</field>
      <field name="type">pay</field>
      <field name="project_id" ref="smart_construction_demo.sc_demo_project_069_payment_ledger"/>
      <field name="contract_id" ref="smart_construction_demo.sc_demo_contract_in_069_payment"/>
      <field name="settlement_id" ref="smart_construction_demo.sc_demo_settlement_069_payment"/>
      <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_vendor_steel"/>
      <field name="amount">120000.0</field>
      <field name="currency_id" ref="base.CNY"/>
      <field name="date_request">2025-08-23</field>
      <field name="state">approved</field>
      <field name="validation_status">validated</field>
      <field name="note">S69 支付台账来源付款申请。</field>
    </record>

  </data>
</odoo>
