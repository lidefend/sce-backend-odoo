            <!-- group_sc_role_settlement_user：结算单多级审批链第一级（结算经办确认）
                 的评审组是角色组；无角色持有者时该级永远无人可批（fresh install P0）。 -->
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('smart_construction_core.group_sc_cap_settlement_user'),
                ref('smart_construction_core.group_sc_role_settlement_user')
            ])]"/>
        </record>

        <record id="user_sc_settlement_manager_cap" model="res.users">
            <field name="name">结算审批岗</field>
            <field name="login">sc_settlement_mgr</field>
            <field name="email">sc_settlement_mgr@zhihui-construction.cn</field>
            <field name="tz">Asia/Shanghai</field>
            <field name="lang">zh_CN</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('smart_construction_core.group_sc_cap_settlement_manager')
            ])]"/>
        </record>
    </data>
</odoo>
