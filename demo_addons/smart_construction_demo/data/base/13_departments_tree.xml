<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- 组织树基线。
             12_departments.xml 以 noupdate="1" 保留历史库中的
             sc_demo_department_001（工程管理部）及其既有业务引用；本文件以
             noupdate="0" 幂等重声明该部门的 parent_id，并补齐其余部门。
             manifest 加载顺序：12_departments.xml -> 本文件 -> 14_jobs.xml ->
             data/demo/sc_demo_users.xml -> data/demo/sc_demo_employees.xml ->
             data/demo/sc_demo_organization_bindings.xml。
             所有部门绑定 base.main_company；模块升级或重新入住时重复加载
             得到同一棵树。 -->
        <record id="sc_demo_department_gm" model="hr.department">
            <field name="name">总经办</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_operation" model="hr.department">
            <field name="name">经营管理部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_project" model="hr.department">
            <field name="name">项目管理部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- 保留既有 XMLID 与名称；仅重声明上级部门。 -->
        <record id="sc_demo_department_001" model="hr.department">
            <field name="name">工程管理部</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="parent_id" ref="smart_construction_demo.sc_demo_department_project"/>
        </record>

        <record id="sc_demo_department_quality" model="hr.department">
            <field name="name">质量安全部</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="parent_id" ref="smart_construction_demo.sc_demo_department_project"/>
        </record>

        <record id="sc_demo_department_contract" model="hr.department">
            <field name="name">商务合约部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_cost" model="hr.department">
            <field name="name">成本管理部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_purchase" model="hr.department">
            <field name="name">采购部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_material" model="hr.department">
            <field name="name">物资设备部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_finance" model="hr.department">
            <field name="name">财务部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="sc_demo_department_hr" model="hr.department">
            <field name="name">人力行政部</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- 12_departments.xml 以 noupdate="1" 创建了 sc_demo_department_001，
             同一 XMLID 在后续文件中无法再被 record 更新。这里用 function 在
             每次安装/升级时幂等写入上级部门，保证全新入住也得到同一棵树。 -->
        <function model="hr.department" name="write">
            <value eval="[ref('smart_construction_demo.sc_demo_department_001')]"/>
            <value eval="{'parent_id': ref('smart_construction_demo.sc_demo_department_project')}"/>
        </function>

    </data>
</odoo>
