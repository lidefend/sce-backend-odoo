<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- P1：全量项目 -->
    <record id="sc_demo_project_001" model="project.project">
        <field name="name">德阳智能制造产教融合项目</field>
        <field name="project_code">SC-DEY-2025-001</field>
        <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_owner_001"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="project_type_id" ref="smart_construction_demo.sc_demo_dict_project_type_municipal"/>
        <field name="project_category_id" ref="smart_construction_demo.sc_demo_dict_project_category_industry"/>
        <field name="start_date">2025-01-01</field>
        <field name="end_date">2026-12-31</field>
        <!-- 注意：不可在此指派 user_id——本文件在 manifest data 顺序中先于
             sc_demo_users.xml 加载，ref 解析会失败（Error 255）。demo PM
             的项目经理指派由 scenario_loader 的 _ensure_s00_boq_visibility
             钩子在 seed 阶段完成（此时 demo 用户已存在）。 -->
        <field name="active">True</field>
        <field name="description">项目位于德阳经开区，建设内容包括智能制造实训中心、产教融合综合楼及配套道路管网，总建筑面积约 8.6 万平方米，合同额约 3.2 亿元，计划工期 2025 年 1 月至 2026 年 12 月，目前处于主体施工阶段。</field>
    </record>

    <!-- P2：基础资料项目 -->
    <record id="sc_demo_project_002" model="project.project">
        <field name="name">城东片区安置房项目</field>
        <field name="partner_id" ref="smart_construction_demo.sc_demo_partner_owner_001"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="active">True</field>
        <field name="description">项目位于城东新区，建设内容包括 6 栋安置住宅、社区服务中心及地下车库，总建筑面积约 9.4 万平方米，合同额约 2.8 亿元，计划工期 2025 年 3 月至 2027 年 2 月，目前处于基础施工阶段。</field>
    </record>

</odoo>
