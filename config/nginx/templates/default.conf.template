map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Batch C: the path prefix decides the namespace.  A client database hint
# (X-Odoo-DB / X-DB / ?db=) is no longer a routing input: it is stripped before
# proxying and refused by Odoo as a conflict.
map $uri $sc_path_ns {
  ~^/t/([a-z0-9][a-z0-9-]*)(/|$)  $1;
  ~^/platform-admin(/|$)               platform;
  default                              "";
}

# The path parser above only extracts an alias-shaped token.  It must never be
# treated as a declared namespace by itself: the alias whitelist is rendered
# from the entry declaration so an undeclared but well-formed `/t/<alias>/`
# cannot fall through to the SPA shell or the default upstream.
map $sc_path_ns $sc_declared_ns {
  default                                  "";
  ~^(${SC_DECLARED_NAMESPACE_ALIASES})$    $sc_path_ns;
}

map $sc_path_ns $sc_ns_audience {
  default   tenant;
  platform  platform-admin;
}

# Each namespace resolves to exactly one duty upstream.  The serving duty owns
# the public entry; the platform administration namespace has its own upstream.
map $sc_path_ns $sc_proxy_upstream {
  default   ${SC_PROXY_DEFAULT_UPSTREAM};
  platform  ${SC_PROXY_PLATFORM_UPSTREAM};
}

# Batch C: refuse a client database hint at the entry itself, before nginx
# blanks the headers.  Odoo keeps its own 409 check as defence in depth.
map "$http_x_odoo_db:$http_x_db:$http_x_odoo_db_locked" $sc_client_db_header_present {
  default 1;
  "::"    0;
}
map $arg_db $sc_client_db_query_present {
  default 1;
  ""      0;
}

# Both duty upstreams are Odoo and both emit the session_id cookie with
# Path=/.  Sharing that path across namespaces lets a second tab overwrite the
# first tab's authenticated session.  The entry rewrites the cookie path to the
# namespace prefix it served, so each namespace has its own browser session.
map $request_uri $sc_entry_cookie_path {
  ~^/t/([a-z0-9][a-z0-9-]*)(?:/|\?|$)  /t/$1/;
  ~^/platform-admin(?:/|\?|$)          /platform-admin/;
  default                               /;
}

server {
  listen 80;
  server_name _;
  client_max_body_size 512m;

  # Batch C: refusals are JSON and the bare-root redirect must keep the
  # client's own port (18081).  nginx defaults to absolute Locations and
  # text/plain bodies; both broke the declared entry contract.
  absolute_redirect off;
  default_type application/json;

  # Batch C: the platform entry is two nginx layers.  The serving (entry) face
  # forwards `/platform-admin/...` unchanged to the platform duty face; the
  # platform duty face strips the prefix before its own Odoo, whose routes are
  # native `/api/...`.  The hop is declared, never guessed: entry renders 0 and
  # the platform_control duty renders 1.
  set $sc_entry_platform_strip "${SC_ENTRY_PLATFORM_STRIP}";

  # Batch C: a client database hint is a conflict, not a routing input.
  if ($sc_client_db_header_present) {
    return 409 '{"error":"NS_DATABASE_HINT_CONFLICT"}';
  }
  if ($sc_client_db_query_present) {
    return 409 '{"error":"NS_DATABASE_HINT_CONFLICT"}';
  }

  # `proxy_pass` resolves a variable at request time, so it needs the Docker
  # embedded DNS resolver rather than the startup-time resolver.
  resolver 127.0.0.11 valid=10s ipv6=off;


  proxy_read_timeout 1800s;
  proxy_send_timeout 1800s;
  proxy_connect_timeout 60s;

  root /usr/share/nginx/html;
  index index.html;

  # Liveness probe.  The exact-match location wins over the SPA fallback in
  # `location /`, so probes get a machine-readable JSON body instead of
  # index.html.  No "$" may appear in the body: the image entrypoint runs
  # envsubst with filter ^SC_PROXY_DEFAULT_DB$ and would mangle it.
  location = /healthz {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"status":"ok"}';
  }

  location /assets/ {
    try_files $uri =404;
    expires -1;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
    try_files /index.html =404;
  }

  # Batch C: the bare root carries no namespace.  It must never load a SPA
  # that would then call the namespace-less `/api`, so redirect to the serving
  # namespace declared in config/ops/daily_runtime_entry.v1.json.  The platform
  # duty face redirects to its own namespace instead.
  location = / {
    add_header Cache-Control "no-store";
    if ($sc_entry_platform_strip = "1") {
      return 308 /platform-admin/;
    }
    return 308 /t/demo/;
  }

  location / {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
    try_files $uri $uri/ /index.html;
  }

  # Namespace-prefixed API surface: the prefix is the only database selector
  # and is preserved on the upstream request.
  location ~ ^/t/[a-z0-9][a-z0-9-]*/api/ {
    # Capture the namespace before the rewrite changes $uri, then strip the
    # prefix so Odoo receives its native /api/... route.
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_declared_ns = "") {
      return 404 '{"error":"NS_UNKNOWN_NAMESPACE"}';
    }
    rewrite ^/t/[a-z0-9][a-z0-9-]*(/api/.*)$ $1 break;
    proxy_pass http://$sc_entry_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ~ ^/platform-admin/api/ {
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_declared_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_entry_platform_strip = "1") {
      rewrite ^/platform-admin(/api/.*)$ $1 break;
    }
    proxy_pass http://$sc_entry_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  # Prefixed Odoo web faces: strip the namespace prefix so /web, /mail,
  # /report and /longpolling resolve to Odoo's native routes.
  location ~ ^/t/[a-z0-9][a-z0-9-]*/(web|web_editor|mail|report|longpolling)(/|$) {
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_declared_ns = "") {
      return 404 '{"error":"NS_UNKNOWN_NAMESPACE"}';
    }
    rewrite ^/t/[a-z0-9][a-z0-9-]*(/.*)$ $1 break;
    proxy_pass http://$sc_entry_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ~ ^/platform-admin/(web|web_editor|mail|report|longpolling)(/|$) {
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_declared_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_entry_platform_strip = "1") {
      rewrite ^/platform-admin(/.*)$ $1 break;
    }
    proxy_pass http://$sc_entry_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  # Namespace-prefixed websocket face (longpolling upgrade).
  location ~ ^/t/[a-z0-9][a-z0-9-]*/websocket {
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_declared_ns = "") {
      return 404 '{"error":"NS_UNKNOWN_NAMESPACE"}';
    }
    rewrite ^/t/[a-z0-9][a-z0-9-]*(/.*)$ $1 break;
    proxy_pass http://$sc_entry_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};

    proxy_read_timeout 1800s;
  }

  location ~ ^/platform-admin/websocket {
    set $sc_entry_ns $sc_path_ns;
    set $sc_entry_audience $sc_ns_audience;
    set $sc_entry_upstream $sc_proxy_upstream;
    if ($sc_declared_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    if ($sc_entry_platform_strip = "1") {
      rewrite ^/platform-admin(/.*)$ $1 break;
    }
    proxy_pass http://$sc_entry_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_entry_ns;
    proxy_set_header X-SC-Audience     $sc_entry_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};

    proxy_read_timeout 1800s;
  }

  # Batch C: a `/t/` prefix that does not even parse as an alias is not a
  # namespace.  Refuse it as JSON instead of letting the SPA fallback answer
  # 200 for an undeclared route.  Declared aliases still serve the SPA; the
  # API/web/websocket regexes above take precedence over this fallback.
  location ~ ^/t/ {
    if ($sc_declared_ns = "") {
      return 404 '{"error":"NS_UNKNOWN_NAMESPACE"}';
    }
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location = /web {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ^~ /web/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ^~ /web_editor/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ^~ /mail/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ^~ /report/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    if ($sc_path_ns = "") {
      return 400 '{"error":"NS_NAMESPACE_REQUIRED"}';
    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
    proxy_set_header X-SC-Route-Version ${SC_ENTRY_ROUTE_VERSION};
    proxy_set_header X-SC-Entry-Secret ${SC_ENTRY_SHARED_SECRET};
  }

  location ^~ /longpolling/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;
    proxy_cookie_path / $sc_entry_cookie_path;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
