map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# The proxy must not own the database default: it is a profile fact
# (DB_NAME/ODOO_DB) and inlining a literal here silently routes every request
# that carries no db hint to whichever database that literal names, which is
# wrong for any other profile.  The template is rendered at container start
# with the profile value (see docker-compose.yml nginx service).
# The database hint precedence is declared, not incidental:
#   X-Odoo-DB header > ?db= query parameter > the profile default.
# The header is the per-request identity the SPA sends with every API call, so
# it wins when both sources disagree; the query parameter remains supported for
# the intent endpoint and for direct probes.
map $http_x_odoo_db $sc_proxy_header_db {
  default $http_x_odoo_db;
  ''      "";
}

map $arg_db $sc_proxy_query_db {
  default $arg_db;
  ''      "";
}

map $sc_proxy_header_db $sc_proxy_hinted_db {
  default $sc_proxy_header_db;
  ''      $sc_proxy_query_db;
}

map $sc_proxy_hinted_db $sc_proxy_db {
  default $sc_proxy_hinted_db;
  ''      ${SC_PROXY_DEFAULT_DB};
}

# Only databases declared by the entry may be routed.  The rendered pattern is
# the exact alternation of the entry's routes, so an unknown hint is a client
# error instead of a silent fallback to the serving duty.
map $sc_proxy_db $sc_proxy_db_allowed {
  default 0;
  ${SC_PROXY_ALLOWED_DB_PATTERN} 1;
}

# The daily development server exposes one public entry.  The serving duty's
# nginx owns that entry, but the database hint -- not the host, port or path --
# decides which duty's Odoo answers.  A duty that does not carry the platform
# control database points this route at its own application, so an accidental
# platform hint fails the target duty's exact dbfilter instead of crossing into
# a database that duty does not own.
map $sc_proxy_db $sc_proxy_upstream {
  default              odoo:8069;
  ${SC_PROXY_PLATFORM_DB}  ${SC_PROXY_PLATFORM_UPSTREAM};
}

server {
  listen 80;
  server_name _;
  client_max_body_size 512m;

  # `proxy_pass` resolves a variable at request time, so it needs the Docker
  # embedded DNS resolver rather than the startup-time resolver.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Unknown database hints are refused before any location runs.  The response
  # is a stable machine-readable contract so acceptance can assert both the
  # status and the reason instead of accepting a fallback to a declared duty.
  default_type application/json;
  if ($sc_proxy_db_allowed = 0) {
    return 400 '{"error":"unknown_database"}';
  }

  proxy_read_timeout 1800s;
  proxy_send_timeout 1800s;
  proxy_connect_timeout 60s;

  root /usr/share/nginx/html;
  index index.html;

  # Liveness probe.  The exact-match location wins over the SPA fallback in
  # `location /`, so probes get a machine-readable JSON body instead of
  # index.html.  No "$" may appear in the body: the image entrypoint runs
  # envsubst with filter ^SC_PROXY_DEFAULT_DB$ and would mangle it.
  location = /healthz {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"status":"ok"}';
  }

  location /assets/ {
    try_files $uri =404;
    expires -1;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
    try_files /index.html =404;
  }

  location / {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    add_header Pragma "no-cache";
    add_header Expires "0";
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location = /web {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location ^~ /web/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location ^~ /web_editor/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location ^~ /mail/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location ^~ /report/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location ^~ /longpolling/ {
    proxy_pass http://$sc_proxy_upstream;
    proxy_redirect off;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;
  }

  location /websocket {
    proxy_pass http://$sc_proxy_upstream;

    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host              $http_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Odoo-DB         $sc_proxy_db;
    proxy_set_header X-DB              $sc_proxy_db;
    proxy_set_header X-Odoo-DB-Locked  $sc_proxy_db;

    proxy_read_timeout 1800s;
  }
}
