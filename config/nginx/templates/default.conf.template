    }
    proxy_set_header X-Odoo-DB         "";
    proxy_set_header X-DB              "";
    proxy_set_header X-Odoo-DB-Locked  "";
    proxy_set_header X-SC-Namespace    $sc_path_ns;
    proxy_set_header X-SC-Audience     $sc_ns_audience;
