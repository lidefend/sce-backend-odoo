{
  "schema_version": "p1_payment_request_field_completeness.v1",
  "product_layer": "P1_construction_industry_standard_product",
  "form_surface_profile_mapping": {
    "create_edit": ["create", "edit"],
    "create": ["create"],
    "edit": ["edit"],
    "readonly": ["readonly"]
  },
  "scope": {
    "models": ["payment.request", "sc.payment.execution"],
    "customer_specific_rules": "forbidden",
    "authority": "model_native_view_product_contract",
    "field_rules_semantics": "minimum_product_completeness_obligations_not_a_surface_allowlist"
  },
  "classification": {
    "required": "The user must provide or the system must deterministically derive the fact before the declared gate.",
    "conditional": "The fact is required only when its applicability expression is true.",
    "derived": "The backend is authoritative and the UI renders the value read-only.",
    "optional": "The fact is useful evidence but cannot block the base journey unless another rule makes it conditional.",
    "audit": "The fact is retained for traceability and is not a primary handling input."
  },
  "list_aggregation_requirements": {
    "model": "payment.request",
    "display_field": "request_amount_display",
    "value_field": "amount",
    "currency_field": "currency_id",
    "aggregate": "sum",
    "scopes": ["current_page", "filtered_total"],
    "currency_policy": "single_currency_or_fail_closed",
    "acceptance": "page_sum_matches_visible_page_and_filtered_total_remains_stable_across_pagination"
  },
  "industry_benchmarks": {
    "principle": "Benchmark completeness is measured by construction-payment facts and task closure, not by copying every upstream fact into payment.request.",
    "sources": [
      {"product":"Oracle Primavera Unifier Payment Applications","url":"https://docs.oracle.com/en/industries/construction-engineering/primavera-unifier/26/accelerator-user/paymentapplicationbusinessprocess-10296630a.html"},
      {"product":"Oracle Primavera Unifier Cost Transactions","url":"https://docs.oracle.com/en/industries/construction-engineering/primavera-unifier/26/udesigner/howcosttransactionsworkinunifier-77655a.html"},
      {"product":"Autodesk Construction Cloud GCPay Integration","url":"https://help.autodesk.com/cloudhelp/ENU/Build-Cost/files/setup-cost/cost-integrations/Cost_GCPay_Integration.html"},
      {"product":"Procore Project Invoicing","url":"https://support.procore.com/products/online/user-guide/project-level/invoicing"},
      {"product":"SAP Fiori Approve Requests","url":"https://help.sap.com/docs/SAP_FIORI/5d441ea8c6ba4ee798d1a679165b3970/eb53ee52f0720175e10000000a44538d.html"}
    ],
    "dimensions": [
      {"key":"contract_and_counterparty_identity","benchmark":"Contract, vendor/payee, project, payment terms and contract lifecycle totals remain visible while handling payment.","ownership":"contract_master_and_payment_projection","status":"implemented","source_fields":["payment.request.contract_id","payment.request.partner_id","construction.contract.contract_payment_method_text","payment.request.contract_settlement_amount","payment.request.contract_invoice_amount","payment.request.contract_paid_amount","payment.request.contract_unpaid_amount"],"decision":"Project contract and payee are application anchors; payment terms and lifecycle totals are read-only contract facts, not copied input.","acceptance":"approval_and_execution_journeys_show_source_identity_payment_terms_and_contract_totals"},
      {"key":"billing_period_and_application_sequence","benchmark":"Payment applications are identified by billing period and sequence and prevent conflicting in-process applications.","ownership":"settlement_then_payment_projection","status":"partial","source_fields":["sc.settlement.order.settlement_period_start","sc.settlement.order.settlement_period_end","payment.request.name"],"decision":"Settlement owns the billing period; payment request projects it and enforces duplicate/in-process policy by source.","acceptance":"create_and_reopen_show_period_and_duplicate_source_is_rejected"},
      {"key":"schedule_of_values_and_budget_codes","benchmark":"The application is traceable to schedule-of-values or budget-code line items.","ownership":"settlement_lines_and_cost_classification","status":"partial","source_fields":["sc.settlement.order.line_ids","payment.request.outflow_line_ids","payment.request.cost_category_id"],"decision":"Line facts stay in settlement/cost objects and appear as a subordinate read-only relation in the payment journey.","acceptance":"approval_shows_line_basis_totals_and_drilldown_without_duplicate_entry"},
      {"key":"progress_and_stored_materials","benchmark":"Previous work, current work and stored-material amounts support the amount being claimed.","ownership":"settlement_professional_breakdown","status":"gap","source_fields":[],"decision":"Do not invent fields on payment.request; extend the settlement professional breakdown before projecting these facts.","acceptance":"blocked_from_industry_complete_claim_until_settlement_breakdown_exists"},
      {"key":"retainage_and_deductions","benchmark":"Retainage and deductions are explicit before the amount payable is approved.","ownership":"contract_and_settlement","status":"partial","source_fields":["sc.settlement.order.deduction_amount","sc.settlement.order.amount_payable"],"decision":"Settlement deductions are projected now; canonical-contract retainage remains an explicit gap and must not be fabricated on payment.request.","acceptance":"approval_shows_deduction_and_payable_balance_and_reports_retainage_gap"},
      {"key":"approved_changes","benchmark":"Approved change orders are reflected in the contract basis and current application.","ownership":"contract_events_and_settlement","status":"partial","source_fields":["construction.contract.change_amount_total","sc.contract.event"],"decision":"Change facts remain in contract performance; payment shows approved cumulative impact and source drilldown.","acceptance":"approval_basis_matches_approved_change_total"},
      {"key":"compliance_documents","benchmark":"Required compliance evidence is checked before approval or payment.","ownership":"settlement_compliance_and_attachment_policy","status":"partial","source_fields":["sc.settlement.order.compliance_state","sc.settlement.order.compliance_message","payment.request.attachment_ids"],"decision":"Use policy-driven document requirements; do not treat attachment count alone as compliance.","acceptance":"missing_required_evidence_names_the_gap_and_blocks_the_declared_gate"},
      {"key":"currency_and_amount_reconciliation","benchmark":"Transaction currency, project/company currency and reconciled totals are explicit.","ownership":"contract_settlement_payment_currency","status":"partial","source_fields":["payment.request.currency_id","sc.settlement.order.currency_id","sc.payment.execution.paid_amount"],"decision":"Current single-currency path is authoritative; exchange-rate and project-currency projection remains a planned gap.","acceptance":"amount_currency_and_source_balance_reconcile_before_submit_and_paid"},
      {"key":"workflow_task_and_handoff","benchmark":"Submit, review, approve, reject and handoff are task-driven with required reasons where configured.","ownership":"backend_action_contract_and_activity","status":"implemented","source_fields":["payment.request.state","payment.request.legal_next_action_display","mail.activity"],"decision":"Capabilities, not role names, authorize actions; every state exposes one legal primary task.","acceptance":"real_role_handoff_updates_state_next_action_work_item_and_audit"},
      {"key":"attachments_notes_and_history","benchmark":"Evidence, notes and immutable approval history remain available throughout the task.","ownership":"payment_document_and_audit","status":"implemented","source_fields":["payment.request.attachment_ids","payment.request.note","mail.message"],"decision":"Evidence is subordinate but always reachable; audit history is read-only and never overwritten on resubmission.","acceptance":"save_reopen_reject_resubmit_preserves_evidence_and_history"},
      {"key":"cost_funding_and_ledger_effect","benchmark":"Approved payment affects cost/funding ledgers once and remains traceable to the source application.","ownership":"payment_execution_and_ledgers","status":"implemented","source_fields":["sc.payment.execution.payment_request_id","sc.payment.ledger.payment_request_id","sc.treasury.ledger.payment_request_id"],"decision":"Payment execution is the posting boundary; application approval alone does not fabricate actual payment.","acceptance":"paid_and_reversal_journeys_reconcile_ledgers_without_orphans_or_duplicates"},
      {"key":"installment_payment_and_remaining_balance","benchmark":"One approved application may be settled through multiple payment executions while cumulative paid and remaining balances stay reconciled.","ownership":"payment_request_execution_and_ledger_projection","status":"implemented","source_fields":["payment.request.paid_amount_total","payment.request.unpaid_amount","sc.payment.execution.paid_amount","sc.payment.ledger.payment_execution_id"],"decision":"Uniqueness applies only to an in-flight execution, never to the whole application history. Every installment created through the professional payment-execution journey keeps its own execution-anchored ledger fact; adjacent expense-claim ledger creation remains a separately governed source flow. The request closes only when the cumulative posted amount reaches the approved amount.","acceptance":"two_installments_preserve_two_execution_ledgers_and_reconcile_request_paid_and_remaining_totals"},
      {"key":"exception_retry_and_duplicate_prevention","benchmark":"Retries, duplicate tabs and repeated commands cannot create duplicate payment facts.","ownership":"payment_request_execution_service","status":"implemented","source_fields":["sc.payment.execution.payment_request_id"],"decision":"Server uniqueness and idempotent commands are authoritative; UI disabling is only an aid.","acceptance":"double_click_multi_tab_timeout_retry_create_exactly_one_execution"},
      {"key":"cross_company_project_isolation","benchmark":"Users cannot view or reference payment facts outside authorized company/project scope.","ownership":"record_rules_domains_and_service_guards","status":"implemented","source_fields":["payment.request.company_id","payment.request.project_id","sc.payment.execution.project_id"],"decision":"Menu, page, selector, API and ORM all fail closed without leaking names or amounts.","acceptance":"cross_company_and_cross_project_ui_url_api_rpc_are_denied_without_payload"}
    ]
  },
  "surface_requirements": {
    "payment_request_list": {
      "source": "addons/smart_construction_core/views/support/user_confirmed_formal_list_views.xml",
      "fields": ["document_status_display", "name", "date_request", "project_name_display", "payee_unit_display", "related_document_text", "payee_account_completeness", "legal_next_action_display", "request_amount_display"],
      "labels": ["单据状态", "单据编号", "申请日期", "项目名称", "收款单位", "付款依据", "账户完整度", "下一步", "申请付款金额"]
    },
    "payment_request_form": {
      "source": "addons/smart_construction_core/views/core/payment_request_views.xml",
      "sections": ["申请识别与状态", "项目与收款对象", "结算与合同依据", "本次付款事实", "账户与开票信息", "说明与附件", "审批与审计"]
    },
    "payment_execution_form": {
      "source": "addons/smart_construction_core/views/core/payment_execution_views.xml",
      "sections": ["来源申请", "本次实付", "收款账户", "付款账户", "凭证与说明", "责任与追溯"]
    }
  },
