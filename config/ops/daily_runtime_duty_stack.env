# Governed duty environment template (P4, daily development server only).
#
# Rendered by `scripts/ops/daily_runtime_database_duty.py` from
# `config/ops/daily_runtime_database_duties.v1.json`; every placeholder is
# resolved by that entry, and the resolved file is written mode 0600 outside the git
# checkout, so no credential is ever committed and no duty reads another duty's
# environment file.
#
# The static values below are not per-duty preferences: they are the accepted
# runtime conventions (`SCENE_CHANNEL=stable`, `SCENE_USE_PINNED=0`,
# `SCENE_ROLLBACK=0`, `LIST_DB=false`) that the release and acceptance entries
# already assert elsewhere.
DUTY_NAME=@DUTY_NAME@
COMPOSE_PROJECT_NAME=@COMPOSE_PROJECT_NAME@
ENV=@ENV@
SC_ENVIRONMENT=@SC_ENVIRONMENT@
# The demo-data switches. ``SC_ALLOW_DEMO_DATA`` is the explicit "this duty may
# carry demo data" declaration the demo module and the seed chain both require,
# and it is *rendered per duty from that duty's declared data_purpose* rather
# than left to the operator: a business duty renders 0. ``SC_DEMO_USER_PASSWORD``
# is the password of the demo users the seed creates, and it is minted as duty
# secret material for a demo duty only.
SC_ALLOW_DEMO_DATA=@SC_ALLOW_DEMO_DATA@
SC_DEMO_USER_PASSWORD=@SC_DEMO_USER_PASSWORD@
SC_PRODUCT_ROOT=@SC_PRODUCT_ROOT@
SC_SOURCE_REVISION=@SC_SOURCE_REVISION@
# The frontend artifact this duty serves. The artifact owns that fact -- the
# value is resolved from the served build's own fingerprint inside the duty's
# declared output directory and reconciled with the deployed build environment,
# never pinned here -- and a duty whose served frontend cannot be identified
# refuses to render at all instead of starting behind an anonymous bundle.
FRONTEND_BUILD_SHA256=@FRONTEND_BUILD_SHA256@

POSTGRES_IMAGE=@POSTGRES_IMAGE@
DB_NAME=@DB_NAME@
DB_USER=@DB_USER@
DB_PASSWORD=@DB_PASSWORD@
DB_MAINTENANCE_USER=@DB_MAINTENANCE_USER@
DB_MAINTENANCE_PASSWORD=@DB_MAINTENANCE_PASSWORD@
ODOO_DBFILTER=@ODOO_DBFILTER@
LIST_DB=false

DB_DATA=@DB_DATA@
REDIS_DATA=@REDIS_DATA@
ODOO_DATA=@ODOO_DATA@

ODOO_IMAGE=@ODOO_IMAGE@
ODOO_PORT=@ODOO_PORT@
NGINX_PORT=@NGINX_PORT@
# Bind addresses are part of the entry declaration, not a container default:
# only the serving duty publishes its nginx face, while every other publisher
# stays on the loopback interface.
ODOO_BIND_HOST=@ODOO_BIND_HOST@
NGINX_BIND_HOST=@NGINX_BIND_HOST@
# The database-to-upstream switch rendered from `daily_runtime_entry.v1.json`.
# A duty that does not serve the platform control database points this at its
# own application, where its exact dbfilter refuses a database it does not own.
SC_PROXY_PLATFORM_DB=@SC_PROXY_PLATFORM_DB@
SC_PROXY_PLATFORM_UPSTREAM=@SC_PROXY_PLATFORM_UPSTREAM@
# Exact alternation of the databases declared by the entry.  The proxy refuses
# every hint outside this set instead of falling back to the serving duty.
SC_PROXY_ALLOWED_DB_PATTERN=@SC_PROXY_ALLOWED_DB_PATTERN@
SC_DAILY_ENTRY_NETWORK=@SC_DAILY_ENTRY_NETWORK@
FRONTEND_DIST_DIR=@FRONTEND_DIST_DIR@
DEMO_ADDONS_ROOT=@DEMO_ADDONS_ROOT@
CUSTOMER_ADDONS_ROOT=@CUSTOMER_ADDONS_ROOT@

ADMIN_PASSWD=@ADMIN_PASSWD@
JWT_SECRET=@JWT_SECRET@
SC_BOOTSTRAP_SECRET=@SC_BOOTSTRAP_SECRET@
SC_BOOTSTRAP_LOGIN=admin
SCENE_CHANNEL=stable
SCENE_USE_PINNED=0
SCENE_ROLLBACK=0
