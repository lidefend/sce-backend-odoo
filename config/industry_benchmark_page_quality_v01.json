  "information_completeness_dimensions": [
    {"key":"identity","question":"能否唯一识别业务对象、公司、项目、相对方和责任人？"},
    {"key":"lifecycle","question":"状态、当前节点、下一动作、锁定及变更/冲销路径是否完整？"},
    {"key":"source_to_result","question":"来源申请、合同、预算、结算、付款、发票、税务和账务结果能否追溯？"},
    {"key":"lines_and_totals","question":"明细、数量、单价、税率、金额、舍入与合计口径是否一致？"},
    {"key":"evidence","question":"附件、票据、现场照片、审批轨迹和业务说明是否按业务类别组织？"},
    {"key":"control_baseline","question":"预算、合同、计划、已发生、余额和风险阈值是否同时可见？"},
    {"key":"permission_and_scope","question":"公司、项目、角色、记录范围和不可执行原因是否可解释？"},
    {"key":"report_definition","question":"指标定义、期间、维度、来源、更新时间和下钻是否完整？"}
  ],
  "handling_convenience_dimensions": [
    {"key":"task_first_screen","question":"首屏是否直接回答当前办理事项、关键事实和下一步？"},
    {"key":"one_time_entry","question":"来源单据能否选择带入，避免重复录入项目、相对方、合同和金额？"},
    {"key":"document_generation","question":"审批或确认后能否按后端规则生成后续单据并保留关联？"},
    {"key":"progressive_disclosure","question":"低频、审计和技术字段是否后置，复杂度是否按角色展开？"},
    {"key":"search_and_batch","question":"高频筛选、保存条件、批量动作和导出是否只在能力存在时提供？"},
    {"key":"mobile_handling","question":"390px 下是否可查看摘要、填写核心字段、上传证据和执行授权动作？"},
    {"key":"exception_recovery","question":"校验失败、并发冲突、附件失败和流程驳回是否给出可恢复路径？"},
    {"key":"cross_document_navigation","question":"是否能从当前单据低成本到达合同、结算、付款、发票和报表事实？"}
  ],
  "acceptance_scale": {
    "0": "无证据或不适用未说明",
    "1": "信息存在但分散、重复或依赖人工解释",
    "2": "契约完整且主路径可办理",
    "3": "跨单据贯通、移动可办、异常可恢复并有运行证据"
  },
  "release_rule": "six representative pages require every applicable dimension >= 2; score 3 requires authenticated browser/runtime evidence",
