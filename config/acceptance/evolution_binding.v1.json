{
  "schema": "acceptance_evolution_binding.v1",
  "version": 1,
  "owner": "platform-team",
  "policy": {
    "unmapped_changes": "fail",
    "evidence_max_age_hours": 72,
    "evidence_carry_forward": {
      "enabled": true,
      "mode": "suite_input_fingerprint"
    }
  },
  "suites": {
    "backend_contract": {
      "description": "后端契约、单测与影响面套件",
      "entrypoints": [
        "make ci.professional.backend.shard-verify",
        "backend_impact_suite"
      ],
      "evidence": null,
      "stages": [
        "merge",
        "deployment"
      ]
    },
    "frontend_contract": {
      "description": "前端组件、契约消费与发布单测",
      "entrypoints": [
        "make verify.frontend.pr.unit",
        "make verify.frontend.release.unit"
      ],
      "evidence": null,
      "stages": [
        "merge",
        "deployment"
      ]
    },
    "frontend_presentation": {
      "description": "纯呈现组件的轻量页面证据：页面身份、契约消费、零写入、零运行错误与响应式无溢出",
      "entrypoints": [
        "make verify.frontend.presentation.browser",
        "make verify.frontend.presentation.local.browser"
      ],
      "inputs": [
        "Makefile",
        "config/acceptance/daily_demo_credential.v1.json",
        "config/acceptance/frontend_presentation_targets.v1.json",
        "config/acceptance/isolated_entry_identity.v1.env",
        "config/frontend/**",
        "scripts/verify/daily_demo_credential_confirmation.py",
        "scripts/verify/frontend_product_page_header_browser.mjs",
        "scripts/verify/lib/frontend_acceptance_environment.mjs",
        "scripts/verify/playwright_runtime.mjs",
        "scripts/verify/test_daily_demo_credential_confirmation.py",
        "make/frontend_professional_extensions.mk",
        "scripts/dev/frontend_acceptance*",
        "scripts/dev/frontend_standard_preview.py",
        "scripts/verify/frontend_delivery_hardening_runtime_ids.py",
        "scripts/ops/dev_acceptance_release_probe.py",
        "config/acceptance/backend_contract_instance_v1.json"
      ],
      "make_inputs": [
        {
          "path": "make/frontend.mk",
          "targets": [
            "verify.daily.demo_credential.confirmation",
            "verify.frontend.presentation.browser",
            "verify.frontend.presentation.local.browser",
            "acceptance.runtime.contract_receipt"
          ],
          "variables": [
            "FRONTEND_PRESENTATION_LOGIN",
            "FRONTEND_PRESENTATION_OUTPUT",
            "FRONTEND_PRESENTATION_TARGETS_FILE"
          ]
        },
        {
          "path": "make/guards.mk",
          "targets": [
            "guard.prod.forbid"
          ],
          "variables": []
        }
      ],
      "evidence": {
        "adapter": "presentation_header",
        "min_counts": {
          "targets_total": 1
        }
      },
      "stages": [
        "merge",
        "deployment"
      ]
    },
    "governance_static": {
      "description": "静态守卫、结构锁与治理清单",
      "entrypoints": [
        "make verify.contract.architecture.suite"
      ],
      "evidence": null,
      "stages": [
        "merge",
        "deployment"
      ]
    },
    "daily_runtime_entry": {
      "description": "日常入口、双实例分流、发布身份与 Odoo 运行态验收",
      "entrypoints": [
        "python3 scripts/ops/daily_runtime_entry_verify.py"
      ],
      "evidence": {
        "adapter": "entry_verify",
        "min_checks": 40,
        "required_checks": [
          "entry_declares_one_serving_duty",
          "exactly_one_container_publishes_the_public_port",
          "bare_root_requires_a_namespace",
          "root_api_requires_a_namespace",
          "root_login_contract_requires_a_namespace",
          "client_database_hint_x_odoo_database_is_refused",
          "client_database_query_is_refused",
          "client_namespace_header_cannot_override_the_path",
          "unknown_namespace_is_refused",
          "unknown_namespace_page_shell_is_refused",
          "invalid_namespace_prefix_is_refused",
          "tenant_namespace_lands_on_the_serving_database",
          "platform_namespace_lands_on_the_platform_database",
          "tenant_runtime_publishes_the_deployed_revision",
          "platform_runtime_publishes_the_deployed_revision",
          "serving_application_reads_the_deployed_revision",
          "platform_application_reads_the_deployed_revision"
        ]
      },
      "stages": [
        "deployment"
      ]
    },
    "path_namespace_identity": {
      "description": "路径命名空间身份、跨域重放、退出与公司边界",
      "entrypoints": [
        "python3 scripts/ops/path_ns_c_acceptance.py"
      ],
      "evidence": {
        "adapter": "path_ns_c",
        "required_checks": [
          "server_head_matches_expected",
          "server_worktree_clean",
          "server_applied_commit_in_history",
          "bare_root_requires_a_namespace",
          "bare_api_requires_namespace",
          "database_header_hint_refused",
          "database_query_hint_refused",
          "unknown_namespace_refused",
          "tenant_entry_binds_tenant_database",
          "platform_entry_binds_platform_database",
          "tenant_runtime_reports_deployed_revision",
          "platform_runtime_reports_deployed_revision",
          "demo_entry_admin_login_succeeds",
          "platform_entry_admin_login_succeeds",
          "tokens_are_independent",
          "demo_token_accepted_on_demo_entry",
          "platform_token_accepted_on_platform_entry",
          "demo_token_rejected_on_platform_entry",
          "platform_token_rejected_on_demo_entry",
          "demo_logout_succeeds",
          "demo_token_invalid_after_demo_logout",
          "platform_token_survives_demo_logout",
          "unauthorized_company_is_refused"
        ]
      },
      "stages": [
        "deployment"
      ]
    },
    "list_surface_structure": {
      "description": "列表页结构、几何与运行时错误浏览器验收",
      "entrypoints": [
        "node scripts/verify/frontend_list_surface_structure_browser.mjs"
      ],
      "inputs": [
        "Makefile",
        "config/acceptance/**",
        "config/frontend/**",
        "scripts/common/frontend_acceptance*",
        "scripts/dev/frontend_acceptance*",
        "scripts/dev/frontend_standard_preview.py",
        "scripts/verify/frontend_authenticated_intent.mjs",
        "scripts/verify/frontend_list_surface_structure_browser.mjs",
        "scripts/verify/lib/acceptance_contract_receipt.mjs",
        "scripts/verify/lib/frontend_acceptance*",
        "scripts/verify/playwright_runtime.mjs",
        "scripts/verify/released_navigation_target.mjs",
        "make/frontend_professional_extensions.mk"
      ],
      "make_inputs": [
        {
          "path": "make/frontend.mk",
          "targets": [
            "verify.frontend.list_surface_search_contract.unit",
            "verify.frontend.list_surface_structure.browser"
          ],
          "variables": [
            "SC_ACCEPTANCE_CONTRACT_DECLARATION",
            "SC_ACCEPTANCE_CONTRACT_RECEIPT",
            "SC_ACCEPTANCE_REQUIRED_SHA",
            "SC_LIST_PREVIEW_DB_KEYS",
            "SC_LIST_PREVIEW_URL_KEYS"
          ]
        },
        {
          "path": "make/dev.mk",
          "targets": [],
          "variables": [
            "ACCEPTANCE_BASE_URL",
            "FRONTEND_ACCEPTANCE_DB",
            "SC_ACCEPTANCE_RUNTIME_PROFILE"
          ]
        },
        {
          "path": "make/guards.mk",
          "targets": [
            "guard.prod.forbid"
          ],
          "variables": []
        }
      ],
      "evidence": {
        "adapter": "list_surface",
        "min_counts": {
          "records_total": 8,
          "gated_total": 108,
          "negative_fixtures_total": 5
        }
      },
      "stages": [
        "merge",
        "deployment"
      ]
    },
    "relation_roundtrip": {
      "description": "关系字段回环、入口与操作恢复浏览器验收",
      "entrypoints": [
        "node scripts/verify/record_relation_roundtrip_acceptance.js"
      ],
      "inputs": [
        "Makefile",
        "config/acceptance/**",
        "config/frontend/**",
        "scripts/common/frontend_acceptance*",
        "scripts/dev/frontend_acceptance*",
        "scripts/dev/frontend_standard_preview.py",
        "scripts/verify/frontend_authenticated_intent.mjs",
        "scripts/verify/lib/frontend_acceptance*",
        "scripts/verify/playwright_runtime.mjs",
        "scripts/verify/record_relation_roundtrip_acceptance.js",
        "scripts/verify/released_navigation_target.mjs",
        "make/frontend_professional_extensions.mk"
      ],
      "make_inputs": [
        {
          "path": "make/frontend.mk",
          "targets": [
            "verify.frontend.relation_roundtrip.browser"
          ],
          "variables": [
            "RELATION_FIELD",
            "RELATION_RESOLUTION_KEY",
            "SC_ACCEPTANCE_RELATION_LOGIN"
          ]
        },
        {
          "path": "make/dev.mk",
          "targets": [],
          "variables": [
            "ACCEPTANCE_RECORD_RESOLUTION",
            "SC_ACCEPTANCE_RUNTIME_PROFILE"
          ]
        },
        {
          "path": "make/guards.mk",
          "targets": [
            "guard.prod.forbid"
          ],
          "variables": []
        }
      ],
      "evidence": {
        "adapter": "relation_roundtrip",
        "allowed_non_blocking_difference_kinds": [
          "CONTRACT_LABEL_RENDER_DIFF",
          "CONTRACT_READONLY_MISMATCH",
          "CONTRACT_REQUIRED_MISMATCH",
          "CONTRACT_VISIBILITY_MISMATCH",
          "OPENABLE_EMPTY_VALUE_HAS_NO_TARGET"
        ],
        "min_counts": {
          "contract_openable_entries": 7,
          "declared_entry_count": 13,
          "declared_openable": 3,
          "visible_openable_entries": 6
        },
        "model_min_counts": {
          "sc.general.contract": {
            "contract_openable_entries": 4,
            "declared_entry_count": 8,
            "declared_openable": 3,
            "visible_openable_entries": 3
          }
        }
      },
      "stages": [
        "merge",
        "deployment"
      ]
    }
  },
  "rules": [
    {
      "id": "offline-delivery-governance",
      "paths": [
        "scripts/ops/agent_run_context.py",
    "scripts/ops/local_quick_evidence.py",
        "scripts/ops/evidence_scope.py",
        "scripts/ops/test_evidence_scope.py",
        "scripts/ops/validation_delivery_plan.py",
        "config/acceptance/evolution_binding.v1.json",
        "scripts/ops/gitee_published_branch_sync.py",
        "scripts/ops/github_published_branch_sync.py",
        "scripts/ops/test_github_published_branch_sync.py",
        "scripts/ops/test_gitee_published_branch_sync.py"
      ],
      "suites": [
        "governance_static"
      ]
    },
    {
      "id": "acceptance-runner-list-surface",
      "paths": [
        "scripts/verify/frontend_list_surface_structure_browser.mjs"
      ],
      "suites": [
        "governance_static",
        "list_surface_structure"
      ]
    },
    {
      "id": "acceptance-runner-relation-roundtrip",
      "paths": [
        "scripts/verify/record_relation_roundtrip_acceptance.js"
      ],
      "suites": [
        "governance_static",
        "relation_roundtrip"
      ]
    },
    {
      "id": "acceptance-runner-shared-environment",
      "paths": [
        "scripts/verify/lib/frontend_acceptance_environment.mjs"
      ],
      "suites": [
        "governance_static",
        "list_surface_structure",
        "relation_roundtrip"
      ]
    },
    {
      "id": "frontend-acceptance-carrier-lifecycle",
      "paths": [
        "scripts/dev/frontend_acceptance_carrier*",
        "scripts/dev/frontend_acceptance_runtime.sh"
      ],
      "suites": [
        "governance_static",
        "path_namespace_identity"
      ]
    },
    {
      "id": "isolated-acceptance-entry-identity",
      "paths": [
        "config/acceptance/**",
        "scripts/dev/frontend_acceptance*",
        "scripts/test/frontend_acceptance*",
        "scripts/verify/frontend_acceptance*"
      ],
      "suites": [
        "governance_static",
        "path_namespace_identity",
        "list_surface_structure"
      ]
    },
    {
      "id": "governance-static",
      "paths": [
        "make/**",
        "scripts/verify/**",
        "scripts/ci/**",
        "scripts/audit/**",
        ".github/**",
        "tools/**",
        "agent_ops/**",
        "Makefile",
        "AGENTS.md",
        "ARCHITECTURE_GUARD.md"
      ],
      "suites": [
        "governance_static"
      ]
    },
    {
      "id": "docs-bookkeeping",
      "paths": [
        "docs/**",
        "**/*.md",
        ".agent/**",
        ".codex/**",
        ".devcontainer/**"
      ],
      "suites": []
    },
    {
      "id": "contracts-schemas",
      "paths": [
        "contracts/**",
        "schemas/**",
        "config/contracts/**"
      ],
      "suites": [
        "governance_static",
        "backend_contract"
      ]
    },
    {
      "id": "frontend-acceptance-schema",
      "paths": [
        "config/frontend/*.schema.json"
      ],
      "suites": [
        "frontend_contract"
      ]
    },
    {
      "id": "frontend-acceptance-harness",
      "paths": [
        "config/frontend/acceptance_environments_v1.json",
        "config/frontend/acceptance_tool_matrix_v1.json"
      ],
      "suites": [
        "frontend_contract"
      ]
    },
    {
      "id": "frontend-acceptance-config",
      "paths": [
        "config/frontend/**"
      ],
      "suites": [
        "frontend_contract",
        "list_surface_structure"
      ]
    },
    {
      "id": "frontend-presentation",
      "paths": [
        "frontend/apps/web/src/components/product-page-header/**",
        "frontend/apps/web/src/components/product-page-patterns/**",
        "frontend/apps/web/src/components/design-system/ScDescriptions.vue",
        "frontend/apps/web/src/components/template/FormSection.vue",
        "frontend/apps/web/src/components/template/NativeFormTreeRenderer.vue",
        "frontend/apps/web/src/pages/contractForm/ContractFormProductHeader.vue"
      ],
      "suites": [
        "frontend_contract",
        "frontend_presentation"
      ]
    },
    {
      "id": "frontend-test-tools",
      "paths": [
        "frontend/apps/web/scripts/**/*_test.*",
        "frontend/apps/web/scripts/**/*.test.*",
        "frontend/apps/web/scripts/**/*.spec.*",
        "frontend/apps/web/src/**/*.test.*",
        "frontend/apps/web/src/**/*_test.*",
        "frontend/apps/web/src/**/*.spec.*"
      ],
      "suites": [
        "frontend_contract"
      ]
    },
    {
      "id": "frontend-runtime",
      "paths": [
        "frontend/**"
      ],
      "suites": [
        "frontend_contract",
        "list_surface_structure"
      ]
    },
    {
      "id": "smart-core-runtime",
      "paths": [
        "addons/smart_core/**"
      ],
      "suites": [
        "backend_contract",
        "daily_runtime_entry"
      ]
    },
    {
      "id": "acceptance-fixture-infrastructure",
      "paths": [
        "addons/smart_construction_acceptance_fixture/**"
      ],
      "suites": [
        "backend_contract"
      ]
    },
    {
      "id": "construction-product-runtime",
      "paths": [
        "addons/smart_construction_core/**",
        "addons/smart_construction_*/**"
      ],
      "suites": [
        "backend_contract",
        "list_surface_structure",
        "relation_roundtrip"
      ]
    },
    {
      "id": "demo-data",
      "paths": [
        "demo_addons/**",
        "addons/smart_construction_seed/**"
      ],
      "suites": [
        "backend_contract",
        "daily_runtime_entry"
      ]
    },
    {
      "id": "backend-other",
      "paths": [
        "addons/**",
        "addons_external/**",
        "customer_addons/**",
        "backend/**"
      ],
      "suites": [
        "backend_contract"
      ]
    },
    {
      "id": "ops-runtime",
      "paths": [
        "scripts/ops/**",
        "scripts/release/**",
        "config/ops/**",
        "deploy/**",
        "docker-compose*.yml",
        "Dockerfile*",
        "requirements-odoo.txt"
      ],
      "suites": [
        "daily_runtime_entry",
        "path_namespace_identity"
      ]
    },
    {
      "id": "config-other",
      "paths": [
        "config/**"
      ],
      "suites": [
        "governance_static"
      ]
    },
    {
      "id": "release-artifacts",
      "paths": [
        "release/**",
        "artifacts/**"
      ],
      "suites": [
        "governance_static"
      ]
    },
    {
      "id": "scripts-other",
      "paths": [
        "scripts/**"
      ],
      "suites": [
        "governance_static"
      ]
    },
    {
      "id": "root-metadata",
      "paths": [
        "README.md",
        "LICENSE",
        "VERSION",
        ".gitignore",
        ".gitattributes",
        ".dockerignore",
        ".env*.example"
      ],
      "suites": []
    }
  ]
}
