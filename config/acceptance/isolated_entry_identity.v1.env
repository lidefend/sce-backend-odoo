# Isolated frontend acceptance entry identity.
#
# This is a synthetic, disposable CI/local acceptance value.  It is not a
# production credential and must never be copied into a deployed environment.
# The acceptance database seeds the same values into ir.config_parameter so
# the probe, the static preview proxy and Odoo verify one exact entry stamp.
SC_ENTRY_NAMESPACE=acceptance
SC_ENTRY_AUDIENCE=tenant
SC_ENTRY_SHARED_SECRET=sc-acceptance-entry-local-v1
SC_ENTRY_ROUTE_VERSION=acceptance-route-v1
