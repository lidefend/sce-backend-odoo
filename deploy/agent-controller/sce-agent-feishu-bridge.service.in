[Unit]
Description=SCE Feishu direct agent control bridge
Documentation=file:@@REPOSITORY_ROOT@@/docs/ops/long_running_agent_control_v1.md
After=network-online.target sce-agent-controller.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@REPOSITORY_ROOT@@
EnvironmentFile=%h/.config/sce-agent-controller/controller.env
ExecStart=@@PYTHON_BIN@@ %h/.local/lib/sce-agent-controller/feishu_agent_bridge.py run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@REPOSITORY_ROOT@@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
