[Unit]
Description=SCE long-running Codex agent controller
Documentation=file:@@REPOSITORY_ROOT@@/docs/ops/long_running_agent_control_v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@REPOSITORY_ROOT@@
EnvironmentFile=%h/.config/sce-agent-controller/controller.env
ExecStart=/usr/bin/python3 %h/.local/lib/sce-agent-controller/codex_agent_controller.py run
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@REPOSITORY_ROOT@@ %h/.codex
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
