# Copy to ~/.config/sce-agent-controller/controller.env and chmod 0600.
# Values must not be committed to the repository.
AGENT_REPOSITORY_ROOT=/home/example/workspace/sce-backend-odoo
AGENT_GITHUB_REPOSITORY=lidefend/sce-backend-odoo
AGENT_GITHUB_CONTROL_ISSUE=0
AGENT_GITHUB_ALLOWED_SENDER=lidefend
AGENT_STATE_ROOT=/home/example/workspace/sce-backend-odoo/.runtime/agent-controller
AGENT_POLL_SECONDS=20
AGENT_MAX_RUNTIME_SECONDS=21600
AGENT_CODEX_BIN=codex
AGENT_GH_BIN=gh
AGENT_NOTIFICATION_PREFIX=SCE Codex
AGENT_FEISHU_WEBHOOK_URL=
AGENT_FEISHU_WEBHOOK_SECRET=
