      "classification": "product_defect",
      "finding": "After an enable request, the immediate disable readback could observe a stale registry-cached true value and return INTERNAL_ERROR instead of committing the disable.",
      "resolution": "Clear the registry cache after the parameter row write completes and added a focused stale-cache regression.",
      "status": "resolved"
    },
