<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_funding_baseline_transition_wizard" model="ir.ui.view">
        <field name="name">project.funding.baseline.transition.wizard.form</field>
        <field name="model">project.funding.baseline.transition.wizard</field>
        <field name="arch" type="xml">
            <form string="资金基线生命周期操作">
                <group>
                    <field name="baseline_id"/>
                    <field name="operation"/>
                    <field name="reason" placeholder="填写可审计的关闭或修订原因……"/>
                    <field name="period_start" invisible="operation != 'revision'" required="operation == 'revision'"/>
                    <field name="period_end" invisible="operation != 'revision'" required="operation == 'revision'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="确认" class="oe_highlight"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_payment_ledger_funding_allocation_wizard" model="ir.ui.view">
        <field name="name">payment.ledger.funding.allocation.wizard.form</field>
        <field name="model">payment.ledger.funding.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="分配实际付款至资金计划">
                <group>
                    <field name="mode" invisible="1"/>
                    <group>
                        <field name="ledger_id"/>
                        <field name="baseline_id"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="unallocated_amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="operation_key" invisible="1"/>
                    </group>
                </group>
                <group invisible="mode != 'correct'">
                    <field name="original_allocation_ids" widget="many2many_tags" required="mode == 'correct'"/>
                    <field name="reason" required="mode == 'correct'"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="plan_line_id"/>
                        <field name="available_amount"/>
                        <field name="amount"/>
                        <field name="currency_id" column_invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="确认分配" class="oe_highlight"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
