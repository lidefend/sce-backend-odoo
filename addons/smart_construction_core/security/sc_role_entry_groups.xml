<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Compatibility capability bridges have one complete authority declaration.
             Role composition is declared once in sc_role_groups.xml. -->
        <record id="group_sc_business_full" model="res.groups">
            <field name="implied_ids" eval="[(6, 0, [
                ref('smart_construction_core.group_sc_cap_business_full')
            ])]"/>
        </record>
        <record id="group_sc_cap_business_config_admin" model="res.groups">
            <field name="implied_ids" eval="[(6, 0, [
                ref('base.group_allow_export'),
                ref('smart_construction_core.group_sc_cap_business_full'),
                ref('smart_construction_core.group_sc_internal_user'),
                ref('smart_core.group_smart_core_business_config_admin')
            ])]"/>
        </record>
    </data>
</odoo>
