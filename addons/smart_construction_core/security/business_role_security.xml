<field name="name">sc.user.role.assignment company authority</field>
<field name="model_id" ref="model_sc_user_role_assignment"/>
<field name="domain_force">[('company_id', 'in', user._sc_data_company_ids())]</field>
</record>
<record id="rule_sc_business_role_event_company" model="ir.rule">
<field name="name">sc.business.role.event company authority</field>
<field name="model_id" ref="model_sc_business_role_event"/>
<field name="domain_force">[('company_id', 'in', user._sc_data_company_ids())]</field>
</record>
<record id="rule_sc_business_role_version_company" model="ir.rule">
