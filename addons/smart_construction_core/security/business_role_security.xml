<field name="model_id" ref="model_sc_business_role_change"/>
<field name="domain_force">[('company_id', 'in', user._sc_data_company_ids())]</field>
</record>
<record id="rule_sc_business_role_change_assigned_review" model="ir.rule">
<field name="name">Role authority change assigned reviewer</field><field name="model_id" ref="model_sc_business_role_change"/>
<field name="groups" eval="[(4, ref('base.group_user'))]"/>
<field name="domain_force">[('review_ids.reviewer_ids', 'in', [user.id])]</field>
<field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
</record>
<record id="rule_sc_business_role_change_admin" model="ir.rule">
<field name="name">Role authority change business administrator</field><field name="model_id" ref="model_sc_business_role_change"/>
<field name="groups" eval="[(4, ref('smart_construction_core.group_sc_cap_business_config_admin'))]"/>
<field name="domain_force">[(1, '=', 1)]</field>
</record>
</odoo>
