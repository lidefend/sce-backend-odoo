<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 项目台账记录页：概览身份区 + 完整项目资料维护区（唯一项目产品入口） -->
    <record id="view_project_overview_form" model="ir.ui.view">
        <field name="name">project.project.form.sc.overview</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <!-- 项目台账 is the single project-center record entry. Its master-data
                 maintenance composition is carried over from the retired 项目信息编辑
                 entry so the product exposes one permission/contract-driven record
                 surface instead of a read-only overview plus a duplicate edit page.
                 Capability belongs to the entry contract and to ACL/field groups,
                 never to this presentation arch. The overview block below keeps its
                 original element order because a persisted low-code orchestration
                 targets it by native index. -->
            <form string="项目概览">
                <sheet>
                    <div class="sc-project-overview">
                        <div class="sc-project-overview__header d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="sc-project-title h3 mb-1">
                                    <field name="name" readonly="1"/>
                                </div>
                                <div class="small text-muted">
                                    项目编号 <field name="project_code" readonly="1" nolabel="1"/>
                                    · 经营方式 <field name="operation_strategy" readonly="1" nolabel="1"/>
                                    · 经营性质 <field name="business_nature" readonly="1" nolabel="1"/>
                                </div>
                                <div class="text-muted">你是：项目负责人 <field name="user_id" readonly="1"/></div>
                                <div class="text-muted">项目经理 <field name="manager_id" readonly="1"/></div>
                                <div class="small text-muted mt-1">
                                    业主 <field name="owner_id" readonly="1"/>
                                    · 类型 <field name="project_type_id" readonly="1"/>
                                </div>
                                <div class="small text-muted mt-1">
                                    · 更新时间 <field name="write_date" readonly="1" nolabel="1"/>
                                </div>
                                <field name="location" readonly="1" invisible="1"/>
                            </div>
                            <button type="action"
                                    name="%(smart_construction_core.action_sc_project_manage)d"
                                    string="项目设置"
                                    class="btn btn-link"
                                    groups="smart_construction_core.group_sc_cap_project_manager,smart_construction_core.group_sc_super_admin"/>
                        </div>

                        <div class="sc-project-stage mb-3">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="sc-project-stage__label">当前阶段：<field name="lifecycle_state" readonly="1"/></div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button name="%(smart_construction_core.action_sc_project_manage)d"
                                            type="action"
                                            string="去补齐资料"
                                            class="btn btn-outline-primary"
                                            invisible="lifecycle_state != 'draft' or (sc_stage_required_done == sc_stage_required_total)"/>
                                    <field name="sc_approval_state" readonly="1"/>
                <field name="validation_status" invisible="1"/>
                <field name="can_review" invisible="1"/>
                <field name="reject_reason" invisible="not reject_reason" readonly="1"/>
                                    <button name="validate_tier" type="object" string="审批通过" invisible="not can_review or validation_status not in ('waiting', 'pending')"/>
                <button name="reject_tier" type="object" string="审批驳回" invisible="not can_review or validation_status not in ('waiting', 'pending')"/>
                <button name="action_sc_start" type="object" string="启动项目" invisible="lifecycle_state != 'draft' or sc_approval_state != 'approved'"/>
                                    <button name="action_sc_submit"
                                            type="object"
                                            string="提交立项"
                                            class="btn btn-primary"
                                            invisible="lifecycle_state != 'draft' or sc_approval_state != 'draft' or validation_status in ('waiting', 'pending', 'validated')"/>
                                    <button name="action_view_stage_requirements"
                                            type="object"
                                            string="查看阶段要求"
                                            class="btn btn-primary"
                                            invisible="lifecycle_state == 'draft'"/>
                                </div>
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'draft'">
                                立项完成度：
                                <field name="sc_stage_required_done" readonly="1" nolabel="1"/>
                                /
                                <field name="sc_stage_required_total" readonly="1" nolabel="1"/>
                            </div>
                            <div class="sc-project-stage__req" invisible="lifecycle_state != 'draft'">
                                <div class="text-muted mb-1">要进入下一阶段，你还差：</div>
                                <widget name="sc_stage_requirements" options="{'limit': 3}"/>
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'in_progress'">
                                施工推进中，优先处理待办与关键风险。
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'paused'">
                                项目已暂停，需明确原因并评估恢复条件。
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'done'">
                                项目已完成，准备结算与归档。
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'closing'">
                                进入结算阶段，请核对合同与成本。
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'warranty'">
                                保修期内，关注问题闭环与客户反馈。
                            </div>
                            <div class="sc-project-stage__desc text-muted mt-2" invisible="lifecycle_state != 'closed'">
                                项目已归档，历史数据只读。
                            </div>
                        </div>

                        <div class="sc-project-next mb-4">
                            <div class="sc-project-next__title">你现在最该做的事</div>
                            <widget name="sc_next_actions" options="{'limit': 3}"/>
                        </div>

                        <div class="sc-project-cards">
                            <div class="sc-project-cards__title">项目当前状态（概览）</div>
                            <div class="row g-2">
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="fw-bold">合同</div>
                                            <div class="text-muted" invisible="sc_overview_contract_count != 0">
                                                尚未建立合同
                                            </div>
                                            <div class="text-muted" invisible="sc_overview_contract_count == 0">
                                                已有 <field name="sc_overview_contract_count" readonly="1" nolabel="1"/> 份合同
                                            </div>
                                            <button type="action"
                                                    name="%(smart_construction_core.action_construction_contract_my)d"
                                                    string="查看合同"
                                                    class="btn btn-link px-0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="fw-bold">成本</div>
                                            <div class="text-muted" invisible="sc_overview_cost_count != 0">
                                                尚未录入成本
                                            </div>
                                            <div class="text-muted" invisible="sc_overview_cost_count == 0">
                                                已录入 <field name="sc_overview_cost_count" readonly="1" nolabel="1"/> 条
                                            </div>
                                            <button type="action"
                                                    name="%(smart_construction_core.action_project_cost_ledger_my)d"
                                                    string="查看成本"
                                                    class="btn btn-link px-0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="fw-bold">财务</div>
                                            <div class="text-muted" invisible="sc_overview_payment_pending_count == 0">
                                                ⚠ 有待审批付款 <field name="sc_overview_payment_pending_count" readonly="1" nolabel="1"/> 笔
                                            </div>
                                            <div class="text-muted" invisible="sc_overview_payment_pending_count != 0">
                                                当前无待审批付款
                                            </div>
                                            <button type="action"
                                                    name="%(smart_construction_core.action_payment_request_my)d"
                                                    string="查看财务"
                                                    class="btn btn-link px-0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="fw-bold">项目任务</div>
                                            <div class="text-muted" invisible="sc_overview_task_in_progress_count == 0">
                                                进行中任务 <field name="sc_overview_task_in_progress_count" readonly="1" nolabel="1"/> 项
                                            </div>
                                            <div class="text-muted" invisible="sc_overview_task_in_progress_count != 0">
                                                当前无进行中任务
                                            </div>
                                            <button type="object"
                                                    name="action_view_my_tasks"
                                                    string="查看任务"
                                                    class="btn btn-link px-0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 项目资料维护区：承载原「项目信息编辑」入口的完整功能。 -->
                    <field name="message_needaction" invisible="1"/>
                    <field name="display_name" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="lifecycle_state != 'draft'">
                        保存用于更新项目资料；“提交立项”用于推进项目状态并执行后端校验。
                    </div>

                    <group name="sc_project_information_basic" string="基本信息" col="4"
                           data-sc-anchor="project-basic">
                        <field name="name" string="项目名称"/>
                        <field name="project_code" readonly="1" invisible="id == False"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="partner_id" widget="res_partner_many2one"
                               context="{'res_partner_search_mode': 'customer'}"
                               options="{'always_reload': True}"/>
                        <field name="project_type_id"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="project_category_id" invisible="1"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="operation_strategy"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="location"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="owner_contact"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="contract_no"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="company_id" readonly="1"/>
                        <field name="phase_key" invisible="1"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                    </group>

                    <group name="sc_project_information_plan" string="计划与责任" col="4"
                           data-sc-anchor="project-plan-responsibility">
                        <field name="initiation_date"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="date_start" string="项目周期" widget="daterange"
                               options="{&quot;end_date_field&quot;: &quot;date&quot;, &quot;always_range&quot;: &quot;1&quot;}"
                               required="date_start or date"/>
                        <field name="date" invisible="1" required="date_start"/>
                        <field name="start_date"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="end_date"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="user_id" string="项目负责人" widget="many2one_avatar_user"
                               domain="[('share', '=', False)]" readonly="not active"
                               options="{'no_quick_create': True}"/>
                        <field name="manager_id"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="cost_manager_id"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="doc_manager_id"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                    </group>

                    <group name="sc_project_information_responsibility" string="责任矩阵" col="1"
                           data-sc-anchor="project-responsibility-matrix">
                        <field name="responsibility_ids" nolabel="1"
                               groups="smart_construction_core.group_sc_cap_project_read">
                            <tree editable="bottom">
                                <field name="role_key"/>
                                <field name="user_id"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </group>

                    <group name="sc_project_information_description" string="项目说明" col="1"
                           data-sc-anchor="project-description"
                           data-sc-navigation-role="subordinate">
                        <field name="description" nolabel="1"
                               options="{'resizable': false}"/>
                    </group>

                    <group name="sc_project_information_collaboration" string="协作资料" col="4"
                           data-sc-anchor="project-collaboration"
                           data-sc-navigation-role="subordinate">
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                        <field name="collaborator_ids"/>
                    </group>

                    <group name="sc_project_information_trace" string="系统追溯" col="4"
                           data-sc-anchor="project-system-trace"
                           data-sc-navigation-role="subordinate"
                           data-sc-collapsible="1"
                           data-sc-collapsed-by-default="1">
                        <field name="analytic_account_id" readonly="1"/>
                        <field name="source_created_by" readonly="1"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                        <field name="source_created_at" readonly="1"
                               groups="smart_construction_core.group_sc_cap_project_read"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
