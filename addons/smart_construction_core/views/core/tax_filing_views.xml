<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sc_tax_filing_tree" model="ir.ui.view"><field name="name">sc.tax.filing.tree</field><field name="model">sc.tax.filing</field><field name="arch" type="xml"><tree string="税务申报" delete="0"><field name="name"/><field name="company_id"/><field name="period_start"/><field name="period_end"/><field name="state"/><field name="output_tax_amount" sum="销项税额"/><field name="deductible_tax_amount" sum="抵扣税额"/><field name="prepaid_tax_amount" sum="预缴税额"/><field name="declared_payable_amount" sum="申报应纳额"/><field name="handler_id"/></tree></field></record>
  <record id="view_sc_tax_filing_form" model="ir.ui.view"><field name="name">sc.tax.filing.form</field><field name="model">sc.tax.filing</field><field name="arch" type="xml"><form string="税务申报" delete="0"><header><button name="action_calculate" type="object" string="测算税额" class="btn-primary" invisible="state not in ['draft', 'calculated']"/><button name="action_submit" type="object" string="确认申报" class="btn-primary" invisible="state != 'calculated'"/><button name="action_accept" type="object" string="登记受理" class="btn-primary" invisible="state != 'submitted'"/><button name="action_cancel" type="object" string="取消" invisible="state in ['accepted', 'cancelled']"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,submitted,accepted"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="invoice_source_count" widget="statinfo" string="发票来源"/></button><button name="action_open_deductions" type="object" class="oe_stat_button" icon="fa-check-square-o"><field name="deduction_source_count" widget="statinfo" string="抵扣来源"/></button></div><group><group string="申报信息"><field name="name" readonly="1"/><field name="company_id" readonly="state != 'draft'"/><field name="period_start" readonly="state != 'draft'"/><field name="period_end" readonly="state != 'draft'"/><field name="handler_id"/><field name="declaration_no"/></group><group string="治理信息"><field name="calculated_at"/><field name="submitted_at"/><field name="accepted_at"/><field name="currency_id" invisible="1"/></group></group><group string="税额测算" col="4"><field name="output_tax_amount"/><field name="input_tax_amount"/><field name="deductible_tax_amount"/><field name="prepaid_tax_amount"/><field name="surcharge_amount"/><field name="vat_payable_amount"/><field name="other_tax_adjustment" readonly="state in ['submitted', 'accepted', 'cancelled']"/><field name="declared_payable_amount"/></group><group string="说明与附件"><field name="note"/><field name="attachment_ids" widget="many2many_binary"/></group></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
  <record id="view_sc_tax_filing_search" model="ir.ui.view"><field name="name">sc.tax.filing.search</field><field name="model">sc.tax.filing</field><field name="arch" type="xml"><search string="税务申报"><field name="name"/><field name="company_id"/><field name="period_start"/><field name="period_end"/><filter name="draft" string="草稿" domain="[('state','=','draft')]"/><filter name="submitted" string="已申报" domain="[('state','=','submitted')]"/><filter name="accepted" string="已受理" domain="[('state','=','accepted')]"/><separator/><filter name="group_company" string="按公司" context="{'group_by':'company_id'}"/><filter name="group_period" string="按申报期" context="{'group_by':'period_end:month'}"/></search></field></record>
</odoo>
