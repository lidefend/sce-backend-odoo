<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sc_contract_execution_position_search" model="ir.ui.view">
        <field name="name">construction.contract.execution.position.search</field>
        <field name="model">sc.contract.execution.position</field>
        <field name="arch" type="xml">
            <search string="合同执行态势">
                <field name="subject"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <filter name="income" string="收入合同" domain="[('type', '=', 'out')]"/>
                <filter name="expense" string="支出合同" domain="[('type', '=', 'in')]"/>
                <filter name="ratio_undefined" string="零合同额" domain="[('ratio_defined', '=', False)]"/>
                <separator/>
                <filter name="group_company" string="按公司" context="{'group_by': 'company_id'}"/>
                <filter name="group_project" string="按项目" context="{'group_by': 'project_id'}"/>
                <filter name="group_type" string="按收支方向" context="{'group_by': 'type'}"/>
                <filter name="group_state" string="按状态" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="按往来单位" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sc_contract_execution_position_tree" model="ir.ui.view">
        <field name="name">construction.contract.execution.position.tree</field>
        <field name="model">sc.contract.execution.position</field>
        <field name="arch" type="xml">
            <tree string="合同执行态势" create="0" edit="0" delete="0">
                <field name="type"/>
                <field name="company_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <field name="state"/>
                <field name="contract_amount" sum="最终合同价"/>
                <field name="settled_amount" sum="已结算"/>
                <field name="settlement_balance" sum="未结算"/>
                <field name="invoiced_amount" sum="已开票"/>
                <field name="invoice_balance" sum="未开票"/>
                <field name="cash_executed_amount" sum="现金执行"/>
                <field name="cash_balance" sum="现金未执行"/>
                <field name="settlement_rate" widget="percentage"/>
                <field name="invoice_rate" widget="percentage"/>
                <field name="cash_execution_rate" widget="percentage"/>
                <field name="ratio_defined"/>
            </tree>
        </field>
    </record>

    <record id="view_sc_contract_execution_position_pivot" model="ir.ui.view">
        <field name="name">construction.contract.execution.position.pivot</field>
        <field name="model">sc.contract.execution.position</field>
        <field name="arch" type="xml">
            <pivot string="合同执行态势">
                <field name="company_id" type="row"/>
                <field name="project_id" type="row"/>
                <field name="type" type="col"/>
                <field name="contract_amount" type="measure"/>
                <field name="settled_amount" type="measure"/>
                <field name="invoiced_amount" type="measure"/>
                <field name="cash_executed_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sc_contract_execution_position_form" model="ir.ui.view">
        <field name="name">construction.contract.execution.position.form</field>
        <field name="model">sc.contract.execution.position</field>
        <field name="arch" type="xml">
            <form string="合同执行态势" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_execution_source_contract" type="object" string="打开来源合同" class="oe_highlight"/>
                    <field name="state"/>
                </header>
                <sheet>
                    <group>
                        <group string="合同识别">
                            <field name="type"/>
                            <field name="contract_id"/>
                            <field name="subject"/>
                            <field name="company_id"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="执行基准">
                            <field name="contract_amount"/>
                            <field name="ratio_defined"/>
                        </group>
                    </group>
                    <group>
                        <group string="结算与开票">
                            <field name="settled_amount"/>
                            <field name="settlement_balance"/>
                            <field name="settlement_rate" widget="percentage"/>
                            <field name="invoiced_amount"/>
                            <field name="invoice_balance"/>
                            <field name="invoice_rate" widget="percentage"/>
                        </group>
                        <group string="现金执行">
                            <field name="cash_executed_amount"/>
                            <field name="cash_balance"/>
                            <field name="cash_execution_rate" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sc_contract_execution_position" model="ir.actions.act_window">
        <field name="name">合同执行态势</field>
        <field name="res_model">sc.contract.execution.position</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="views" eval="[(ref('view_sc_contract_execution_position_tree'), 'tree'), (ref('view_sc_contract_execution_position_pivot'), 'pivot'), (ref('view_sc_contract_execution_position_form'), 'form')]"/>
        <field name="search_view_id" ref="view_sc_contract_execution_position_search"/>
        <field name="domain">[]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_contract_read'))]"/>
    </record>
</odoo>
