<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_sc_construction_diary_search" model="ir.ui.view">
            <field name="name">sc.construction.diary.search</field>
            <field name="model">sc.construction.diary</field>
            <field name="arch" type="xml">
                <search string="施工日志">
                    <field name="name"/>
                    <field name="document_no"/>
                    <field name="title"/>
                    <field name="project_id"/>
                    <field name="diary_type"/>
                    <field name="quality_name"/>
                    <field name="handler_name"/>
                    <filter string="日报表" name="daily_report" domain="[('diary_type', '=', '日报表')]"/>
                    <filter string="周报表" name="weekly_report" domain="[('diary_type', '=', '周报表')]"/>
                    <filter string="月报表" name="monthly_report" domain="[('diary_type', '=', '月报表')]"/>
                    <filter string="已确认" name="state_confirmed" domain="[('state', 'in', ['confirmed', 'legacy_confirmed'])]"/>
                    <filter string="已完成" name="state_done" domain="[('state', '=', 'done')]"/>
                    <filter string="按项目" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="按状态" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="按经办人" name="group_handler" context="{'group_by': 'handler_name'}"/>
                    <filter string="按日期" name="group_date" context="{'group_by': 'date_diary'}"/>
                </search>
            </field>
        </record>

        <record id="view_sc_construction_diary_tree" model="ir.ui.view">
            <field name="name">sc.construction.diary.tree</field>
            <field name="model">sc.construction.diary</field>
            <field name="arch" type="xml">
                <tree string="施工日志">
                    <field name="name"/>
                    <field name="date_diary"/>
                    <field name="project_id"/>
                    <field name="document_no"/>
                    <field name="title"/>
                    <field name="diary_type"/>
                    <field name="category"/>
                    <field name="report_period_start"/>
                    <field name="report_period_end"/>
                    <field name="construction_unit"/>
                    <field name="project_manager"/>
                    <field name="weather"/>
                    <field name="manpower_count" sum="现场人数"/>
                    <field name="attendance_equipment"/>
                    <field name="quality_name"/>
                    <field name="handler_name"/>
                    <field name="state"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_sc_construction_diary_form" model="ir.ui.view">
            <field name="name">sc.construction.diary.form</field>
            <field name="model">sc.construction.diary</field>
            <field name="arch" type="xml">
                <form string="施工日志">
                    <header>
                        <field name="can_review" invisible="1"/>
                        <field name="validation_status" invisible="1"/>
                        <button name="validate_tier" string="审批通过" type="object" invisible="not can_review or validation_status not in ('waiting', 'pending')"/>
                        <button name="reject_tier" string="审批驳回" type="object" invisible="not can_review or validation_status not in ('waiting', 'pending')"/>
                        <button name="action_confirm" string="提交审批" type="object" class="btn-primary"
                                invisible="state != 'draft' or validation_status in ('waiting', 'pending', 'validated')"/>
                        <button name="action_done" string="完成" type="object" class="btn-primary"
                                invisible="state != 'confirmed'"/>
                        <button name="action_cancel" string="取消" type="object"
                                invisible="state not in ('draft', 'confirmed')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,done,legacy_confirmed,cancel"/>
                    </header>
                    <sheet>
                        <field name="reject_reason" invisible="not reject_reason"/>
                        <!-- U-C4 G10: 原生 arch 持有本入口的章节身份。四个业务组带稳定
                             `data-sc-anchor`，消费方按它生成本入口的业务章节与章节导航；
                             `view_sc_construction_diary_form` 是 729（施工日志）的原生承载。
                             入口契约 245 的 body 副本已退役（只留 title 与 native_semantic_surface），
                             字段级只读口径由原生承接：`name` 原生 `readonly="1"`，其余业务事实
                             在 `legacy_confirmed` 后只读，`state` 由状态条承载。
                             同族的 730／731／732（日报表／周报表／月报表）共用本表单，但它们
                             继续消费模型级镜像 61／148 的结构面（退役属另一组的工作），
                             本批只为本表单补齐章节锚点。
                             尾组（`note`／`attachment_ids`／`active`）是随时可补的依据类事实与
                             归档标记，不承载可编辑业务事实，故按 G08／G09 口径**不设**章节锚点。 -->
                        <group name="construction_diary_overview">
                            <group name="construction_diary_log_main" data-sc-anchor="construction_diary_log_main" string="日志主信息">
                                <field name="name" readonly="1"/>
                                <field name="date_diary" readonly="state == 'legacy_confirmed'"/>
                                <field name="report_period_start" readonly="state == 'legacy_confirmed'"/>
                                <field name="report_period_end" readonly="state == 'legacy_confirmed'"/>
                                <field name="document_no" readonly="state == 'legacy_confirmed'"/>
                                <field name="title" readonly="state == 'legacy_confirmed'"/>
                            </group>
                            <group name="construction_diary_period_handler" data-sc-anchor="construction_diary_period_handler" string="期间与经办">
                                <field name="project_id" readonly="state == 'legacy_confirmed'"/>
                                <field name="diary_type" readonly="state == 'legacy_confirmed'"/>
                                <field name="category" readonly="state == 'legacy_confirmed'"/>
                                <field name="handler_name" readonly="state == 'legacy_confirmed'"/>
                            </group>
                        </group>
                        <group name="construction_diary_site_information" data-sc-anchor="construction_diary_site_information" string="现场信息">
                            <field name="construction_unit" readonly="state == 'legacy_confirmed'"/>
                            <field name="project_manager" readonly="state == 'legacy_confirmed'"/>
                            <field name="weather" readonly="state == 'legacy_confirmed'"/>
                            <field name="manpower_count" readonly="state == 'legacy_confirmed'"/>
                            <field name="attendance_equipment" readonly="state == 'legacy_confirmed'"/>
                            <field name="quality_name" readonly="state == 'legacy_confirmed'"/>
                        </group>
                        <group name="construction_diary_log_content" data-sc-anchor="construction_diary_log_content" string="日志内容">
                            <field name="description" readonly="state == 'legacy_confirmed'"/>
                            <field name="material_inspection_note" readonly="state == 'legacy_confirmed'"/>
                            <field name="design_change_note" readonly="state == 'legacy_confirmed'"/>
                            <field name="test_block_note" readonly="state == 'legacy_confirmed'"/>
                            <field name="safety_note" readonly="state == 'legacy_confirmed'"/>
                            <field name="hidden_acceptance_note" readonly="state == 'legacy_confirmed'"/>
                            <field name="next_plan" readonly="state == 'legacy_confirmed'"/>
                            <field name="header_description" readonly="state == 'legacy_confirmed'"/>
                        </group>
                        <group>
                            <field name="note"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_sc_construction_diary" model="ir.actions.act_window">
            <field name="name">施工日志</field>
            <field name="res_model">sc.construction.diary</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sc_construction_diary_search"/>
            <field name="context">{'search_default_group_project': 1}</field>
            <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_user')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_manager'))]"/>
        </record>

        <record id="action_sc_construction_daily_report" model="ir.actions.act_window">
            <field name="name">日报表</field>
            <field name="res_model">sc.construction.diary</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sc_construction_diary_search"/>
            <field name="domain">[('diary_type', '=', '日报表')]</field>
            <field name="context">{'default_diary_type': '日报表', 'search_default_group_project': 1}</field>
            <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_user')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_manager'))]"/>
        </record>

        <record id="action_sc_construction_weekly_report" model="ir.actions.act_window">
            <field name="name">周报表</field>
            <field name="res_model">sc.construction.diary</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sc_construction_diary_search"/>
            <field name="domain">[('diary_type', '=', '周报表')]</field>
            <field name="context">{'default_diary_type': '周报表', 'search_default_group_project': 1}</field>
            <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_user')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_manager'))]"/>
        </record>

        <record id="action_sc_construction_monthly_report" model="ir.actions.act_window">
            <field name="name">月报表</field>
            <field name="res_model">sc.construction.diary</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_sc_construction_diary_search"/>
            <field name="domain">[('diary_type', '=', '月报表')]</field>
            <field name="context">{'default_diary_type': '月报表', 'search_default_group_project': 1}</field>
            <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_user')),
                                           (4, ref('smart_construction_core.group_sc_cap_project_manager'))]"/>
        </record>

        <menuitem id="menu_sc_construction_diary"
                  name="施工日志"
                  parent="smart_construction_core.menu_sc_project_center"
                  action="action_sc_construction_diary"
                  sequence="58"
                  groups="smart_construction_core.group_sc_cap_project_read,smart_construction_core.group_sc_cap_project_user,smart_construction_core.group_sc_cap_project_manager"/>
    </data>
</odoo>
