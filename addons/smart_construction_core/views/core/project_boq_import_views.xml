<odoo>
    <record id="view_project_boq_import_wizard" model="ir.ui.view">
        <field name="name">project.boq.import.wizard.form</field>
        <field name="model">project.boq.import.wizard</field>
        <field name="arch" type="xml">
            <form string="工程量清单导入">
                <field name="state" invisible="1"/>
                <group>
                    <field name="project_id" readonly="state != 'upload'"/>
                    <field name="section_type" readonly="state != 'upload'"/>
                    <field name="single_name" readonly="state != 'upload'"/>
                    <field name="unit_name" readonly="state != 'upload'"/>
                    <field name="source_type" readonly="state != 'upload'"/>
                    <field name="version_code" readonly="state != 'upload'"/>
                    <field name="file" filename="filename" readonly="state != 'upload'"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group string="预检摘要" invisible="state == 'upload'">
                    <group>
                        <field name="preview_row_count"/>
                        <field name="preview_item_count"/>
                        <field name="preview_heading_count"/>
                        <field name="preview_summary_count"/>
                        <field name="preview_skipped_count"/>
                    </group>
                    <group>
                        <field name="preview_amount"/>
                        <field name="preview_warning_count"/>
                        <field name="preview_digest"/>
                    </group>
                    <field name="preview_log" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button string="预检" type="object" name="action_preflight"
                            class="oe_highlight" invisible="state != 'upload'"/>
                    <button string="确认导入" type="object" name="action_import"
                            class="oe_highlight" invisible="state != 'preview'"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_boq_import_wizard" model="ir.actions.act_window">
        <field name="name">工程量清单导入</field>
        <field name="res_model">project.boq.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_boq_import_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_project_id': context.get('active_id')}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_cost_user')), (4, ref('smart_construction_core.group_sc_cap_cost_manager'))]"/>
    </record>
</odoo>
