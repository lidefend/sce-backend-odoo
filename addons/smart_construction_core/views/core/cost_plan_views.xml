<odoo>
    <record id="view_project_cost_plan_tree" model="ir.ui.view">
        <field name="name">project.cost.plan.tree</field>
        <field name="model">project.cost.plan</field>
        <field name="arch" type="xml">
            <tree string="成本计划" decoration-success="state == 'published'" decoration-muted="state == 'archived'">
                <field name="project_id"/>
                <field name="name"/>
                <field name="version_code"/>
                <field name="version_date"/>
                <field name="boq_version_id"/>
                <field name="state" widget="badge"/>
                <field name="line_count"/>
                <field name="budget_amount"/>
                <field name="target_amount"/>
                <field name="saving_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_project_cost_plan_form" model="ir.ui.view">
        <field name="name">project.cost.plan.form</field>
        <field name="model">project.cost.plan</field>
        <field name="arch" type="xml">
            <form string="成本计划">
                <header>
                    <button name="action_generate_from_boq" string="从清单分析生成" type="object" class="oe_highlight" invisible="state not in ('draft', 'adjusting') or line_count != 0"/>
                    <button name="action_validate" string="校验" type="object" class="oe_highlight" invisible="state not in ('draft', 'adjusting') or line_count == 0"/>
                    <button name="action_publish" string="发布" type="object" class="oe_highlight" invisible="state != 'validated'"/>
                    <button name="action_start_adjustment" string="发起调整" type="object" invisible="state != 'published'"/>
                    <button name="action_open_lines" string="成本编制" type="object" invisible="line_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,published,adjusting,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="state in ('published', 'archived')"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="boq_version_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="version_code" readonly="state != 'draft'"/>
                            <field name="version_date" readonly="state in ('published', 'archived')"/>
                            <field name="source_plan_id" invisible="not source_plan_id"/>
                        </group>
                        <group>
                            <field name="budget_amount"/>
                            <field name="target_amount"/>
                            <field name="saving_amount"/>
                            <field name="line_count"/>
                            <field name="validated_by_id" invisible="not validated_by_id"/>
                            <field name="published_by_id" invisible="not published_by_id"/>
                        </group>
                    </group>
                    <group string="编制说明">
                        <field name="note" placeholder="填写本版成本目标、测算边界和调整依据。"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_cost_plan_line_tree" model="ir.ui.view">
        <field name="name">project.cost.plan.line.tree</field>
        <field name="model">project.cost.plan.line</field>
        <field name="arch" type="xml">
            <tree string="目标成本明细" create="false" delete="false">
                <field name="plan_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="boq_line_id"/>
                <field name="cost_type"/>
                <field name="line_role" widget="badge"/>
                <field name="name"/>
                <field name="calculation_mode"/>
                <field name="unit_raw"/>
                <field name="boq_quantity"/>
                <field name="budget_unit_consumption"/>
                <field name="budget_unit_price"/>
                <field name="budget_quantity"/>
                <field name="budget_amount"/>
                <field name="target_unit_consumption"/>
                <field name="target_unit_price"/>
                <field name="adjustment_ratio"/>
                <field name="target_rate" optional="hide"/>
                <field name="target_quantity"/>
                <field name="target_amount"/>
                <field name="variance_amount"/>
                <field name="plan_state" widget="badge" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_project_cost_plan_line_form" model="ir.ui.view">
        <field name="name">project.cost.plan.line.form</field>
        <field name="model">project.cost.plan.line</field>
        <field name="arch" type="xml">
            <form string="目标成本明细" create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="true"/></h1></div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="true"/>
                            <field name="plan_state" readonly="true" widget="badge"/>
                            <field name="boq_line_id" readonly="true"/>
                            <field name="analysis_id" readonly="true"/>
                            <field name="cost_type" readonly="true"/>
                            <field name="line_role" readonly="true" widget="badge"/>
                            <field name="calculation_mode" readonly="true"/>
                            <field name="unit_raw" readonly="true"/>
                        </group>
                        <group>
                            <field name="boq_quantity" readonly="true"/>
                            <field name="budget_unit_consumption" readonly="true"/>
                            <field name="budget_unit_price" readonly="true"/>
                            <field name="budget_quantity" readonly="true"/>
                            <field name="budget_amount" readonly="true"/>
                        </group>
                    </group>
                    <group string="目标编制">
                        <field name="target_unit_consumption" readonly="plan_state not in ('draft', 'adjusting')"/>
                        <field name="target_unit_price" readonly="plan_state not in ('draft', 'adjusting')"/>
                        <field name="adjustment_ratio" readonly="plan_state not in ('draft', 'adjusting')"/>
                        <field name="target_rate" readonly="plan_state not in ('draft', 'adjusting') or calculation_mode != 'rate'"/>
                        <field name="target_quantity" readonly="true"/>
                        <field name="target_amount" readonly="true"/>
                        <field name="variance_amount" readonly="true"/>
                    </group>
                    <group string="来源依据">
                        <field name="source_resource_line_id" readonly="true"/>
                        <field name="source_summary_component_id" readonly="true"/>
                        <field name="source_calc_base" readonly="true"/>
                        <field name="budget_rate" readonly="true"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_cost_plan_line_search" model="ir.ui.view">
        <field name="name">project.cost.plan.line.search</field>
        <field name="model">project.cost.plan.line</field>
        <field name="arch" type="xml">
            <search string="目标成本明细">
                <field name="plan_id"/>
                <field name="boq_line_id"/>
                <field name="name"/>
                <field name="cost_type"/>
                <filter string="人工" name="labor" domain="[('cost_type', '=', 'labor')]"/>
                <filter string="材料" name="material" domain="[('cost_type', '=', 'material')]"/>
                <filter string="机械" name="machine" domain="[('cost_type', '=', 'machine')]"/>
                <filter string="管理费" name="overhead" domain="[('cost_type', '=', 'overhead')]"/>
                <filter string="税费" name="tax_fee" domain="[('cost_type', 'in', ('fee', 'tax'))]"/>
                <group expand="0" string="分组">
                    <filter string="成本口径" name="group_cost_type" context="{'group_by': 'cost_type'}"/>
                    <filter string="清单项" name="group_boq" context="{'group_by': 'boq_line_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_cost_plan_line" model="ir.actions.act_window">
        <field name="name">目标成本明细</field>
        <field name="res_model">project.cost.plan.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_project_cost_plan_line_search"/>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_cost_read'))]"/>
    </record>

    <record id="view_project_cost_plan_node_tree" model="ir.ui.view">
        <field name="name">project.cost.plan.node.tree</field>
        <field name="model">project.cost.plan.node</field>
        <field name="arch" type="xml">
            <tree string="成本构成树" js_class="smart_hierarchy_planner" create="false" delete="false"
                  default_order="plan_id, parent_path, sequence, id">
                <field name="parent_id" optional="hide"/>
                <field name="code" string="编码"/>
                <field name="name" string="成本构成"/>
                <field name="node_type" widget="badge" string="层级"/>
                <field name="cost_type" widget="badge" string="成本口径"/>
                <field name="line_role" widget="badge" optional="hide"/>
                <field name="unit_raw"/>
                <field name="budget_quantity" optional="hide"/>
                <field name="target_quantity" optional="hide"/>
                <field name="line_count" string="资源明细数"/>
                <field name="budget_amount"/>
                <field name="target_amount"/>
                <field name="variance_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_project_cost_plan_node_form" model="ir.ui.view">
        <field name="name">project.cost.plan.node.form</field>
        <field name="model">project.cost.plan.node</field>
        <field name="arch" type="xml">
            <form string="成本构成节点" create="false" delete="false">
                <header>
                    <button name="action_open_cost_line" string="编制资源明细" type="object" class="oe_highlight"
                            invisible="node_type != 'resource'"/>
                    <field name="plan_state" widget="statusbar" statusbar_visible="draft,validated,published,adjusting,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="true"/></h1></div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="true"/>
                            <field name="parent_id" readonly="true"/>
                            <field name="code" readonly="true"/>
                            <field name="node_type" readonly="true" widget="badge"/>
                            <field name="cost_type" readonly="true" widget="badge"/>
                            <field name="line_role" readonly="true" widget="badge" invisible="node_type != 'resource'"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="true"/>
                            <field name="budget_amount" readonly="true"/>
                            <field name="target_amount" readonly="true"/>
                            <field name="variance_amount" readonly="true"/>
                        </group>
                    </group>
                    <group string="资源目标编制" invisible="node_type != 'resource'">
                        <group>
                            <field name="unit_raw" readonly="true"/>
                            <field name="budget_quantity" readonly="true"/>
                            <field name="target_quantity" readonly="true"/>
                            <field name="calculation_mode" readonly="true"/>
                        </group>
                        <group>
                            <field name="target_unit_consumption" readonly="plan_state not in ('draft', 'adjusting')"/>
                            <field name="target_unit_price" readonly="plan_state not in ('draft', 'adjusting')"/>
                            <field name="adjustment_ratio" readonly="plan_state not in ('draft', 'adjusting')"/>
                            <field name="target_rate" readonly="plan_state not in ('draft', 'adjusting') or calculation_mode != 'rate'"/>
                        </group>
                    </group>
                    <group string="来源追溯">
                        <field name="boq_line_id" readonly="true"/>
                        <field name="cost_line_id" readonly="true"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_cost_plan_node_search" model="ir.ui.view">
        <field name="name">project.cost.plan.node.search</field>
        <field name="model">project.cost.plan.node</field>
        <field name="arch" type="xml">
            <search string="成本构成">
                <field name="plan_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="cost_type"/>
                <field name="boq_line_id"/>
            </search>
        </field>
    </record>

    <record id="action_project_cost_plan_node" model="ir.actions.act_window">
        <field name="name">成本编制</field>
        <field name="res_model">project.cost.plan.node</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_project_cost_plan_node_tree"/>
        <field name="search_view_id" ref="view_project_cost_plan_node_search"/>
        <field name="context">{'hierarchy_levels': [{'field': 'parent_id', 'code_field': 'code', 'label_field': 'name', 'self_parent_field': 'parent_id', 'domain_operator': 'child_of', 'order': 'plan_id, parent_path, sequence, id'}], 'hierarchy_scope': {'field': 'plan_id', 'context_field': 'default_plan_id'}, 'hierarchy_default_expand_depth': 0, 'hierarchy_page_size': 12000}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_cost_read'))]"/>
    </record>

    <record id="view_project_cost_plan_search" model="ir.ui.view">
        <field name="name">project.cost.plan.search</field>
        <field name="model">project.cost.plan</field>
        <field name="arch" type="xml">
            <search string="成本计划">
                <field name="project_id"/>
                <field name="name"/>
                <field name="version_code"/>
                <field name="boq_version_id"/>
                <filter string="当前发布" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="待编制" name="draft" domain="[('state', 'in', ('draft', 'adjusting'))]"/>
                <group expand="0" string="分组">
                    <filter string="项目" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="状态" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_cost_plan" model="ir.actions.act_window">
        <field name="name">成本计划</field>
        <field name="res_model">project.cost.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_project_cost_plan_search"/>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_cost_read'))]"/>
    </record>
</odoo>
