<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Final P1 primary-center runtime overlay. Product policy is the selection authority. -->
    <data>
        <record id="menu_sc_workspace_center" model="ir.ui.menu"><field name="name">工作台</field><field name="sequence">10</field><field name="active">True</field></record>
        <record id="menu_sc_project_center" model="ir.ui.menu"><field name="name">项目中心</field><field name="sequence">20</field><field name="active">True</field></record>
        <record id="menu_sc_contract_center" model="ir.ui.menu"><field name="name">合同中心</field><field name="sequence">30</field><field name="active">True</field></record>
        <record id="menu_sc_cost_center" model="ir.ui.menu"><field name="name">成本中心</field><field name="sequence">40</field><field name="active">True</field></record>
        <record id="menu_sc_finance_center" model="ir.ui.menu"><field name="name">财务中心</field><field name="sequence">50</field><field name="active">True</field></record>
        <record id="menu_sc_tax_center" model="ir.ui.menu"><field name="name">税务中心</field><field name="sequence">60</field><field name="active">True</field></record>
        <record id="menu_sc_accounting_center" model="ir.ui.menu">
            <field name="name">会计账务中心</field>
            <field name="parent_id" ref="smart_construction_core.menu_sc_root"/>
            <field name="sequence">70</field>
            <field name="action" eval="False"/>
            <field name="active">True</field>
            <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_accounting_read')])]"/>
        </record>
        <record id="menu_sc_data_center" model="ir.ui.menu"><field name="name">报表中心</field><field name="sequence">80</field><field name="active">True</field></record>
        <record id="menu_sc_hr_admin_center" model="ir.ui.menu"><field name="name">行政中心</field><field name="sequence">90</field><field name="active">True</field></record>
        <record id="menu_sc_business_config_center" model="ir.ui.menu"><field name="name">产品配置</field><field name="sequence">100</field><field name="active">True</field></record>

        <record id="menu_sc_config_center" model="ir.ui.menu">
            <field name="name">系统管理（内部）</field>
            <field name="sequence">990</field>
        </record>
    </data>
</odoo>
