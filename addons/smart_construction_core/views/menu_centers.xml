<odoo>
    <!-- Stable XMLID predeclarations. Later files own the single menuitem
         declaration and refine these records in manifest order. -->
    <record id="menu_sc_project_center" model="ir.ui.menu">
        <field name="name">项目管理</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">10</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_read')])]"/>
    </record>
    <record id="menu_sc_contract_center" model="ir.ui.menu">
        <field name="name">合同管理</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">20</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_initiator'), ref('smart_construction_core.group_sc_cap_contract_user'), ref('smart_construction_core.group_sc_cap_contract_manager'), ref('smart_construction_core.group_sc_cap_purchase_manager')])]"/>
    </record>
    <record id="menu_sc_cost_center" model="ir.ui.menu">
        <field name="name">成本管理</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">25</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_cost_user'), ref('smart_construction_core.group_sc_cap_cost_manager')])]"/>
    </record>
    <record id="menu_sc_material_center" model="ir.ui.menu">
        <field name="name">物资与分包</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">30</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_initiator'), ref('smart_construction_core.group_sc_cap_material_read'), ref('smart_construction_core.group_sc_cap_material_user'), ref('smart_construction_core.group_sc_cap_material_manager')])]"/>
    </record>
    <record id="menu_sc_data_center" model="ir.ui.menu">
        <field name="name">报表中心</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">60</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_data_read'), ref('smart_construction_core.group_sc_cap_cost_read'), ref('smart_construction_core.group_sc_cap_cost_user'), ref('smart_construction_core.group_sc_cap_cost_manager'), ref('smart_construction_core.group_sc_cap_finance_read'), ref('smart_construction_core.group_sc_cap_finance_user'), ref('smart_construction_core.group_sc_cap_finance_manager')])]"/>
    </record>
    <record id="menu_sc_business_config_center" model="ir.ui.menu">
        <field name="name">配置中心</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">85</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_config_admin')])]"/>
    </record>
    <menuitem id="menu_sc_business_base_config_group"
              name="业务基础数据"
              parent="menu_sc_business_config_center"
              sequence="10"
              groups="smart_construction_core.group_sc_cap_business_config_admin"/>
    <menuitem id="menu_sc_lowcode_system_config_group"
              name="低代码系统配置"
              parent="menu_sc_business_config_center"
              sequence="20"
              groups="smart_construction_core.group_sc_cap_business_config_admin,smart_core.group_smart_core_business_config_admin,smart_core.group_smart_core_admin"/>
    <record id="menu_sc_config_center" model="ir.ui.menu">
        <field name="name">系统配置</field><field name="parent_id" ref="menu_sc_root"/><field name="sequence">95</field>
        <field name="groups_id" eval="[(6, 0, [ref('smart_core.group_smart_core_admin')])]"/>
    </record>
</odoo>
