<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sc_labor_worker_search" model="ir.ui.view"><field name="name">sc.labor.worker.search</field><field name="model">sc.labor.worker</field><field name="arch" type="xml"><search string="劳务实名制"><field name="name"/><field name="id_number"/><field name="project_id"/><field name="contractor_id"/><field name="labor_team"/><field name="trade"/><filter name="active_worker" string="在场" domain="[('state','=','active')]"/><filter name="group_project" string="按项目" context="{'group_by':'project_id'}"/><filter name="group_contractor" string="按劳务单位" context="{'group_by':'contractor_id'}"/><filter name="group_team" string="按班组" context="{'group_by':'labor_team'}"/><filter name="group_state" string="按状态" context="{'group_by':'state'}"/></search></field></record>
  <record id="view_sc_labor_worker_tree" model="ir.ui.view"><field name="name">sc.labor.worker.tree</field><field name="model">sc.labor.worker</field><field name="arch" type="xml"><tree string="劳务实名制" default_order="project_id, labor_team, name" decoration-muted="state == 'exited'"><field name="project_id"/><field name="name"/><field name="id_type"/><field name="id_number"/><field name="phone"/><field name="contractor_id"/><field name="labor_team"/><field name="trade"/><field name="entry_date"/><field name="exit_date"/><field name="state"/><field name="processing_advisory" optional="hide"/></tree></field></record>
  <record id="view_sc_labor_worker_form" model="ir.ui.view"><field name="name">sc.labor.worker.form</field><field name="model">sc.labor.worker</field><field name="arch" type="xml"><form string="劳务实名人员"><header><button name="action_activate" type="object" string="办理进场" class="btn-primary" invisible="state != 'draft'"/><button name="action_exit" type="object" string="办理退场" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,exited"/></header><sheet><group><group><field name="project_id"/><field name="name"/><field name="gender"/><field name="id_type"/><field name="id_number"/><field name="phone"/></group><group><field name="contractor_id"/><field name="labor_team"/><field name="trade"/><field name="entry_date"/><field name="exit_date" readonly="1"/></group></group><group string="应急联系"><field name="emergency_contact"/><field name="emergency_phone"/></group><group string="资料与说明"><field name="attachment_ids" widget="many2many_binary"/><field name="note"/></group><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></sheet><chatter/></form></field></record>

  <record id="view_sc_labor_deduction_search" model="ir.ui.view"><field name="name">sc.labor.deduction.search</field><field name="model">sc.labor.deduction</field><field name="arch" type="xml"><search string="劳务扣款明细"><field name="name"/><field name="project_id"/><field name="contractor_id"/><field name="labor_team"/><field name="worker_id"/><field name="reason"/><filter name="confirmed" string="已确认" domain="[('state','=','confirmed')]"/><filter name="group_project" string="按项目" context="{'group_by':'project_id'}"/><filter name="group_contractor" string="按劳务单位" context="{'group_by':'contractor_id'}"/><filter name="group_type" string="按扣款类型" context="{'group_by':'deduction_type'}"/></search></field></record>
  <record id="view_sc_labor_deduction_tree" model="ir.ui.view"><field name="name">sc.labor.deduction.tree</field><field name="model">sc.labor.deduction</field><field name="arch" type="xml"><tree string="劳务扣款明细" default_order="deduction_date desc, id desc" decoration-muted="state == 'cancelled'"><field name="deduction_date"/><field name="name"/><field name="project_id"/><field name="contractor_id"/><field name="labor_team"/><field name="worker_id"/><field name="deduction_type"/><field name="reason"/><field name="amount" sum="扣款合计"/><field name="state"/><field name="processing_advisory" optional="hide"/></tree></field></record>
  <record id="view_sc_labor_deduction_form" model="ir.ui.view"><field name="name">sc.labor.deduction.form</field><field name="model">sc.labor.deduction</field><field name="arch" type="xml"><form string="劳务扣款"><header><button name="action_confirm" type="object" string="确认扣款" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="取消" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/></header><sheet><group><group><field name="name" readonly="1"/><field name="project_id"/><field name="deduction_date"/><field name="deduction_type"/><field name="reason"/></group><group><field name="contractor_id"/><field name="labor_team"/><field name="worker_id" domain="[('project_id','=',project_id)]"/><field name="usage_id" domain="[('project_id','=',project_id)]"/><field name="amount"/><field name="currency_id" invisible="1"/></group></group><group string="依据与说明"><field name="attachment_ids" widget="many2many_binary"/><field name="note"/></group><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></sheet><chatter/></form></field></record>

  <record id="view_sc_labor_usage_product_advisory_form" model="ir.ui.view"><field name="name">sc.labor.usage.product.advisory.form</field><field name="model">sc.labor.usage</field><field name="inherit_id" ref="smart_construction_core.view_sc_labor_usage_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="after"><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></xpath></field></record>
  <record id="view_sc_labor_usage_product_advisory_tree" model="ir.ui.view"><field name="name">sc.labor.usage.product.advisory.tree</field><field name="model">sc.labor.usage</field><field name="inherit_id" ref="smart_construction_core.view_sc_labor_usage_tree"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="before"><field name="processing_advisory" optional="hide"/></xpath></field></record>
</odoo>
