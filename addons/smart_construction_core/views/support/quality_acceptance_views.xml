<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sc_quality_acceptance_search" model="ir.ui.view"><field name="name">sc.quality.acceptance.search</field><field name="model">sc.quality.acceptance</field><field name="arch" type="xml"><search string="质量验收"><field name="name"/><field name="project_id"/><field name="location"/><field name="responsible_id"/><filter name="draft" string="草稿" domain="[('state','=','draft')]"/><filter name="group_project" string="按项目" context="{'group_by':'project_id'}"/><filter name="group_type" string="按验收类型" context="{'group_by':'acceptance_type'}"/><filter name="group_result" string="按结论" context="{'group_by':'result'}"/></search></field></record>
  <record id="view_sc_quality_acceptance_tree" model="ir.ui.view"><field name="name">sc.quality.acceptance.tree</field><field name="model">sc.quality.acceptance</field><field name="arch" type="xml"><tree string="质量验收" default_order="acceptance_date desc, id desc" decoration-success="result == 'passed'" decoration-danger="result == 'failed'"><field name="acceptance_date"/><field name="project_id"/><field name="acceptance_type"/><field name="name"/><field name="location"/><field name="responsible_id"/><field name="result"/><field name="state"/><field name="processing_advisory" optional="hide"/></tree></field></record>
  <record id="view_sc_quality_acceptance_form" model="ir.ui.view"><field name="name">sc.quality.acceptance.form</field><field name="model">sc.quality.acceptance</field><field name="arch" type="xml"><form string="质量验收"><header><button name="action_confirm" type="object" string="确认验收" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="取消" invisible="state == 'cancelled'"/><button name="action_reset_draft" type="object" string="重置草稿" invisible="state != 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/></header><sheet><group><group><field name="project_id"/><field name="name"/><field name="acceptance_type"/><field name="acceptance_date"/><field name="location"/></group><group><field name="responsible_id"/><field name="participant_ids" widget="many2many_tags"/><field name="result"/><field name="rectification_deadline" invisible="result not in ['conditional','failed']"/></group></group><group string="验收依据与意见"><field name="standard"/><field name="conclusion"/></group><group string="问题与资料"><field name="issue_ids" widget="many2many_tags"/><field name="attachment_ids" widget="many2many_binary"/></group><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></sheet><chatter/></form></field></record>
</odoo>
