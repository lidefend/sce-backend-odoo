<odoo>
    <record id="view_work_breakdown_tree" model="ir.ui.view">
        <field name="name">construction.work.breakdown.tree</field>
        <field name="model">construction.work.breakdown</field>
        <field name="arch" type="xml">
            <tree string="成本 WBS" js_class="smart_hierarchy_browser" default_order="project_id, parent_path, sequence">
                <field name="project_id" column_invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="level_type"/>
                <field name="source_type" optional="hide"/>
                <field name="placement_mode" optional="show"/>
                <field name="boq_version_id" optional="hide"/>
                <field name="parent_id" column_invisible="1"/>
                <field name="boq_quantity_total"/>
                <field name="boq_amount_total"/>
            </tree>
        </field>
    </record>

    <record id="view_work_breakdown_form" model="ir.ui.view">
        <field name="name">construction.work.breakdown.form</field>
        <field name="model">construction.work.breakdown</field>
        <field name="arch" type="xml">
            <form string="成本 WBS">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" required="1" domain="[]"/>
                            <field name="company_id" invisible="1"/>
                            <field name="level_type" required="1"/>
                            <field name="source_type" readonly="source_type == 'boq'"/>
                            <field name="placement_mode" readonly="source_type != 'boq'"/>
                            <field name="boq_version_id" readonly="1" invisible="source_type != 'boq'"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                    <group>
                        <field name="code"/>
                        <field name="name" required="1"/>
                        <field name="boq_quantity_total" readonly="1"/>
                        <field name="boq_amount_total" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="下级节点">
                        <field name="child_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="level_type"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="清单">
                            <field name="boq_line_ids">
                                <tree string="关联BOQ" editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="spec"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price"/>
                                    <field name="amount"/>
                                    <field name="task_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="任务">
                            <field name="task_ids" context="{'default_work_id': context.get('active_id')}">
                                <tree string="关联任务">
                                    <field name="name"/>
                                    <field name="boq_quantity_total"/>
                                    <field name="boq_amount_total"/>
                                    <field name="stage_id"/>
                                    <field name="user_ids"/>
                                </tree>
                            </field>
                        </page>
                        <page string="执行范围">
                            <field name="execution_scope_ids" readonly="1">
                                <tree>
                                    <field name="contract_section_id"/>
                                    <field name="location_id"/>
                                    <field name="boq_line_count"/>
                                    <field name="allocated_quantity"/>
                                    <field name="allocated_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_work_breakdown_search" model="ir.ui.view">
        <field name="name">construction.work.breakdown.search</field>
        <field name="model">construction.work.breakdown</field>
        <field name="arch" type="xml">
            <search string="成本 WBS">
                <field name="project_id"/>
                <field name="level_type"/>
                <field name="parent_id"/>
                <field name="source_type"/>
                <field name="boq_version_id"/>
                <group expand="1" string="分组">
                    <filter string="按项目" name="group_project" context="{'group_by':'project_id'}"/>
                    <filter string="按层级" name="group_level" context="{'group_by':'level_type'}"/>
                    <filter string="按上级" name="group_parent" context="{'group_by':'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_work_breakdown" model="ir.actions.act_window">
        <field name="name">成本 WBS</field>
        <field name="res_model">construction.work.breakdown</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_work_breakdown_tree"/>
        <field name="search_view_id" ref="view_work_breakdown_search"/>
        <!-- 使用空 context，避免菜单进入时报 active_id 未定义；项目按钮会覆写 context -->
        <field name="context" eval="{
            'hierarchy_levels': [
                {'field': 'project_id', 'code_field': 'code', 'label_field': 'name'},
                {
                    'field': 'parent_id',
                    'code_field': 'code',
                    'label_field': 'name',
                    'parent_field': 'project_id',
                    'self_parent_field': 'parent_id',
                    'domain_operator': 'child_of',
                },
            ],
        }"/>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_cost_user')), (4, ref('smart_construction_core.group_sc_cap_cost_manager'))]"/>
    </record>
</odoo>
