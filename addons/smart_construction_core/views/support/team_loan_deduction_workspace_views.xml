<odoo>
    <record id="view_sc_team_loan_deduction_workspace_form" model="ir.ui.view">
        <field name="name">sc.team.loan.deduction.workspace.form</field>
        <field name="model">sc.team.loan.deduction.workspace</field>
        <field name="arch" type="xml">
            <form string="班组借/扣款登记">
                <header>
                    <button name="action_register_loan" type="object" string="登记借款" class="btn-primary" invisible="not project_id or not partner_id"/>
                    <button name="action_register_deduction" type="object" string="登记扣款" class="btn-secondary" invisible="not project_id or not partner_id"/>
                    <button name="action_view_account" type="object" string="查看借扣款台账" class="btn-secondary" invisible="not project_id or not partner_id"/>
                </header>
                <sheet>
                    <group name="team_loan_processing_context" data-sc-anchor="team_loan_processing_context" string="办理上下文" col="2">
                        <field name="project_id"/>
                        <field name="partner_id"/>
                        <field name="business_date"/>
                    </group>
                    <group name="team_loan_processing_note" data-sc-anchor="team_loan_processing_note" string="办理说明" col="1">
                        <field name="note" placeholder="可补充本次借款或扣款的业务背景；具体金额和明细在正式单据中填写。"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not processing_advisory">
                        <field name="processing_advisory" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
