<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sc_office_asset_search" model="ir.ui.view"><field name="name">sc.office.asset.search</field><field name="model">sc.office.asset</field><field name="arch" type="xml"><search string="办公资产"><field name="asset_code"/><field name="name"/><field name="category"/><field name="department_id"/><field name="custodian_id"/><field name="status"/><filter name="available" string="闲置可用" domain="[('status', '=', 'available')]"/><filter name="in_use" string="领用中" domain="[('status', '=', 'in_use')]"/><filter name="group_category" string="按类别" context="{'group_by': 'category'}"/><filter name="group_department" string="按部门" context="{'group_by': 'department_id'}"/><filter name="group_status" string="按状态" context="{'group_by': 'status'}"/></search></field></record>
  <record id="view_sc_office_asset_tree" model="ir.ui.view"><field name="name">sc.office.asset.tree</field><field name="model">sc.office.asset</field><field name="arch" type="xml"><tree string="办公资产"><field name="asset_code"/><field name="name"/><field name="category"/><field name="specification"/><field name="serial_no" optional="hide"/><field name="department_id"/><field name="custodian_id"/><field name="location"/><field name="purchase_value" sum="资产原值合计"/><field name="status"/><field name="active" optional="hide"/></tree></field></record>
  <!-- U-C4 G11: 885 办公资产（menu 707 / action `action_sc_product_office_asset_v1`）的原生承载。
       三个业务分组带稳定 `data-sc-anchor`，消费方按它生成本入口的业务章节与章节导航。
       本批退役入口发布 `office_asset_form_v1` 的结构 body，结构权威回到本视图；
       `status` 由状态条承载，业务按钮由 header 持有。
       「备注」「附件」在原生 arch 上是 notebook 页面（kind=page），不是业务分组，故不设章节锚点。 -->
  <record id="view_sc_office_asset_form" model="ir.ui.view">
    <field name="name">sc.office.asset.form</field>
    <field name="model">sc.office.asset</field>
    <field name="arch" type="xml">
      <form string="办公资产">
        <header>
          <button name="action_assign" type="object" string="确认领用" class="btn-primary" invisible="status not in ['available', 'maintenance']"/>
          <button name="action_return" type="object" string="归还" invisible="status != 'in_use'"/>
          <button name="action_maintenance" type="object" string="送修" invisible="status in ['maintenance', 'retired']"/>
          <button name="action_retire" type="object" string="报废" invisible="status == 'retired'"/>
          <field name="status" widget="statusbar" statusbar_visible="available,in_use,maintenance,retired"/>
        </header>
        <sheet>
          <group>
            <group name="sc_office_asset_identity" data-sc-anchor="sc_office_asset_identity" string="资产信息">
              <field name="asset_code"/><field name="name"/><field name="category"/><field name="specification"/><field name="serial_no"/><field name="company_id"/>
            </group>
            <group name="sc_office_asset_usage" data-sc-anchor="sc_office_asset_usage" string="使用信息">
              <field name="department_id"/><field name="custodian_id"/><field name="location"/><field name="active"/>
            </group>
          </group>
          <group>
            <group name="sc_office_asset_purchase" data-sc-anchor="sc_office_asset_purchase" string="购置信息">
              <field name="purchase_date"/><field name="purchase_value"/><field name="currency_id"/>
            </group>
          </group>
          <notebook>
            <page string="备注"><field name="note"/></page>
            <page string="附件"><field name="attachment_ids" widget="many2many_binary"/></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
</odoo>
