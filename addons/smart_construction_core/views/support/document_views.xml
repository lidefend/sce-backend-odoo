<odoo>
    <!-- 工程资料列表 -->
    <record id="view_sc_project_document_tree" model="ir.ui.view">
        <field name="name">sc.project.document.tree</field>
        <field name="model">sc.project.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_id"/>
                <field name="document_kind"/>
                <field name="wbs_id"/>
                <field name="doc_type_id"/>
                <field name="doc_subtype_id"/>
                <field name="is_mandatory"/>
                <field name="responsible_id"/>
                <field name="date_doc"/>
                <field name="state"/>
                <field name="attachment_count"/>
            </tree>
        </field>
    </record>

    <!-- 工程资料表单 -->
    <record id="view_sc_project_document_form" model="ir.ui.view">
        <field name="name">sc.project.document.form</field>
        <field name="model">sc.project.document</field>
        <field name="arch" type="xml">
            <form string="工程资料">

                <header>
                    <!-- 提交审核：仅 draft 显示 -->
                    <button name="action_submit" type="object" string="提交审批"
                        class="oe_highlight"
                        modifiers='{"invisible":[["state","!=","draft"]]}'/>

                    <!-- 归档：draft 或 review 显示 -->
                    <button name="action_approve" type="object" string="归档"
                        modifiers='{"invisible":[["state","not in",["draft","review"]]]}'/>

                    <!-- 作废：cancel 隐藏 -->
                    <button name="action_cancel" type="object" string="作废"
                        modifiers='{"invisible":[["state","=","cancel"]]}'/>

                    <!-- 重置为草稿：draft 隐藏 -->
                    <button name="action_reset_to_draft" type="object" string="重置为草稿"
                        modifiers='{"invisible":[["state","=","draft"]]}'/>

                    <!-- 状态条 -->
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,review,done,cancel"/>
                </header>

                <sheet>
                    <!-- U-C4 G10: 原生 arch 持有本入口的章节身份。三个业务组带稳定
                         `data-sc-anchor`，消费方按它生成本入口的业务章节与章节导航；
                         `view_sc_project_document_form` 是 597 工程资料
                         （menu 412 / action `action_sc_project_document`）的原生承载。
                         本入口此前没有入口级发布，只消费模型级生成镜像 104
                         （`sc_project_document_form_structure_generated_v1`，priority 142），
                         结构权威停在空串；本批按 G07／G09 写法为它补一条入口级 native 发布
                         （`sc_project_document_productized_form_v1`，priority 800，纯语义声明），
                         入口自己的声明成为该 action 的最后结构写入者。
                         字段级只读口径由原生承接：`attachment_count`／`company_id` 原生
                         `readonly="1"`，`state` 由状态条承载。
                         模型级镜像 104 本批保持 active：它是同模型上 598／599／600／601
                         （安全资料／质量资料／自检资料／归档备案）唯一的结构载体，退役属另一组的工作。 -->
                    <group name="project_document_main" data-sc-anchor="project_document_main" string="资料主信息">
                        <field name="name"/>
                        <field name="document_kind"/>
                        <field name="project_id" required="1"/>
                        <field name="wbs_id"/>
                        <field name="task_id"/>
                        <field name="contract_id"/>
                    </group>

                    <group name="project_document_classification" data-sc-anchor="project_document_classification" string="业务分类">
                        <field name="doc_type_id" required="1"/>
                        <field name="doc_subtype_id"/>
                        <field name="is_mandatory"/>
                        <field name="date_doc"/>
                        <field name="version"/>
                    </group>

                    <group name="project_document_responsibility" data-sc-anchor="project_document_responsibility" string="责任与归档">
                        <field name="responsible_id"/>
                        <field name="attachment_count" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="说明">
                            <field name="note"/>
                        </page>

                        <page string="附件">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- 工程资料动作 -->
    <record id="action_sc_project_document" model="ir.actions.act_window">
        <field name="name">工程资料</field>
        <field name="res_model">sc.project.document</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
    <record id="action_sc_project_document_safety" model="ir.actions.act_window">
        <field name="name">安全资料</field>
        <field name="res_model">sc.project.document</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('document_kind', '=', 'safety')]</field>
        <field name="context">{'default_document_kind': 'safety'}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
    <record id="action_sc_project_document_quality" model="ir.actions.act_window">
        <field name="name">质量资料</field>
        <field name="res_model">sc.project.document</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('document_kind', '=', 'quality')]</field>
        <field name="context">{'default_document_kind': 'quality'}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
    <record id="action_sc_project_document_self_inspection" model="ir.actions.act_window">
        <field name="name">自检资料</field>
        <field name="res_model">sc.project.document</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('document_kind', '=', 'self_inspection')]</field>
        <field name="context">{'default_document_kind': 'self_inspection'}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
    <record id="action_sc_project_document_archive" model="ir.actions.act_window">
        <field name="name">归档备案</field>
        <field name="res_model">sc.project.document</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('document_kind', '=', 'archive')]</field>
        <field name="context">{'default_document_kind': 'archive'}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
</odoo>
