<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sc_site_variation_search" model="ir.ui.view">
    <field name="name">sc.site.variation.search</field><field name="model">sc.site.variation</field>
    <field name="arch" type="xml"><search string="签证变更"><field name="name"/><field name="subject"/><field name="project_id"/><field name="contract_id"/><field name="event_type"/><field name="variation_scope"/><filter name="active_process" string="办理中" domain="[('state','in',['draft','submitted'])]"/><filter name="group_project" string="按项目" context="{'group_by':'project_id'}"/><filter name="group_contract" string="按合同" context="{'group_by':'contract_id'}"/><filter name="group_type" string="按类型" context="{'group_by':'event_type'}"/><filter name="group_scope" string="按费用归属" context="{'group_by':'variation_scope'}"/><filter name="group_state" string="按状态" context="{'group_by':'state'}"/></search></field>
  </record>
  <record id="view_sc_site_variation_tree" model="ir.ui.view">
    <field name="name">sc.site.variation.tree</field><field name="model">sc.site.variation</field>
    <field name="arch" type="xml"><tree string="签证变更" default_order="event_date desc, id desc" decoration-success="state == 'confirmed'" decoration-muted="state in ['rejected','cancelled']"><field name="event_date"/><field name="name"/><field name="project_id"/><field name="contract_id"/><field name="variation_scope"/><field name="event_type"/><field name="subject"/><field name="location"/><field name="estimated_amount_delta" sum="预计价款影响"/><field name="estimated_duration_days"/><field name="state"/><field name="processing_advisory" optional="hide"/></tree></field>
  </record>
  <record id="view_sc_site_variation_form" model="ir.ui.view">
    <field name="name">sc.site.variation.form</field><field name="model">sc.site.variation</field>
    <field name="arch" type="xml"><form string="工程签证与现场变更"><header><button name="action_submit" type="object" string="提交确认" class="btn-primary" invisible="state != 'draft'" groups="smart_construction_core.group_sc_cap_project_user,smart_construction_core.group_sc_cap_project_manager"/><button name="action_confirm" type="object" string="确认签证" class="btn-primary" invisible="state != 'submitted'" groups="smart_construction_core.group_sc_cap_project_manager"/><button name="action_reject" type="object" string="驳回" invisible="state != 'submitted'" groups="smart_construction_core.group_sc_cap_project_manager"/><button name="action_create_contract_change" type="object" string="形成合同变更" invisible="state != 'confirmed' or not contract_id" groups="smart_construction_core.group_sc_cap_contract_user,smart_construction_core.group_sc_cap_contract_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed,rejected,cancelled"/></header><sheet><group><group><field name="name" readonly="1"/><field name="project_id"/><field name="contract_id"/><field name="variation_scope"/><field name="event_type"/><field name="subject"/></group><group><field name="event_date"/><field name="location"/><field name="responsible_id"/><field name="estimated_amount_delta"/><field name="currency_id" invisible="1"/><field name="estimated_duration_days"/></group></group><group string="现场事实"><field name="cause"/><field name="description"/><field name="quantity_impact"/></group><group string="确认与依据"><field name="signer_ids" widget="many2many_tags"/><field name="attachment_ids" widget="many2many_binary"/><field name="contract_change_ids" readonly="1"/></group><group string="生效审计"><field name="sc_change_revision" readonly="1"/><field name="sc_change_effective_at" readonly="1"/><field name="sc_change_effective_by" readonly="1"/></group><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></sheet><chatter/></form></field>
  </record>
  <record id="action_sc_site_variation" model="ir.actions.act_window"><field name="name">签证变更</field><field name="res_model">sc.site.variation</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_sc_site_variation_search"/><field name="context">{'search_default_group_project': 1}</field><field name="groups_id" eval="[(6,0,[ref('smart_construction_core.group_sc_cap_project_read')])]"/></record>

  <record id="view_sc_contract_change_search" model="ir.ui.view"><field name="name">sc.contract.change.search</field><field name="model">sc.contract.change</field><field name="arch" type="xml"><search string="合同变更"><field name="name"/><field name="subject"/><field name="contract_id"/><field name="project_id"/><field name="partner_id"/><filter name="active_process" string="办理中" domain="[('state','in',['draft','submitted'])]"/><filter name="group_contract" string="按合同" context="{'group_by':'contract_id'}"/><filter name="group_project" string="按项目" context="{'group_by':'project_id'}"/><filter name="group_type" string="按类型" context="{'group_by':'change_type'}"/><filter name="group_state" string="按状态" context="{'group_by':'state'}"/></search></field></record>
  <record id="view_sc_contract_change_tree" model="ir.ui.view"><field name="name">sc.contract.change.tree</field><field name="model">sc.contract.change</field><field name="arch" type="xml"><tree string="合同变更" default_order="change_date desc, id desc" decoration-success="state == 'effective'" decoration-muted="state in ['rejected','cancelled']"><field name="change_date"/><field name="name"/><field name="contract_id"/><field name="project_id"/><field name="partner_id"/><field name="change_type"/><field name="subject"/><field name="amount_delta" sum="价款增减合计"/><field name="duration_delta_days"/><field name="source_site_variation_id"/><field name="state"/><field name="processing_advisory" optional="hide"/></tree></field></record>
  <record id="view_sc_contract_change_form" model="ir.ui.view"><field name="name">sc.contract.change.form</field><field name="model">sc.contract.change</field><field name="arch" type="xml"><form string="合同变更"><header><button name="action_submit" type="object" string="提交生效" class="btn-primary" invisible="state != 'draft'" groups="smart_construction_core.group_sc_cap_contract_user,smart_construction_core.group_sc_cap_contract_manager"/><button name="action_effective" type="object" string="确认生效" class="btn-primary" invisible="state != 'submitted'" groups="smart_construction_core.group_sc_cap_contract_manager"/><button name="action_reject" type="object" string="驳回" invisible="state != 'submitted'" groups="smart_construction_core.group_sc_cap_contract_manager"/><button name="action_create_settlement_adjustment" type="object" string="形成结算调整" invisible="state != 'effective' or amount_delta == 0" groups="smart_construction_core.group_sc_cap_settlement_user,smart_construction_core.group_sc_cap_settlement_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,effective,rejected,cancelled"/></header><sheet><group><group><field name="name" readonly="1"/><field name="contract_id"/><field name="project_id" readonly="1"/><field name="partner_id" readonly="1"/><field name="source_site_variation_id" readonly="1"/></group><group><field name="change_date"/><field name="change_type"/><field name="subject"/><field name="amount_delta"/><field name="currency_id" invisible="1"/><field name="duration_delta_days"/></group></group><group string="变更内容"><field name="reason"/><field name="before_summary"/><field name="after_summary"/></group><group string="依据与下游"><field name="attachment_ids" widget="many2many_binary"/><field name="settlement_adjustment_ids" readonly="1"/></group><group string="生效审计"><field name="sc_change_revision" readonly="1"/><field name="sc_change_effective_at" readonly="1"/><field name="sc_change_effective_by" readonly="1"/></group><group string="办理提示"><field name="processing_advisory" readonly="1" nolabel="1"/></group></sheet><chatter/></form></field></record>
  <record id="action_sc_contract_change" model="ir.actions.act_window"><field name="name">合同变更</field><field name="res_model">sc.contract.change</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_sc_contract_change_search"/><field name="context">{'search_default_group_contract': 1}</field><field name="groups_id" eval="[(6,0,[ref('smart_construction_core.group_sc_cap_contract_read')])]"/></record>

  <record id="view_sc_settlement_adjustment_change_lineage_form" model="ir.ui.view"><field name="name">sc.settlement.adjustment.change.lineage.form</field><field name="model">sc.settlement.adjustment</field><field name="inherit_id" ref="smart_construction_core.view_sc_settlement_adjustment_form"/><field name="arch" type="xml"><xpath expr="//field[@name='contract_id']" position="after"><field name="contract_change_id" readonly="1"/><field name="source_site_variation_id" readonly="1"/></xpath></field></record>
</odoo>
