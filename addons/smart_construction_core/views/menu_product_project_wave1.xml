            <field name="name">项目创建</field>
            <field name="parent_id" ref="smart_construction_core.menu_sc_project_center"/>
            <field name="sequence">10</field>
            <field name="active">True</field>
        </record>
        <menuitem id="menu_sc_project_partner_group_wave1"
