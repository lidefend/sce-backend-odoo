      <field name="view_id" ref="smart_construction_core.view_sc_team_loan_deduction_workspace_form"/><field name="target">current</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_user'), ref('smart_construction_core.group_sc_cap_project_manager')])]"/>
    </record>
    <record id="action_sc_product_general_contract_settlement_v1" model="ir.actions.act_window">
      <field name="name">日常合同结算</field><field name="res_model">sc.settlement.order</field><field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="smart_construction_core.view_sc_settlement_order_search"/>
      <field name="domain">[('contract_source_kind', '=', 'general_contract')]</field>
      <field name="context">{'default_contract_source_kind': 'general_contract', 'search_default_general_contract_source': 1, 'search_default_group_project': 1}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_contract_user'), ref('smart_construction_core.group_sc_cap_contract_manager')])]"/>
    </record>
    <record id="action_sc_product_current_account_v1" model="ir.actions.act_window">
      <field name="name">往来款登记</field><field name="res_model">sc.current.account.workspace</field><field name="view_mode">form</field>
      <field name="view_id" ref="smart_construction_core.view_sc_current_account_workspace_form"/><field name="target">current</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_finance_user'), ref('smart_construction_core.group_sc_cap_finance_manager')])]"/>
    </record>
    <record id="action_sc_product_company_project_refund_v1" model="ir.actions.act_window">
      <field name="name">公司&amp;项目退款</field><field name="res_model">sc.expense.claim</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_finance_user'), ref('smart_construction_core.group_sc_cap_finance_manager')])]"/>
    </record>
    <record id="action_sc_product_project_tax_deduction_v1" model="ir.actions.act_window">
      <field name="name">项目专项抵扣</field><field name="res_model">sc.tax.deduction.registration</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_finance_user'), ref('smart_construction_core.group_sc_cap_finance_manager')])]"/>
    </record>
    <record id="action_sc_product_tax_filing_v1" model="ir.actions.act_window">
      <field name="name">税务申报</field><field name="res_model">sc.invoice.registration</field><field name="view_mode">tree,form</field>
      <field name="context">{'create': False}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_finance_manager')])]"/>
    </record>
    <record id="action_sc_product_tax_report_v1" model="ir.actions.act_window">
      <field name="name">税务报表</field><field name="res_model">sc.invoice.registration</field><field name="view_mode">pivot,graph,tree</field>
      <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_data_read')])]"/>
    </record>
    <record id="action_sc_product_labor_subcontract_report_v1" model="ir.actions.act_window">
      <field name="name">劳务分包报表</field><field name="res_model">sc.labor.usage</field><field name="view_mode">pivot,graph,tree</field>
      <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_data_read')])]"/>
    </record>
    <record id="action_sc_product_job_management_v1" model="ir.actions.act_window">
      <field name="name">岗位管理</field><field name="res_model">hr.job</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_config_admin')])]"/>
    </record>
    <record id="action_sc_product_social_fund_v1" model="ir.actions.act_window">
      <field name="name">社保公积</field><field name="res_model">sc.hr.payroll.document</field><field name="view_mode">tree,form</field>
      <field name="domain">[('fact_type', 'in', ['social_person_registration', 'social_registration'])]</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_config_admin')])]"/>
    </record>
    <record id="action_sc_product_office_asset_v1" model="ir.actions.act_window">
      <field name="name">办公资产</field><field name="res_model">sc.office.admin.document</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_business_config_admin')])]"/>
    </record>
    <record id="action_sc_product_data_permission_v1" model="ir.actions.act_window">
      <field name="name">数据权限</field><field name="res_model">ui.business.config.contract</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_config_admin')])]"/>
    </record>
    <record id="action_sc_product_system_parameter_v1" model="ir.actions.act_window">
      <field name="name">系统参数</field><field name="res_model">ui.business.config.contract</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_config_admin')])]"/>
    </record>
    <record id="action_sc_product_numbering_rule_v1" model="ir.actions.act_window">
      <field name="name">编码规则</field><field name="res_model">ui.business.config.contract</field><field name="view_mode">tree,form</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_config_admin')])]"/>
    </record>

    <!-- Project lifecycle is a backend state machine rendered by generic views. -->
    <record id="view_sc_product_project_lifecycle_tree_v1" model="ir.ui.view">
      <field name="name">project.project.lifecycle.tree.product.v1</field>
      <field name="model">project.project</field>
      <field name="arch" type="xml">
        <tree string="项目启停管理" create="false" delete="false"
              decoration-muted="lifecycle_state == 'closed'"
              decoration-warning="lifecycle_state == 'paused'"
              decoration-success="lifecycle_state == 'in_progress'">
          <field name="project_code"/>
          <field name="name"/>
          <field name="manager_id"/>
          <field name="start_date"/>
          <field name="end_date"/>
          <field name="lifecycle_state" widget="badge"/>
          <field name="active"/>
        </tree>
      </field>
    </record>
    <record id="view_sc_product_project_lifecycle_form_v1" model="ir.ui.view">
      <field name="name">project.project.lifecycle.form.product.v1</field>
      <field name="model">project.project</field>
      <field name="arch" type="xml">
        <form string="项目启停管理" create="false" delete="false">
          <header>
            <button name="action_sc_submit" type="object" string="启动项目" class="btn-primary"
                    groups="smart_construction_core.group_sc_cap_project_user,smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state != 'draft'"/>
            <button name="action_sc_pause" type="object" string="暂停项目"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state != 'in_progress'"/>
            <button name="action_sc_resume" type="object" string="恢复项目" class="btn-primary"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state != 'paused'"/>
            <button name="action_sc_mark_done" type="object" string="标记竣工"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state != 'in_progress'"/>
            <button name="action_sc_begin_closing" type="object" string="进入结算"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state not in ['in_progress', 'done']"/>
            <button name="action_sc_start_warranty" type="object" string="进入保修期"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state not in ['done', 'closing']"/>
            <button name="action_sc_close" type="object" string="关闭项目" confirm="关闭后不可恢复，确定继续吗？"
                    groups="smart_construction_core.group_sc_cap_project_manager"
                    invisible="lifecycle_state == 'closed'"/>
            <field name="lifecycle_state" widget="statusbar" readonly="1"
                   statusbar_visible="draft,in_progress,paused,done,closing,warranty,closed"/>
          </header>
          <sheet>
            <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
            <group>
              <group string="项目标识">
                <field name="project_code" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="manager_id" readonly="1"/>
                <field name="active" readonly="1"/>
                <field name="lifecycle_advisory" readonly="1"/>
              </group>
              <group string="计划信息">
                <field name="initiation_date" readonly="1"/>
                <field name="start_date" readonly="1"/>
                <field name="end_date" readonly="1"/>
                <field name="location" readonly="1"/>
              </group>
            </group>
            <div class="alert alert-info" role="status">
              状态变更由后端项目状态机校验；资料与清单完整性只作提示，未完结结算或付款等会导致业务无法继续的冲突才会阻断关闭。
            </div>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="action_sc_product_project_lifecycle_tree_v1" model="ir.actions.act_window.view">
      <field name="sequence">10</field><field name="view_mode">tree</field>
      <field name="view_id" ref="smart_construction_core.view_sc_product_project_lifecycle_tree_v1"/>
      <field name="act_window_id" ref="smart_construction_core.action_sc_product_project_lifecycle_v1"/>
    </record>
    <record id="action_sc_product_project_lifecycle_form_v1" model="ir.actions.act_window.view">
      <field name="sequence">20</field><field name="view_mode">form</field>
      <field name="view_id" ref="smart_construction_core.view_sc_product_project_lifecycle_form_v1"/>
      <field name="act_window_id" ref="smart_construction_core.action_sc_product_project_lifecycle_v1"/>
    </record>

    <record id="view_sc_product_partner_blacklist_search_v1" model="ir.ui.view">
      <field name="name">res.partner.blacklist.search.product.v1</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <search string="客商黑名单">
          <field name="name"/><field name="vat"/><field name="sc_blacklist_reason"/>
          <filter string="已列入" name="blacklisted" domain="[('sc_blacklisted', '=', True)]"/>
          <filter string="限制合作" name="restricted" domain="[('sc_blacklist_level', '=', 'restricted')]"/>
          <filter string="停止合作" name="blocked" domain="[('sc_blacklist_level', '=', 'blocked')]"/>
          <group expand="0" string="分组">
            <filter string="风险级别" name="group_level" context="{'group_by': 'sc_blacklist_level'}"/>
          </group>
        </search>
      </field>
    </record>
    <record id="view_sc_product_partner_blacklist_tree_v1" model="ir.ui.view">
      <field name="name">res.partner.blacklist.tree.product.v1</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <tree string="客商黑名单" create="false" delete="false" decoration-danger="sc_blacklist_level == 'blocked'">
          <field name="name"/><field name="vat"/><field name="sc_blacklist_level" widget="badge"/>
          <field name="sc_blacklist_reason"/><field name="sc_blacklist_review_date"/>
          <field name="sc_blacklisted_by"/><field name="sc_blacklisted_at"/>
        </tree>
      </field>
    </record>
    <record id="view_sc_product_partner_blacklist_form_v1" model="ir.ui.view">
      <field name="name">res.partner.blacklist.form.product.v1</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <form string="客商黑名单" create="false" delete="false">
          <header>
            <button name="action_sc_add_blacklist" type="object" string="列入黑名单" class="btn-primary"
                    groups="smart_construction_core.group_sc_cap_contact_manager" invisible="sc_blacklisted"/>
            <button name="action_sc_remove_blacklist" type="object" string="移出黑名单"
                    groups="smart_construction_core.group_sc_cap_contact_manager" invisible="not sc_blacklisted"/>
          </header>
          <sheet>
            <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
            <group>
              <group string="客商信息"><field name="vat" readonly="1"/><field name="phone" readonly="1"/><field name="email" readonly="1"/></group>
              <group string="黑名单治理">
                <field name="sc_blacklisted" readonly="1"/><field name="sc_blacklist_level"/>
                <field name="sc_blacklist_review_date"/><field name="sc_blacklisted_by" readonly="1"/><field name="sc_blacklisted_at" readonly="1"/>
              </group>
            </group>
            <group><field name="sc_blacklist_reason"/><field name="sc_blacklist_advisory" readonly="1"/></group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
    <record id="action_sc_product_partner_blacklist_v1" model="ir.actions.act_window">
      <field name="search_view_id" ref="smart_construction_core.view_sc_product_partner_blacklist_search_v1"/>
    </record>
    <record id="action_sc_product_partner_blacklist_tree_v1" model="ir.actions.act_window.view">
      <field name="sequence">10</field><field name="view_mode">tree</field><field name="view_id" ref="smart_construction_core.view_sc_product_partner_blacklist_tree_v1"/><field name="act_window_id" ref="smart_construction_core.action_sc_product_partner_blacklist_v1"/>
    </record>
    <record id="action_sc_product_partner_blacklist_form_v1" model="ir.actions.act_window.view">
      <field name="sequence">20</field><field name="view_mode">form</field><field name="view_id" ref="smart_construction_core.view_sc_product_partner_blacklist_form_v1"/><field name="act_window_id" ref="smart_construction_core.action_sc_product_partner_blacklist_v1"/>
    </record>

    <!-- Workbench completion. -->
    <menuitem id="menu_sc_product_message_notification_v1" name="消息通知" parent="smart_construction_core.menu_sc_workspace_center" action="smart_construction_core.action_sc_product_message_notification_v1" sequence="40" groups="smart_construction_core.group_sc_cap_project_read"/>

    <!-- Project center is the sole center allowed to expose level three. -->
    <record id="menu_sc_project_management_group" model="ir.ui.menu"><field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_read')])]"/></record>
    <record id="menu_sc_project_partner_group_wave1" model="ir.ui.menu"><field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_read')])]"/></record>
    <record id="menu_sc_tender_management_group" model="ir.ui.menu"><field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_read')])]"/></record>
