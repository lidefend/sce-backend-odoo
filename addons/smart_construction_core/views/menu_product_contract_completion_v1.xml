<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Locked complete product-menu surface.

    This file deliberately separates navigation availability from capability
    maturity.  Every menu from product_menu_contract_v1.json exists here, while
    later capability waves may refine an action without changing its menu XMLID
    or path.  Only SC capability groups are used at the product boundary.
  -->
  <data>
    <!-- Action adapters for contracted pages which do not yet own a dedicated action. -->
    <record id="action_sc_product_message_notification_v1" model="ir.actions.act_window">
      <field name="name">消息通知</field><field name="res_model">mail.activity</field><field name="view_mode">tree,form</field>
      <field name="domain">[('user_id', '=', uid)]</field><field name="context">{'create': False}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_read')])]"/>
    </record>
    <record id="action_sc_product_project_edit_v1" model="ir.actions.act_window">
      <field name="name">项目信息编辑</field><field name="res_model">project.project</field><field name="view_mode">tree,form</field>
      <field name="context">{'create': False, 'active_test': True}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_user'), ref('smart_construction_core.group_sc_cap_project_manager')])]"/>
    </record>
    <record id="action_sc_product_project_lifecycle_v1" model="ir.actions.act_window">
      <field name="name">项目启停管理</field><field name="res_model">project.project</field><field name="view_mode">tree,form</field>
      <field name="context">{'active_test': False, 'create': False, 'delete': False, 'sc_project_lifecycle_management': True}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_project_manager')])]"/>
    </record>
    <record id="action_sc_product_partner_blacklist_v1" model="ir.actions.act_window">
      <field name="name">客商黑名单</field><field name="res_model">res.partner</field><field name="view_mode">tree,form</field>
      <field name="domain">[]</field><field name="context">{'create': False, 'search_default_blacklisted': 1}</field>
      <field name="groups_id" eval="[(6, 0, [ref('smart_construction_core.group_sc_cap_contact_manager')])]"/>
    </record>
    <record id="action_sc_product_tender_information_v1" model="ir.actions.act_window">
      <field name="name">招标信息</field><field name="res_model">tender.opportunity</field><field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="smart_construction_core.view_tender_opportunity_search"/>
