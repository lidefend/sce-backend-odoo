        <record id="menu_sc_business_config_center" model="ir.ui.menu">
            <field name="name">产品配置</field>
            <field name="sequence">100</field>
        </record>
        <record id="menu_sc_business_base_config_group" model="ir.ui.menu"><field name="active">False</field></record>
        <record id="menu_sc_lowcode_system_config_group" model="ir.ui.menu"><field name="active">False</field></record>
        <record id="menu_sc_workflow_runtime_root" model="ir.ui.menu"><field name="active">False</field></record>
