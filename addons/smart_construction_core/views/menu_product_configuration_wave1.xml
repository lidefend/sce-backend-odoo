        <record id="menu_ui_form_field_policy_business_config" model="ir.ui.menu">
            <field name="name">字段管理</field>
            <field name="parent_id" ref="smart_construction_core.menu_sc_business_config_center"/>
            <field name="sequence">30</field>
            <field name="active">True</field>
        </record>
    </data>
