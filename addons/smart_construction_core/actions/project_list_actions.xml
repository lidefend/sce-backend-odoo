<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sc_project_list" model="ir.actions.act_window">
        <field name="name">项目台账</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[]</field>
        <!-- The ledger entry is a list+form handling surface, not a creation
             surface (creation is owned by 新项目立项 / action_project_initiation).
             Its read-only intent is declared here on the entry contract so the
             presentation form (project.edit_project) stays capability-neutral
             and no capability is owned by a dedicated read-only page. -->
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'no_duplicate': True}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
</odoo>
