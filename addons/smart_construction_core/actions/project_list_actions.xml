<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sc_project_list" model="ir.actions.act_window">
        <field name="name">项目台账</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[]</field>
        <!-- 项目台账 is the single project record entry: it owns both the ledger
             list and the master-data record form. Creation stays denied because
             it is owned by 新项目立项 / action_project_initiation; record
             maintenance is not hard-denied here so it follows the entry's
             permission contract, group-gated fields and ACL instead of a
             dedicated read-only page. -->
        <field name="context">{'create': False, 'delete': False, 'no_duplicate': True}</field>
        <field name="groups_id" eval="[(4, ref('smart_construction_core.group_sc_cap_project_read'))]"/>
    </record>
</odoo>
