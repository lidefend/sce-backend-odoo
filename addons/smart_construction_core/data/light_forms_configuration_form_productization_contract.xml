<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">
    <!-- U-C4 G11: 轻表单与管理配置整组中原先**没有入口级发布**的入口，本批补齐同族形状的
         入口发布，使它的结构权威落在原生主表单上。

           727 流程审批配置 / menu 424 / action `action_sc_approval_policy` -> view 1887 `view_sc_approval_policy_form`

         本入口此前只消费模型级生成镜像 52（`sc_approval_policy_form_structure_generated_v1`
         priority 84，`action_id` 为空），于是结构权威解析停在 `""`，`ui_contract_v2` 走
         "兼容地板"路径。补一条入口级 native 声明后，入口自己的声明成为该 action 的最后结构
         写入者（priority 800 > 84），解析口径与外层一致：
         `form_structure_authority=native_authority` → `layoutPolicy=container_tree_authority`，
         通用治理投影关闭，字段位置与可见性由原生视图持有。

         形状与 G07 为 858 补发布、G09 为 871 补发布、G10 为 597／527 补发布的写法一致：只有
         `title` ＋ `composition_mode: native_semantic_surface` ＋ `context` 语义声明，不含任何
         结构键，因此 `structural_form_declarations()` 对其返回空，不会再生出
         `LEGACY_STRUCTURE_KEY_OVERRIDE`。

         保留边界：模型级生成镜像 52 本批**保持 active**——在没有 action 上下文的面上它仍是
         `sc.approval.policy` 唯一的结构载体，退役属另一组的工作。原生 arch 已按
         `data-sc-anchor` 承接本入口的章节身份（业务规则／系统承载）。

         回滚：`git revert`（纯声明，无数据迁移）。 -->
    <record id="business_config_contract_sc_approval_policy_productized_form_v1" model="ui.business.config.contract">
        <field name="name">sc_approval_policy_productized_form_v1</field>
        <field name="model">sc.approval.policy</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_approval_policy"/>
        <field name="priority">800</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'},
                'views': {
                    'form': {
                        'title': '流程审批配置',
                        'composition_mode': 'native_semantic_surface'
                    }
                }
            }
        }"/>
    </record>
</odoo>
