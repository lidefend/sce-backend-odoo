<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- U-C4 G11: 885 办公资产（menu 707 / action `action_sc_product_office_asset_v1`
       / view 1908 `view_sc_office_asset_form`）的入口发布退役结构 body。

       本批把 `office_asset_form_v1` 的**结构**body（sections／columns／actions 与带
       sequence／group_title 的 fields 行）退役，只保留 `title` 与
       `composition_mode: native_semantic_surface`，`view_orchestration.context` 原样保留。

       退役 body 里的**字段级只读口径**不回退：`status` 在原生 arch 上由状态条承载、无只读声明
       （模型面 `readonly=False`），因此以**稀疏语义覆盖**（`fields` 只带 `name` ＋ `readonly`）
       把它继续钉在只读。这类只读行不含结构键，`structural_form_declarations()` 判其为语义注解
       而非结构声明，故不产生 `NATIVE_SEMANTIC_SURFACE_STRUCTURE_CONFLICT`。
       入口声明因此成为该 action 的最后结构写入者，解析口径为
       `form_structure_authority=native_authority` → `layoutPolicy=container_tree_authority`，
       字段位置／分组／可见性由原生 arch 持有。渲染字段集不变（16 个）；「备注」「附件」在原生
       arch 上是 notebook 页面而非业务分组，故不设章节锚点。

       本模型上只有这一条 active 载体，priority 800 已是最高；本模型只有 885 一个 action。

       回滚：`git revert`（纯声明改动，无数据迁移）。 -->
  <record id="business_config_contract_office_asset_form_v1" model="ui.business.config.contract">
    <field name="name">office_asset_form_v1</field>
    <field name="model">sc.office.asset</field>
    <field name="view_type">form</field>
    <field name="action_id" ref="smart_construction_core.action_sc_product_office_asset_v1"/>
    <field name="priority">800</field>
    <field name="company_id" eval="False"/>
    <field name="active" eval="True"/>
    <field name="status">published</field>
    <field name="version_no">1</field>
    <field name="contract_json" eval="{'view_orchestration': {'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release', 'asset_authority': 'sc.office.asset', 'custodian_authority': 'hr.employee'}, 'views': {'form': {'title': '办公资产', 'composition_mode': 'native_semantic_surface', 'fields': [{'name': 'status', 'readonly': True}]}}}}"/>
  </record>
</odoo>
