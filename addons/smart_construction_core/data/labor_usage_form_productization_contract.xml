            <field name="contract_json" eval="{'view_orchestration': {'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'}, 'views': {'form': {'title': '方单', 'composition_mode': 'native_semantic_surface'}}}}"/>
        </record>
        <record id="business_config_contract_labor_usage_casual_productized_form_v1" model="ui.business.config.contract">
            <field name="name">labor_usage_casual_productized_form_v1</field>
