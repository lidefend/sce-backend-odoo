            <field name="contract_json" eval="{'view_orchestration': {'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'}, 'views': {'form': {'title': '零星用工', 'composition_mode': 'native_semantic_surface'}}}}"/>
        </record>
    </data>
