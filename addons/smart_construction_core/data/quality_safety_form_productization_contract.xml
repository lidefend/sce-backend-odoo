<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- U-C4 G10: 工程过程与资料整组原生结构迁移（安全检查／质量验收 两项）。

         两个入口各自只有一张原生主表单：
           682 安全检查 / menu 526 / action `action_sc_safety_issue`  -> view 1741 `view_sc_safety_issue_form`
           867 质量验收 / menu 686 / action `action_sc_product_quality_acceptance_v1`
                                                                     -> view 1550 `view_sc_quality_acceptance_form`

         原生 arch 已经呈现这两个入口的全部业务事实（安全检查：两组概览 ＋ 问题描述／问题附件／
         检查照片／隐患信息 四个 notebook 页；质量验收：两组概览 ＋ 验收依据与意见／问题与资料／
         办理提示 三组）。本批把结构权威一次性交给原生 arch：入口契约只保留 `title` 与
         `composition_mode: native_semantic_surface`，退役 body 副本（sections／fields／columns）。
         `view_orchestration.context` 的语义声明原样保留（安全检查含 `workflow_authority`），
         不手工递增 `version_no`（U-C3／G07／G09 先例）。

         优先级保持 900：该值已高于本模型上唯一的模型级载体（115 安全检查生成镜像 priority 154），
         提交后入口发布即成为最后结构写入者，结构权威与运行时一致。

         字段级只读口径随 body 退役一并交给原生 arch 承接：安全检查的 `closed_date`／
         `overdue_days`／`is_overdue` 原生已 `readonly="1"`，`state` 由状态条承载；质量验收的
         `processing_advisory` 原生已 `readonly="1"`。退役后 `field_names` 只剩模型级载体声明的
         部分（867 上没有任何模型级载体，故为空），这是 native authority 的既定语义——
         `ui_contract_v2` 在 `native_authority` 下显式关闭通用治理投影，字段位置与可见性由
         原生视图持有（同 G09 口径）。

         回滚：`git revert`（纯声明改动，无数据迁移）。

         注：模型级生成镜像 115 `sc_safety_issue_form_structure_generated_v1` 本批**保留 active**；
         它是 `sc.safety.issue` 唯一声明稀疏字段序的载体，退役属结构变更之外的事项。 -->
    <record id="action_sc_safety_issue_form_view_v1" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="smart_construction_core.view_sc_safety_issue_form"/>
        <field name="act_window_id" ref="smart_construction_core.action_sc_safety_issue"/>
    </record>

    <record id="action_sc_product_quality_acceptance_form_view_v1" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="smart_construction_core.view_sc_quality_acceptance_form"/>
        <field name="act_window_id" ref="smart_construction_core.action_sc_product_quality_acceptance_v1"/>
    </record>

    <record id="business_config_contract_sc_safety_issue_handling_form_v1" model="ui.business.config.contract">
        <field name="name">sc_safety_issue_handling_form_v1</field>
        <field name="model">sc.safety.issue</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_safety_issue"/>
        <field name="view_id" ref="smart_construction_core.view_sc_safety_issue_form"/>
        <field name="priority">900</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {
                    'source': 'smart_construction_core.product_release',
                    'source_status': 'product_release',
                    'workflow_authority': 'sc.safety.issue'
                },
                'views': {
                    'form': {
                        'title': '安全问题办理',
                        'composition_mode': 'native_semantic_surface'
                    }
                }
            }
        }"/>
    </record>

    <record id="business_config_contract_sc_quality_acceptance_handling_form_v1" model="ui.business.config.contract">
        <field name="name">sc_quality_acceptance_handling_form_v1</field>
        <field name="model">sc.quality.acceptance</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_product_quality_acceptance_v1"/>
        <field name="view_id" ref="smart_construction_core.view_sc_quality_acceptance_form"/>
        <field name="priority">900</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {
                    'source': 'smart_construction_core.product_release',
                    'source_status': 'product_release',
                    'workflow_authority': 'sc.quality.acceptance'
                },
                'views': {
                    'form': {
                        'title': '质量验收办理',
                        'composition_mode': 'native_semantic_surface'
                    }
                }
            }
        }"/>
    </record>
</odoo>
