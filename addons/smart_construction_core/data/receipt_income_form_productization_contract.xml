<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- U-C4 G03: 收款登记 / 公司收入 entries share model sc.receipt.income and the
             native form view view_sc_receipt_income_form (1644).  The rebuilt native
             arch owns the structure, so each released configuration keeps only its
             entry title and declares itself a sparse annotation over that native
             tree.  Field lists and sections were the configuration-owned duplicate
             of the arch and are removed here; the fields, their storage, their list
             columns and their API consumers are untouched. -->
        <record id="business_config_contract_receipt_income_productized_form_v1" model="ui.business.config.contract">
            <field name="name">receipt_income_productized_form_v1</field>
            <field name="model">sc.receipt.income</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_receipt_income"/>
            <field name="priority">700</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '收款登记',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }"/>
        </record>

        <record id="business_config_contract_receipt_income_project_productized_form_v1" model="ui.business.config.contract">
            <field name="name">receipt_income_project_productized_form_v1</field>
            <field name="model">sc.receipt.income</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_receipt_income_user_income"/>
            <field name="priority">700</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '收入',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }"/>
        </record>

        <!-- Bypass entry action 807 (工程进度款收入登记) consumes the same native form
             view and keeps its own action context defaults; only the duplicated
             configuration body is dropped. -->
        <record id="business_config_contract_receipt_income_engineering_progress_productized_form_v1" model="ui.business.config.contract">
            <field name="name">receipt_income_engineering_progress_productized_form_v1</field>
            <field name="model">sc.receipt.income</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_receipt_income_engineering_progress"/>
            <field name="priority">700</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '工程进度款收入登记',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }"/>
        </record>
    </data>
    <!-- U-C4 G03: redundant model-wide generated mirror (noupdate origin); precise
         ORM retirement, same pattern as the U-C3 document mirror and the U-C4 G02
         invoice mirror.  The rebuilt native form view 1644 owns the structure. -->
    <function model="ui.business.config.contract" name="write">
        <value eval="[ref('smart_construction_core.business_config_contract_sc_receipt_income_form_structure_generated')]"/>
        <value eval="{'active': False}"/>
    </function>
</odoo>
