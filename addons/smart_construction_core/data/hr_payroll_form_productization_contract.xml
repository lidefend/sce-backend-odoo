<odoo>
    <data noupdate="0">
        <!-- U-C4 G07: 工资社保与发放 (actions 873 / 884 / 858 / 874 and the five
             archived entries 660 / 661 / 662 / 663 / 664) share model
             sc.hr.payroll.document and the native form view
             smart_construction_core.view_sc_hr_payroll_document_form, while 874
             consumes sc.hr.salary.payment and
             smart_construction_core.view_sc_hr_salary_payment_form.

             Every one of these entries used to carry its own section/field body
             (`entry_semantic_surface`), so the same native tree was projected
             eight different ways and the sibling action 858 had no release at
             all and fell back to the model-wide sparse policy.  The native arch
             now owns the structure for the whole group: it carries the fact
             groups keyed on `fact_type` (社保 / 工资 / 公积金 / 补助/奖金), the
             provenance facts only the retired bodies declared
             (`legacy_document_no` / `legacy_document_state` /
             `legacy_source_table` / `legacy_source_id`) and stable
             `data-sc-anchor` identities, and each entry keeps only its entry
             title plus a `native_semantic_surface` declaration.

             The repeated field names in the native tree are NOT duplicates: the
             same fact appears once per `fact_type` group so each entry's create
             surface is self-contained, and exactly one group is visible for a
             given `fact_type`.  They are kept.

             `action 858` (工资薪酬 / menu 673) is an ACTIVE formal entry whose
             menu had no entry-level release; it therefore consumed the
             model-wide `sc_hr_payroll_document_form_structure_generated_v1`
             plane and rendered the generic workspace floorplan instead of the
             business task surface its siblings rendered.  It gets the entry
             release it was missing here, in the same shape as its siblings.

             The model-wide `sc_hr_payroll_document_form_structure_generated_v1`
             (id 79) is a sparse field-order annotation, exactly like
             `sc_expense_claim_form_structure_generated_v1` in G05, and keeps
             serving the model; it is not modified.

             Rollback: `git revert` this batch.  No data migration is involved —
             the retired bodies were presentation copies and the native arch
             already carried every fact they presented apart from the four
             provenance fields added above. -->
        <record id="business_config_contract_project_payroll_productized_form_v1" model="ui.business.config.contract">
            <field name="name">project_payroll_productized_form_v1</field>
            <field name="model">sc.hr.payroll.document</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_product_project_payroll_v1"/>
            <field name="priority">800</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'},
                    'views': {'form': {
                        'title': '薪资核算清单',
                        'composition_mode': 'native_semantic_surface'
                    }}
                }
            }"/>
        </record>

