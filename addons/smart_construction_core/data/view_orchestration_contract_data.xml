<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <function model="ir.model.data" name="write">
        <function model="ir.model.data" name="search">
            <value eval="[('module', '=', 'smart_construction_core'), ('name', '=', 'business_config_contract_income_contract_form_structure')]"/>
        </function>
        <value eval="{'noupdate': False}"/>
    </function>
    <!-- Product-owned semantic opt-in; install and upgrade retire field order ownership. -->
    <record id="business_config_contract_income_contract_form_structure" model="ui.business.config.contract">
        <field name="name">income_contract_form_structure_v1</field>
        <field name="model">construction.contract.income</field>
        <field name="view_type">form</field>
        <field name="priority">20</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">2</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'},
                'views': {'form': {'composition_mode': 'native_semantic_surface'}}
            }
        }"/>
    </record>
    <record id="business_config_contract_expense_contract_native_form" model="ui.business.config.contract">
        <field name="name">expense_contract_native_form_v1</field>
        <field name="model">construction.contract.expense</field>
        <field name="view_type">form</field>
        <field name="priority">20</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'},
                'views': {'form': {'composition_mode': 'native_semantic_surface'}}
            }
        }"/>
    </record>
</odoo>
