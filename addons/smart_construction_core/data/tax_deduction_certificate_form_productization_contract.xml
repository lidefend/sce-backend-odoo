<odoo>
    <data noupdate="0">
        <!-- U-C4 G06: 抵扣登记 (action 790) and 项目专项抵扣 (action 879) share
             model sc.tax.deduction.registration and the native form view
             smart_construction_core.view_sc_tax_deduction_registration_form.
             The rebuilt native arch owns the structure, so each entry keeps
             only its entry title and declares itself a sparse annotation over
             the native tree; the section and field projections of 790 and 879
             were the configuration-owned duplicate of the arch and are removed
             here.

             Every fact the retired bodies presented still renders once.  The
             arch gained the facts only they declared that the native body did
             not carry (`company_id`, `partner_name`,
             `deduction_bill_attachment_text`, `message_attachment_count`, the
             provenance facts `legacy_source_model` / `legacy_source_table` /
             `legacy_record_id` / `legacy_document_state`, and the mixin facts
             `source_created_by` / `source_created_at` on the 迁移来源 page) and
             now states the same read-only restrictions the retired bodies
             declared for `state`, `business_category_id`, `source_origin` and
             `currency_id`.  `withholding_amount` was presented twice by the
             authority body and stays presented once, in the amount section
             where the retired body had it, so retiring a body cannot double a
             fact either.

             The model-wide contracts
             `sc_tax_deduction_registration_form_sections_v1`,
             `sc_tax_deduction_registration_p1_form_business_facts_v1` and
             `sc_tax_deduction_registration_form_structure_generated_v1` keep
             serving their other consumers (action 852 扣款单, whose entry has no
             release of its own) and are not modified. -->
        <record id="business_config_contract_tax_deduction_registration_productized_form_v1" model="ui.business.config.contract">
            <field name="name">tax_deduction_registration_productized_form_v1</field>
            <field name="model">sc.tax.deduction.registration</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_tax_deduction_registration_user" />
            <field name="priority">700</field>
            <field name="company_id" eval="False" />
            <field name="active" eval="True" />
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '抵扣登记',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }" />
        </record>
    </data>
</odoo>
