<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- U-C4 G08: 上下文办理工作台整组迁移。  sc.company.project.refund.workspace consumes the shared-shape
         dispatch workspace body: this entry keeps its title and its semantic
         declaration and drops its section/field body, because the native form
         `view_sc_company_project_refund_workspace_form` already presents the same facts (办理上下文 →
         project_id / partner_id / business_date / processing_advisory, 办理说明 →
         note) and the same action carriers in its header.

         `fact_authority` (dispatch_only), `fact_models` and `projection_authority` are the entry's semantic declaration, not a second structure: it
         stays verbatim in `view_orchestration.context` (same rule as G06's
         contract 177 and G07's 884). -->
    <record id="business_config_contract_company_project_refund_workspace_form_v1" model="ui.business.config.contract">
        <field name="name">company_project_refund_workspace_form_v1</field>
        <field name="model">sc.company.project.refund.workspace</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_product_company_project_refund_v1"/>
        <field name="priority">800</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release', 'fact_authority': 'dispatch_only', 'fact_models': ['sc.expense.claim', 'sc.self.funding.registration'], 'projection_authority': 'sc.finance.project.counterparty.position'},
                'views': {'form': {
                    'title': '公司&amp;项目退款',
                    'composition_mode': 'native_semantic_surface'
                }}
            }
        }"/>
    </record>
</odoo>
