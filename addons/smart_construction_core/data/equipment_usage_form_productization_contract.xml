<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- U-C4 G09: 用量与履约登记整组原生结构迁移（sc.equipment.usage）。

         两个正式入口共享原生主表单 `view_sc_equipment_usage_form`（库内 view 1476）：
           570 机械台班登记 / menus 692＋509 / action `action_sc_equipment_usage`
           851 机械台班记录 / menu 510      / action `action_sc_equipment_usage_shift_user_confirmed`

         两个入口的 body 副本同形（各 6 章、同一字段集合），原生 arch 已按
         `state != 'draft'` 的只读口径呈现同一批设备／使用／计价事实，并把说明、附件、办理提示
         收进 notebook。本批把结构权威一次性交给原生 arch：两条入口契约只保留 `title` 与
         `composition_mode: native_semantic_surface`，退役 sections／fields／columns 副本；
         `view_orchestration.context` 原样保留，不手工递增 `version_no`（U-C3／G07 先例）。

         570 被两个菜单指向（692 项目中心/机械成本、509 项目中心/材料成本/机械设备），
         851 另持 menu 510；退役结构副本必须同时覆盖这三条到达路径。

         优先级：入口级发布由 `50` 提为 `800`。本组的入口发布原先排在模型级载体
         （sections 20／p1 facts 88／生成镜像 104-165）之前，导致结构权威解析的最后一个写入者
         是模型级 `entry_semantic_surface` 声明，与运行时实际生效的 native 权威不一致（G02 进项
         700、G07 工资 700-800 两族即按"入口发布排最后"写成）。提为 800 后入口的 native 声明成为
         最后一个结构写入者，两处解析口径一致；入口发布不携带结构键，因此该次序变化不改变呈现。

         回滚：`git revert`（纯声明改动，无数据迁移）。

         注：模型级 `sc_equipment_usage_p1_form_business_facts_v1`（库内 id 21）本批**保留 active**，
         理由同 labor：它是业务事实只读策略的唯一声明载体，退役属策略变更而非结构变更。 -->
    <data noupdate="0">
        <record id="business_config_contract_equipment_usage_shift_productized_form_v1" model="ui.business.config.contract">
            <field name="name">equipment_usage_shift_productized_form_v1</field>
            <field name="model">sc.equipment.usage</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_equipment_usage_shift_user_confirmed"/>
            <field name="priority">800</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{'view_orchestration': {'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'}, 'views': {'form': {'title': '机械台班记录', 'composition_mode': 'native_semantic_surface'}}}}"/>
        </record>

        <record id="business_config_contract_equipment_usage_register_productized_form_v1" model="ui.business.config.contract">
            <field name="name">equipment_usage_register_productized_form_v1</field>
            <field name="model">sc.equipment.usage</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_equipment_usage"/>
            <field name="priority">800</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{'view_orchestration': {'context': {'source': 'smart_construction_core.product_release', 'source_status': 'product_release'}, 'views': {'form': {'title': '设备使用登记', 'composition_mode': 'native_semantic_surface'}}}}"/>
        </record>
    </data>
</odoo>
