<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- U-C4 G07: 社保公积 (action 884) consumes the shared native form
       smart_construction_core.view_sc_hr_payroll_document_form, which now owns
       the structure for the whole 人事薪酬 group.  The entry keeps its title
       and its semantic keys and drops its section/field body: the native arch
       presents the 社保 and 公积金 fact groups (keyed on `fact_type`), the
       period/person facts and the handling facts that the retired body
       regrouped, and nothing the body declared is lost.

       `fact_authority` and `allowed_fact_types` are NOT a second structure.
       They are the entry's semantic declaration: which model is the fact
       authority for this entry and which `fact_type` values belong to it.  They
       are preserved verbatim in `view_orchestration.context` (same rule as
       G06's contract 177). -->
  <record id="business_config_contract_social_fund_form_v1" model="ui.business.config.contract">
    <field name="name">social_fund_form_v1</field>
    <field name="model">sc.hr.payroll.document</field>
    <field name="view_type">form</field>
    <field name="action_id" ref="smart_construction_core.action_sc_product_social_fund_v1"/>
    <field name="priority">800</field>
    <field name="company_id" eval="False"/>
    <field name="active" eval="True"/>
    <field name="status">published</field>
    <field name="version_no">1</field>
    <field name="contract_json" eval="{
      'view_orchestration': {
        'context': {
          'source': 'smart_construction_core.product_release',
          'source_status': 'product_release',
          'fact_authority': 'sc.hr.payroll.document',
          'allowed_fact_types': ['social_person_registration', 'social_registration', 'provident_fund_registration']
        },
        'views': {'form': {
          'title': '社保公积',
          'composition_mode': 'native_semantic_surface'
        }}
      }
    }"/>
  </record>
</odoo>
