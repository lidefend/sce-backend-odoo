<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- U-C4 G06: 项目专项抵扣 (action 879) shares model
         sc.tax.deduction.registration and the native form view
         smart_construction_core.view_sc_tax_deduction_registration_form with
         抵扣登记 (action 790).  The rebuilt native arch owns the structure, so
         this entry keeps only its entry title: the section and field
         projections it declared were the configuration-owned duplicate of the
         arch and are removed here.

         The entry keeps its semantic context (fact authority, deduction scope
         authority and projection authorities) because that context is what
         tells the mechanism this entry resolves the `project_special` slice of
         the same model; it is not a second structure.  The read-only facts the
         retired body declared (`state`, `deduction_scope`,
         `business_category_id`, `source_origin`, `currency_id`,
         `operation_strategy`, `partner_name`, `company_id`,
         `deduction_flow_label`, `name`, `tax_rate_text`) are now stated on the
         native arch, with `business_category_id` restricted by
         `deduction_scope` so this scope stays read-only while 抵扣登记 keeps
         its editable category. -->
    <record id="business_config_contract_project_special_tax_deduction_form_v1" model="ui.business.config.contract">
        <field name="name">project_special_tax_deduction_form_v1</field>
        <field name="model">sc.tax.deduction.registration</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_product_project_tax_deduction_v1"/>
        <field name="priority">800</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {
                    'source': 'smart_construction_core.product_release',
                    'source_status': 'product_release',
                    'fact_authority': 'sc.tax.deduction.registration',
                    'deduction_scope_authority': 'project_special',
                    'projection_authorities': ['sc.finance.business.fact', 'sc.finance.business.project.summary', 'sc.finance.project.capital.position']
                },
                'views': {'form': {
                    'title': '项目专项抵扣',
                    'composition_mode': 'native_semantic_surface'
                }}
            }
        }"/>
    </record>
</odoo>
