<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- U-C4 G15: 税务申报 (880 / menu 702 `menu_sc_product_tax_filing_v1` / action
         `action_sc_product_tax_filing_v1` / view 1659 `view_sc_tax_filing_form`)
         退役入口级结构声明 —— 沿用 G13 对 876 的原地退役形状（同名 record、
         `priority=800` 与 `action_id` 保持不变、只退役结构键）。

         G15 之前本入口的 `form_structure_authority` 解析为 `entry_semantic_surface`、
         `layoutPolicy=overview_then_task_slots`：结构权威来自这份入口契约的 4 个 sections
         （22 字段）＋ `columns: 2` ＋ 5 条 `actions`，交付面走兼容重排路径。契约声明的
         章节标题与原生 arch 并不一致（契约「来源与治理」vs arch「治理信息」；契约 22 字段
         vs arch 交付 21 个字段节点），即这些声明本就未进入渲染容器树。

         运行库只读 A/B 探针（sc_dev_demo，`SAVEPOINT g15_ab` ＋ `ROLLBACK TO SAVEPOINT`，
         `rollbackResidual.contractsAfterRollback=289` 与 `candidateRowsGone=true` 证明 0 写入）：
         - 两个渲染 profile 的容器树、字段集、`readonly`/`invisible` 修饰符与锚点集合在基线
           与候选之间**逐项相同**（`treeShapes diff: NONE`、`fields diff: NONE`）；
         - 退役后结构权威落到原生视图：`form_structure_authority=native_authority` →
           `layoutPolicy=container_tree_authority`、`mode=native_structured_form`、
           `presentationMode=task`，结构诊断为空；
         - 退役体未声明任何字段级 `readonly`（4 个 sections 的字段行只含 `name`），
           实测**不需要任何稀疏字段覆盖**；
         - 其余差异只落在 **create profile 的兼容平面**：退役前该路由由兼容地板额外发出
           每字段语义平面（52 键）＋ 9 条 surface policy，并额外隐藏 12 个字段；退役后
           create 与 edit 一致（仅 `currency_id` 隐藏），并与平台既有原生入口
           （876／687／522／646／778 实测 `fieldSemantics=0`、`surfacePolicies={}`）逐个对齐。

         退役后结构权威落到原生视图 1659：4 个业务分组（申报信息／治理信息／税额测算／
         说明与附件）、6 个按钮、**0 个 `data-sc-anchor`**、继承扇出 0，兼容重排路径对
         880 关闭。

         保留边界：`view_orchestration.context` 5 键逐值不变、`title` 保留入口标题、
         `priority=800`／`status=published`／`version_no=1` 不变。同模型兄弟入口 187
         `tax_report_list_v1`（action 881 税务报表）自持其入口面，本批不改动；`sc.tax.filing`
         没有模型级生成镜像，因此本批不涉及镜像退役。回滚：`git revert`（纯声明，无数据迁移）。 -->
    <record id="business_config_contract_tax_filing_form_v1" model="ui.business.config.contract">
        <field name="name">tax_filing_form_v1</field>
        <field name="model">sc.tax.filing</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_product_tax_filing_v1"/>
        <field name="priority">800</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {
                    'source': 'smart_construction_core.product_release',
                    'source_status': 'product_release',
                    'filing_authority': 'sc.tax.filing',
                    'invoice_authority': 'sc.invoice.registration',
                    'deduction_authority': 'sc.tax.deduction.registration'
                },
                'views': {
                    'form': {
                        'title': '税务申报',
                        'composition_mode': 'native_semantic_surface'
                    }
                }
            }
        }"/>
    </record>
</odoo>
