            <field name="priority">700</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '公司财务支出',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }"/>
        </record>

        <!-- Bypass entry action 811 (往来单位付款 / menu 561) consumes the same
             native form view and keeps its own action domain and tree; only the
             duplicated configuration body is dropped. -->
        <record id="business_config_contract_payment_execution_partner_payment_productized_form_v1" model="ui.business.config.contract">
