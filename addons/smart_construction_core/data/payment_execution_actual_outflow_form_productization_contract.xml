<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- U-C4 G04: 实付登记 / 公司财务支出 / 往来单位付款 entries share model
             sc.payment.execution and the native form view
             view_sc_payment_execution_form (1647).  The rebuilt native arch owns
             the structure, so each released configuration keeps only its entry
             title and declares itself a sparse annotation over that native tree.
             Field lists and sections were the configuration-owned duplicate of
             the arch and are removed here; the fields, their storage, their list
             columns and their API consumers are untouched. -->
        <record id="business_config_contract_payment_execution_actual_outflow_productized_form_v1" model="ui.business.config.contract">
            <field name="name">payment_execution_actual_outflow_productized_form_v1</field>
            <field name="model">sc.payment.execution</field>
            <field name="view_type">form</field>
            <field name="action_id" ref="smart_construction_core.action_sc_payment_execution_actual_outflow"/>
            <field name="priority">700</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
            <field name="status">published</field>
            <field name="version_no">1</field>
            <field name="contract_json" eval="{
                'view_orchestration': {
                    'context': {
                        'source': 'smart_construction_core.product_release',
                        'source_status': 'product_release'
                    },
                    'views': {
                        'form': {
                            'title': '实付登记',
                            'composition_mode': 'native_semantic_surface'
                        }
                    }
                }
            }"/>
        </record>

        <record id="business_config_contract_payment_execution_company_finance_expense_productized_form_v1" model="ui.business.config.contract">
            <field name="name">payment_execution_company_finance_expense_productized_form_v1</field>
