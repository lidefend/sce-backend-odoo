<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- U-C4 G13: 日常合同结算 (876 / menu 698
         `menu_sc_product_general_contract_settlement_v1` / action
         `action_sc_product_general_contract_settlement_v1` / view 1764
         `view_sc_settlement_order_form`) 退役入口级结构声明。

         G13 之前本入口的 `form_structure_authority` 解析为
         `entry_semantic_surface`、`layoutPolicy=business_config_sections`：
         结构权威来自这份入口契约的 4 个 sections ＋ 30 条 fields 声明，前台走
         "兼容/语义重排"路径，把契约声明的章节标题当作
         `sourceSectionTitles` 投影到页面上。

         运行库只读 A/B 探针（sc_dev_demo，`SAVEPOINT g13_ab` ＋
         `ROLLBACK TO SAVEPOINT`，`rollback_residual` 证明 0 写入）证明：该入口
         **实际渲染**的容器树与字段集完全由原生视图 1764 决定（10 个
         `data-sc-anchor` 业务分组 / 60 个字段节点 / 条件只读与条件隐藏逐条来自
         arch），契约声明的 4 个章节标题从未进入渲染容器树 —— 属"声明但未渲染"。
         因此本批不再为它们补原生章节：原生 arch 已经是地面真值。

         退役后（priority 800 保持为本 action 的最高 active 载体，模型级镜像 122
         已由 `view_orchestration_form_section_contract_data.xml` 的既有 write
         退役为 `active=False`）结构权威落到原生视图：
         `form_structure_authority=native_authority` →
         `layoutPolicy=container_tree_authority`、`mode=native_structured_form`，
         兼容重排路径对 876 关闭。

         字段级只读稀疏覆盖：退役体声明的 17 条 `readonly` 中，实测只有 2 条在
         原生面上真实回退（`currency_id`、`state`：模型面非只读且原生 arch 未复述
         该口径）；其余 15 条由原生 arch 或模型面已经承载，**不重复声明**。
         覆盖行只含 `name` ＋ `readonly`，不含任何结构键，故
         `structural_form_declarations()` 判其为语义注解，A/B 实测 authority 仍为
         `native_authority`、`containerTrees`/`widgetStatus` 差异归零。

         保留边界：`view_orchestration.context` 与原声明逐值相同；`title` 保留入口
         标题。同模型兄弟入口 693（`settlement_order_productized_form_v1`，
         priority 700，自持 9 sections）仍消费它自己的兼容面，属别组计数，本批
         不改动。回滚：`git revert`（纯声明，无数据迁移）。 -->
    <record id="business_config_contract_daily_contract_settlement_form_v1" model="ui.business.config.contract">
        <field name="name">daily_contract_settlement_form_v1</field>
        <field name="model">sc.settlement.order</field>
        <field name="view_type">form</field>
        <field name="action_id" ref="smart_construction_core.action_sc_product_general_contract_settlement_v1"/>
        <field name="priority">800</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="True"/>
        <field name="status">published</field>
        <field name="version_no">1</field>
        <field name="contract_json" eval="{
            'view_orchestration': {
                'context': {
                    'source': 'smart_construction_core.product_release',
                    'source_status': 'product_release',
                    'fact_authority': 'sc.settlement.order',
                    'contract_source_authority': 'sc.general.contract'
                },
                'views': {'form': {
                    'title': '日常合同结算',
                    'composition_mode': 'native_semantic_surface',
                    'fields': [
                        {'name': 'currency_id', 'readonly': True},
                        {'name': 'state', 'readonly': True}
                    ]
                }}
            }
        }"/>
    </record>
</odoo>
