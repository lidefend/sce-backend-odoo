<odoo>
    <record id="view_project_boq_import_wizard_norm_catalog" model="ir.ui.view">
        <field name="name">project.boq.import.wizard.form.norm.catalog</field>
        <field name="model">project.boq.import.wizard</field>
        <field name="inherit_id" ref="smart_construction_core.view_project_boq_import_wizard"/>
        <field name="arch" type="xml">
            <field name="source_type" position="after">
                <field name="norm_catalog_id" options="{'no_create': True}" readonly="state != 'upload'"/>
            </field>
        </field>
    </record>

    <record id="view_project_boq_version_form_norm_catalog" model="ir.ui.view">
        <field name="name">project.boq.version.form.norm.catalog</field>
        <field name="model">project.boq.version</field>
        <field name="inherit_id" ref="smart_construction_core.view_project_boq_version_form"/>
        <field name="arch" type="xml">
            <field name="source_type" position="after">
                <field name="norm_catalog_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_project_boq_analysis_form_norm_reference" model="ir.ui.view">
        <field name="name">project.boq.analysis.form.norm.reference</field>
        <field name="model">project.boq.analysis</field>
        <field name="inherit_id" ref="smart_construction_core.view_project_boq_analysis_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='norm_line_ids']/tree/field[@name='norm_code']" position="after">
                <field name="norm_item_id" optional="show"/>
                <field name="norm_match_state" widget="badge" optional="show"/>
                <field name="norm_match_note" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
