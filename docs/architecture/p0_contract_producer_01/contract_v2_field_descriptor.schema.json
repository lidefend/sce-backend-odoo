{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sce.local/contracts/p0/contract-v2-field-descriptor.v1.schema.json",
  "title": "ContractV2FieldDescriptor v1",
  "description": "Strict semantic descriptor shared by widget-backed and non-widget-backed Page Block business values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fieldCode",
    "label",
    "fieldType",
    "widgetType",
    "semanticType"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "fieldCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "fieldType": {
      "enum": [
        "char",
        "text",
        "html",
        "integer",
        "float",
        "monetary",
        "boolean",
        "date",
        "datetime",
        "selection",
        "many2one",
        "one2many",
        "many2many",
        "binary",
        "json",
        "many2one_reference",
        "reference"
      ]
    },
    "widgetType": {
      "enum": [
        "account_type_selection",
        "input",
        "select",
        "date",
        "datetime",
        "number",
        "table",
        "upload",
        "button",
        "textarea",
        "checkbox",
        "radio",
        "tree",
        "gantt",
        "relation",
        "display",
        "binary",
        "many2many_tags",
        "selection",
        "many2one",
        "many2many",
        "one2many",
        "one2many_list",
        "boolean",
        "boolean_favorite",
        "boolean_toggle",
        "monetary",
        "float_time",
        "percentage",
        "percentpie",
        "statusbar",
        "badge",
        "image",
        "html",
        "text",
        "handle",
        "phone",
        "url",
        "email",
        "json",
        "daterange",
        "analytic_distribution",
        "many2many_binary",
        "many2one_avatar_user",
        "list_activity",
        "res_partner_many2one",
        "field_partner_autocomplete",
        "domain",
        "tier_validation",
        "account-tax-totals-field",
        "payment",
        "statinfo"
      ]
    },
    "semanticType": {
      "enum": [
        "activity_collection",
        "binary",
        "boolean",
        "challenge_status",
        "choice",
        "credential_entry",
        "date",
        "datetime",
        "detail_collection",
        "detail_table",
        "duration",
        "hierarchical_collection",
        "long_text",
        "money",
        "number",
        "one_time_secret",
        "percentage",
        "readable_value",
        "reference",
        "relation",
        "relation_collection",
        "secret_confirmation",
        "status",
        "tag_collection",
        "text",
        "unsupported_native_widget",
        "payment_settlement_detail_collection"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "readonly": {
      "type": "boolean"
    },
    "invisible": {
      "type": "boolean"
    },
    "relation": {
      "type": "string",
      "minLength": 1
    },
    "relationField": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "domain": true,
    "domainExpression": true,
    "context": true,
    "relationEntry": {
      "type": "object",
      "additionalProperties": true
    },
    "relationActiveActions": {
      "$ref": "#/$defs/relationActiveActions"
    },
    "widgetOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "subview": {
      "type": "object",
      "additionalProperties": true
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "surfaceRole": {
      "type": "string",
      "minLength": 1
    },
    "help": {
      "type": "string",
      "minLength": 1
    },
    "uiUsage": {
      "enum": [
        "fact",
        "interaction"
      ]
    },
    "changeDefault": {
      "type": "boolean"
    },
    "definitionRecord": {
      "type": "string",
      "minLength": 1
    },
    "definitionRecordField": {
      "type": "string",
      "minLength": 1
    },
    "groupOperator": {
      "type": "string",
      "minLength": 1
    },
    "searchable": {
      "type": "boolean"
    },
    "sortable": {
      "type": "boolean"
    },
    "store": {
      "type": "boolean"
    },
    "translate": {
      "type": "boolean"
    },
    "trim": {
      "type": "boolean"
    },
    "related": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technical": {
      "type": "boolean"
    },
    "formStructureRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "slot",
        "group"
      ],
      "properties": {
        "role": {
          "enum": [
            "summary",
            "task",
            "context",
            "risk",
            "relation",
            "activity",
            "audit"
          ]
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "digits": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "currencyField": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "percent",
            "duration",
            "count",
            "quantity"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timezoneAuthority"
      ],
      "properties": {
        "kind": {
          "enum": [
            "date",
            "datetime"
          ]
        },
        "timezoneAuthority": {
          "enum": [
            "user",
            "record",
            "not_applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "datetime"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "timezoneAuthority": {
                "enum": [
                  "user",
                  "record"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "date"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "timezoneAuthority": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    },
    "attachmentRole": {
      "type": "string",
      "minLength": 1
    },
    "referenceModelField": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Same-record field declaring the runtime target model for many2one_reference."
    }
  },
  "$defs": {
    "modifierOperator": {
      "enum": [
        "=",
        "==",
        "!=",
        "<>",
        ">",
        ">=",
        "<",
        "<=",
        "in",
        "not in",
        "like",
        "ilike"
      ]
    },
    "modifierValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/modifierExpression"
        }
      ]
    },
    "relationActiveActions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "create": {
          "$ref": "#/$defs/modifierValue"
        },
        "write": {
          "$ref": "#/$defs/modifierValue"
        }
      }
    },
    "contextGetOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key"
      ],
      "properties": {
        "kind": {
          "const": "context_get"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "default": true
      }
    },
    "fieldValueOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "field_value"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "literalOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": true
      }
    },
    "modifierOperand": {
      "oneOf": [
        {
          "$ref": "#/$defs/contextGetOperand"
        },
        {
          "$ref": "#/$defs/fieldValueOperand"
        },
        {
          "$ref": "#/$defs/literalOperand"
        }
      ]
    },
    "modifierExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "static"
            },
            "value": {
              "type": "boolean"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "field_truthy"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "semantics": {
              "const": "python"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field",
            "operator"
          ],
          "properties": {
            "kind": {
              "const": "field_compare"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "$ref": "#/$defs/modifierOperator"
            },
            "semantics": {
              "const": "python"
            },
            "value": true,
            "value_field": {
              "type": "string",
              "minLength": 1
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "value"
              ],
              "not": {
                "required": [
                  "value_field"
                ]
              }
            },
            {
              "required": [
                "value_field"
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expr"
          ],
          "properties": {
            "kind": {
              "const": "not"
            },
            "expr": {
              "$ref": "#/$defs/modifierExpression"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exprs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "exprs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/modifierExpression"
              }
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "semantics",
            "value_expr"
          ],
          "properties": {
            "kind": {
              "const": "value_truthy"
            },
            "semantics": {
              "const": "python"
            },
            "value_expr": {
              "$ref": "#/$defs/contextGetOperand"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "semantics",
            "operator",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "value_compare"
            },
            "semantics": {
              "const": "python"
            },
            "operator": {
              "$ref": "#/$defs/modifierOperator"
            },
            "left": {
              "$ref": "#/$defs/modifierOperand"
            },
            "right": {
              "$ref": "#/$defs/modifierOperand"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "raw",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unsupported"
            },
            "raw": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "enum": [
                "unsupported_domain",
                "unsupported_expression"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fieldType": {
            "const": "monetary"
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "currencyField"
        ],
        "properties": {
          "semanticType": {
            "const": "money"
          },
          "unit": false,
          "temporal": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticType": {
            "const": "percentage"
          }
        },
        "required": [
          "semanticType"
        ]
      },
      "then": {
        "required": [
          "digits",
          "unit"
        ],
        "properties": {
          "fieldType": {
            "enum": [
              "float",
              "integer"
            ]
          },
          "unit": {
            "required": [
              "kind",
              "code",
              "label"
            ],
            "properties": {
              "kind": {
                "const": "percent"
              },
              "code": {
                "const": "percent"
              }
            }
          },
          "currencyField": false,
          "temporal": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticType": {
            "const": "duration"
          }
        },
        "required": [
          "semanticType"
        ]
      },
      "then": {
        "required": [
          "digits",
          "unit"
        ],
        "properties": {
          "fieldType": {
            "enum": [
              "float",
              "integer"
            ]
          },
          "unit": {
            "required": [
              "kind",
              "code",
              "label"
            ],
            "properties": {
              "kind": {
                "const": "duration"
              }
            }
          },
          "currencyField": false,
          "temporal": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticType": {
            "const": "money"
          }
        },
        "required": [
          "semanticType"
        ]
      },
      "then": {
        "required": [
          "currencyField"
        ],
        "properties": {
          "fieldType": {
            "enum": [
              "monetary",
              "float"
            ]
          },
          "unit": false,
          "temporal": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldType": {
            "const": "date"
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "temporal"
        ],
        "properties": {
          "temporal": {
            "properties": {
              "kind": {
                "const": "date"
              }
            }
          },
          "digits": false,
          "currencyField": false,
          "unit": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticType": {
            "const": "date"
          }
        },
        "required": [
          "semanticType"
        ]
      },
      "then": {
        "required": [
          "temporal"
        ],
        "properties": {
          "fieldType": {
            "const": "date"
          },
          "temporal": {
            "properties": {
              "kind": {
                "const": "date"
              },
              "timezoneAuthority": {
                "const": "not_applicable"
              }
            }
          },
          "digits": false,
          "currencyField": false,
          "unit": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldType": {
            "const": "datetime"
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "temporal"
        ],
        "properties": {
          "temporal": {
            "properties": {
              "kind": {
                "const": "datetime"
              }
            }
          },
          "digits": false,
          "currencyField": false,
          "unit": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "semanticType": {
            "const": "datetime"
          }
        },
        "required": [
          "semanticType"
        ]
      },
      "then": {
        "required": [
          "temporal"
        ],
        "properties": {
          "fieldType": {
            "const": "datetime"
          },
          "temporal": {
            "properties": {
              "kind": {
                "const": "datetime"
              },
              "timezoneAuthority": {
                "enum": [
                  "user",
                  "record"
                ]
              }
            }
          },
          "digits": false,
          "currencyField": false,
          "unit": false,
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldType": {
            "enum": [
              "many2one",
              "one2many",
              "many2many"
            ]
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "relation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "relation": {
            "const": "ir.attachment"
          }
        },
        "required": [
          "relation"
        ]
      },
      "then": {
        "required": [
          "attachmentRole"
        ],
        "properties": {
          "attachmentRole": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "attachmentRole": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldType": {
            "const": "selection"
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "selection"
        ]
      }
    },
    {
      "if": {
        "required": [
          "relationActiveActions"
        ]
      },
      "then": {
        "properties": {
          "fieldType": {
            "enum": [
              "many2one",
              "many2many"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "relationActiveActions"
        ],
        "properties": {
          "fieldType": {
            "const": "many2many"
          }
        }
      },
      "then": {
        "properties": {
          "widgetType": {
            "const": "many2many_tags"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fieldType": {
            "const": "many2one_reference"
          }
        },
        "required": [
          "fieldType"
        ]
      },
      "then": {
        "required": [
          "referenceModelField"
        ]
      }
    }
  ]
}
