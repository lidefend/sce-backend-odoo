  "findings": [
    {
      "id": "ID-F-001",
      "class": "incomplete_mapping",
      "severity": "P1",
      "title": "Action execution request does not carry the full ContractV2ActionRule identity",
      "baselineDomain": "contract.action_rule",
      "evidence": [
        "frontend/apps/web/src/app/runtime/actionViewContractActionRuntime.ts::buildContractActionButtonRequest",
        "addons/smart_core/handlers/execute_button.py::_authorize_contract_action"
      ],
      "impact": "Backend feedback cannot correlate a real Action View execution to the canonical action rule.",
      "owner": "P0-C-FIX-01",
      "remediation": "PR #976 propagated actionId, backendIdentity and sourceWidgetId and required backend revalidation; merged as 2a99f01c.",
      "status": "fixed",
      "observedOn": "8b46984d2b896eb104c26348788883993d260beb",
      "fixedBy": "2a99f01c55af1c1cee01bc29d280fa5cc777b12f"
    },
    {
      "id": "ID-F-002",
      "class": "cross_domain_misuse",
      "severity": "P1",
      "title": "Content fingerprints are used as trace fallbacks",
      "baselineDomain": "observability.trace",
      "evidence": [
        "addons/smart_core/core/unified_page_contract_v2_action.py::build_action_partial_update_v2",
        "addons/smart_core/core/unified_page_contract_v2_assembler.py::assemble_unified_page_patch_v2"
      ],
      "impact": "A deterministic content hash is not an observed request trace and can falsely correlate distinct executions.",
      "owner": "P0 identity trace follow-up",
      "remediation": "Require an actual request/response trace or explicitly typed trace-unavailable state; never synthesize a content-hash trace.",
      "status": "open"
    },
    {
      "id": "ID-F-003",
      "class": "incomplete_mapping",
      "severity": "P2",
      "title": "Page Block data allows positional rowKey fallback",
      "baselineDomain": "runtime.collection_row",
      "evidence": [
        "addons/smart_core/core/page_block_data_contract.py::build_data_contract"
      ],
      "impact": "Rows without a producer identity receive row_<index>, which can change after sorting or insertion.",
      "owner": "P0 identity row follow-up",
      "remediation": "Require producer-stable rowKey for business collections; reserve positional identity for explicitly local presentation only.",
      "status": "open"
    },
    {
      "id": "ID-F-004",
      "class": "frontend_inferred_identity",
      "severity": "P3",
      "title": "Record table supplies an index-based rendering key",
      "baselineDomain": "runtime.collection_row",
      "evidence": [
        "frontend/apps/web/src/components/page/blocks/BlockRecordTable.vue::rows"
      ],
      "impact": "The index key is safe only while it remains a table virtualization key and never enters business, action or error identities.",
      "owner": "Frontend presentation",
      "remediation": "Keep as accepted local rendering identity; future business interactions must consume producer rowKey.",
      "status": "accepted_local_identity"
    },
    {
      "id": "ID-F-005",
      "class": "cross_domain_misuse",
      "severity": "P1",
      "title": "File URL and name fallback can act as an attachment locator",
      "baselineDomain": "attachment.record",
      "evidence": [
        "addons/smart_core/handlers/file_download.py::handle",
        "addons/smart_core/handlers/chatter_timeline.py::_load_attachments"
      ],
      "impact": "URL text, latest-record order or name matching can be mistaken for attachment identity, and storage owner is not enough to describe business role.",
      "owner": "P0-B",
      "remediation": "Introduce attachment-fact transport with attachmentId, storageOwner, businessOwner, role and server-authorized actions while preserving the existing file service.",
      "status": "scheduled"
    },
    {
      "id": "ID-F-006",
      "class": "policy_freeze",
      "severity": "P3",
      "title": "Navigation identity is mature and should be frozen",
      "baselineDomain": "navigation.entry",
      "evidence": [
        "frontend/apps/web/src/app/canonicalNavigation.ts::authorityIndex",
        "addons/smart_core/handlers/route_authority_validate.py::_select_route_entry"
      ],
      "impact": "No redesign is required; consumers must preserve exact (menu_id, action_id) and explicit scene references.",
      "owner": "Identity architecture baseline",
      "remediation": "Freeze the current rule.",
      "status": "frozen"
    },
    {
      "id": "ID-F-007",
      "class": "policy_freeze",
      "severity": "P2",
      "title": "Authorization subject remains a server-only execution identity",
      "baselineDomain": "security.authorization_subject",
      "evidence": [
        "addons/smart_core/handlers/file_download.py::resolve_file_download_auth_subject",
