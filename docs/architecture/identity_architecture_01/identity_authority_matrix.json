    },
    {
      "id": "ID-F-008",
      "class": "cross_domain_misuse",
      "severity": "P2",
      "title": "actionId names both native numeric action identity and contract string identity",
      "baselineDomain": "contract.action_rule",
      "evidence": [
        "frontend/apps/web/src/app/action_runtime/useActionViewActionRuntime.ts::ContractActionButtonLike",
