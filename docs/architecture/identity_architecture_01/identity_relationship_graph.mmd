  FIELD -->|declares_field| MODEL
  OCCURRENCE -->|hosts_field| FIELD
  RULE -->|executes_target| ACTION
  RULE -->|navigates_target| SCENE
  RULE -->|source_occurrence| OCCURRENCE
  ROW -->|persisted_reference| RECORD
  ROW -->|owned_by_relation| FIELD
  ATTACHMENT -->|storage_owner| RECORD
  ATTACHMENT -->|business_owner| RECORD
  ATTACHMENT -->|authorized_through| AUTH_SUBJECT
  PRINCIPAL -->|authorizes_as| AUTH_SUBJECT
  AUTH_SUBJECT -->|checks_record_scope| RECORD
