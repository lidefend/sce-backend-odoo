{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sce.local/schemas/unified_page_contract_v2.schema.json",
  "title": "Unified Page Contract v2+",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageInfo",
    "layoutContract",
    "statusContract",
    "actionContract",
    "dataContract",
    "runtimeContract",
    "meta"
  ],
  "properties": {
    "pageInfo": {
      "$ref": "#/$defs/pageInfo"
    },
    "layoutContract": {
      "$ref": "#/$defs/layoutContract"
    },
    "statusContract": {
      "$ref": "#/$defs/statusContract"
    },
    "actionContract": {
      "$ref": "#/$defs/actionContract"
    },
    "dataContract": {
      "$ref": "#/$defs/dataContract"
    },
    "runtimeContract": {
      "$ref": "#/$defs/runtimeContract"
    },
    "formStructureContract": {
      "$ref": "#/$defs/formStructureContract"
    },
    "searchContract": {
      "$ref": "#/$defs/searchContract"
    },
    "workflowContract": {
      "type": "object"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
    },
    "deliveryProfile": {
      "enum": ["full", "mobile_compact", "mobile_primary"]
    },
    "deliveryCountRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containers", "widgets", "actions"],
      "properties": {
        "containers": { "type": "integer", "minimum": 0 },
        "widgets": { "type": "integer", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 }
      }
    },
    "deliveryLimitRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containers", "widgets", "actions"],
      "properties": {
        "containers": { "type": ["integer", "null"], "minimum": 0 },
        "widgets": { "type": ["integer", "null"], "minimum": 0 },
        "actions": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "deliveryTrim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientType", "deliveryProfile", "compact", "limits", "original", "delivered", "omitted"],
      "properties": {
        "clientType": { "enum": ["web_pc", "wx_mini", "harmony_h5"] },
        "deliveryProfile": { "$ref": "#/$defs/deliveryProfile" },
        "compact": { "type": "boolean" },
        "limits": { "$ref": "#/$defs/deliveryLimitRecord" },
        "original": { "$ref": "#/$defs/deliveryCountRecord" },
        "delivered": { "$ref": "#/$defs/deliveryCountRecord" },
        "omitted": { "$ref": "#/$defs/deliveryCountRecord" }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": { "type": "object" },
        "domain": { "type": "array" },
        "contextRaw": { "type": "string" },
        "domainRaw": { "type": "string" },
        "renderProfile": { "enum": ["create", "edit", "readonly"] },
        "order": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "searchContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_sort": { "type": "string" },
        "default_order": { "type": "string" },
        "mode": { "type": "string" },
        "filters": { "type": "array", "items": { "type": "object" } },
        "saved_filters": { "type": "array", "items": { "type": "object" } },
        "group_by": { "type": "array", "items": { "type": "object" } },
        "fields": { "type": "array", "items": { "type": "object" } },
        "search_panel": { "type": "object" },
        "favorites": { "type": "object" },
        "custom": { "type": "object" },
        "ui_labels": { "type": "object" },
        "defaults": { "type": "object" }
      }
    },
    "pageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "sceneKey",
        "pageName",
        "model",
        "viewType",
        "layoutType",
        "renderMode",
        "contractVersion",
        "clientType"
      ],
      "properties": {
        "pageId": {
          "$ref": "#/$defs/id"
        },
        "sceneKey": {
          "$ref": "#/$defs/id"
        },
        "pageName": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "viewType": {
          "enum": [
            "form",
            "list",
            "table",
            "kanban",
            "tree",
            "pivot",
            "graph",
            "calendar",
            "gantt",
            "activity",
            "dashboard",
            "combine"
          ]
        },
        "layoutType": {
          "enum": [
            "form",
            "table",
            "kanban",
            "tree",
            "pivot",
            "graph",
            "calendar",
            "gantt",
            "activity",
            "dashboard",
            "combine"
          ]
        },
        "renderMode": {
          "enum": [
            "governed"
          ]
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^2\\.(0|1|2)\\.[0-9]+$"
        },
        "clientType": {
          "enum": [
            "web_pc",
            "wx_mini",
            "harmony_h5"
          ]
        },
        "deliveryProfile": {
          "$ref": "#/$defs/deliveryProfile"
        }
      }
    },
    "layoutContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "layoutType",
        "adaptMode",
        "containerTree",
        "layoutHints",
        "componentRegistry"
      ],
      "properties": {
        "pageId": {
          "$ref": "#/$defs/id"
        },
        "layoutType": {
          "enum": [
            "form",
            "table",
            "kanban",
            "tree",
            "pivot",
            "graph",
            "calendar",
            "gantt",
            "activity",
            "dashboard",
            "combine"
          ]
        },
        "adaptMode": {
          "enum": [
            "pc",
            "mobile"
          ]
        },
        "containerTree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutNode"
          }
        },
        "layoutHints": {
          "type": "object"
        },
        "componentRegistry": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/componentRegistryEntry"
          }
        },
        "listProfile": {
          "type": "object"
        },
        "activityProfile": {
          "$ref": "#/$defs/activityProfile"
        }
      }
    },
    "activityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityTypeSlots",
        "deadlineSlots",
        "assigneeSlots",
        "fieldOccurrences",
        "nativeAttrs",
        "nodeOccurrences",
        "template",
        "templateQwebPresent",
        "actions",
        "actionCount",
        "sourceAuthority"
      ],
      "properties": {
        "activityTypeSlots": { "type": "object" },
        "deadlineSlots": { "type": "object" },
        "assigneeSlots": { "type": "object" },
        "fieldOccurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/activityFieldOccurrence" }
        },
        "nativeAttrs": { "type": "object" },
        "nodeOccurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/activityNodeOccurrence" }
        },
        "template": { "$ref": "#/$defs/activityTemplate" },
        "templateQwebPresent": { "type": "boolean" },
        "actions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "actionCount": { "type": "integer", "minimum": 0 },
        "sourceAuthority": { "$ref": "#/$defs/activitySourceAuthority" }
      }
    },
    "activitySourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authorities", "projection_only", "no_business_fact_authority", "runtime_carrier"],
      "properties": {
        "kind": { "const": "native_activity_view_projection" },
        "authorities": {
          "type": "array",
          "prefixItems": [
            { "const": "ir.ui.view" },
            { "const": "ir.model.fields" },
            { "const": "ir.actions.act_window" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "projection_only": { "const": true },
        "no_business_fact_authority": { "const": true },
        "runtime_carrier": { "const": "ui.contract.v2.layoutContract.activityProfile" }
      }
    },
    "activityFieldOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "widget",
        "native_locator",
        "occurrence_index",
        "source_position",
        "attributes",
        "text",
        "tail",
        "modifiers",
        "decorations",
        "field_type",
        "currency_field",
        "digits"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" },
        "label": { "type": "string", "pattern": "\\S" },
        "widget": { "type": "string" },
        "native_locator": { "type": "string", "pattern": "\\S" },
        "occurrence_index": { "type": "integer", "minimum": 1 },
        "source_position": { "type": "integer", "minimum": 0 },
        "attributes": { "type": "object" },
        "text": { "type": "string" },
        "tail": { "type": "string" },
        "modifiers": { "type": "string" },
        "decorations": { "type": "array", "items": { "type": "object" } },
        "field_type": { "type": "string" },
        "currency_field": { "type": "string" },
        "digits": {
          "oneOf": [
            { "type": "array", "maxItems": 0 },
            {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    },
    "activityNodeOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "native_locator", "occurrence_index", "source_position", "attributes", "text", "tail"],
      "properties": {
        "tag": { "type": "string", "pattern": "\\S" },
        "native_locator": { "type": "string", "pattern": "\\S" },
        "occurrence_index": { "type": "integer", "minimum": 1 },
        "source_position": { "type": "integer", "minimum": 0 },
        "attributes": { "type": "object" },
        "text": { "type": "string" },
        "tail": { "type": "string" }
      }
    },
    "activityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "native_locator", "occurrence_index", "source_position", "attributes", "text", "tail", "children"],
      "properties": {
        "tag": { "type": "string", "pattern": "\\S" },
        "native_locator": { "type": "string", "pattern": "\\S" },
        "occurrence_index": { "type": "integer", "minimum": 1 },
        "source_position": { "type": "integer", "minimum": 0 },
        "attributes": { "type": "object" },
        "text": { "type": "string" },
        "tail": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/activityNode" }
        }
      }
    },
    "activityTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_locator", "occurrence_index", "names", "nodes"],
      "properties": {
        "native_locator": { "type": "string", "pattern": "\\S" },
        "occurrence_index": { "type": "integer", "minimum": 1 },
        "names": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/activityNode" } }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerId",
        "containerType",
        "title",
        "children",
        "widgetList"
      ],
      "properties": {
        "containerId": {
          "$ref": "#/$defs/id"
        },
        "containerType": {
          "enum": [
            "group",
            "tab",
            "popup",
            "subTable",
            "card",
            "tree",
            "gantt",
            "toolbar",
            "section"
          ]
        },
        "title": {
          "type": "string"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "styleToken": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "string": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layoutNode"
          }
        },
        "widgetList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/widget"
          }
        }
      }
    },
    "layoutNode": {
      "anyOf": [
        {"$ref": "#/$defs/container"},
        {"$ref": "#/$defs/nativeLayoutNode"}
      ]
    },
    "nativeLayoutNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children",
        "widgetList"
      ],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "string": {"type": "string"},
        "label": {"type": "string"},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "displayLabel": {"type": "string"},
        "semanticTitle": {"type": "string"},
        "semanticAnchor": {"type": "string"},
        "containerId": {"$ref": "#/$defs/id"},
        "containerType": {"type": "string"},
        "span": {"type": "integer", "minimum": 1, "maximum": 24},
        "styleToken": {"type": "string"},
        "widgetId": {"type": "string"},
        "fieldCode": {"type": "string"},
        "nativeLocator": {"type": "string", "minLength": 1},
        "occurrenceIndex": {"type": "integer", "minimum": 1},
        "sourcePosition": {"type": "integer", "minimum": 0},
        "widget": {"type": "string"},
        "componentKey": {"type": "string"},
        "componentConfig": {"type": "object"},
        "fieldInfo": {"type": "object"},
        "filename": {"type": "string"},
        "nolabel": {"type": "boolean"},
        "attributes": {"type": "object"},
        "modifiers": {"type": "object"},
        "action": {"type": ["object", "null"]},
        "badge": {"type": "object"},
        "buttonType": {"type": "string"},
        "readonly": {},
        "required": {},
        "invisible": {},
        "column_invisible": {},
        "domain": {},
        "context": {},
        "options": {},
        "visible": {"type": "boolean"},
        "cols": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "col": {"type": ["integer", "string"]},
        "class": {"type": "string"},
        "className": {"type": "string"},
        "fieldSize": {"type": "string"},
        "size": {"type": "string"},
        "formStructure": {"type": "object"},
        "formStructureRole": {"$ref": "#/$defs/formStructureRole"},
        "sourceAuthority": {"type": "object"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/layoutNode"}
        },
        "widgetList": {
          "type": "array",
          "items": {"$ref": "#/$defs/widget"}
        },
        "fields": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widgetId",
        "widgetType",
        "fieldCode",
        "label",
        "span",
        "componentKey",
        "capabilities",
        "componentConfig",
        "ownerContainerId"
      ],
      "properties": {
        "widgetId": {
          "$ref": "#/$defs/id"
        },
        "widgetType": {
          "enum": [
            "input",
            "select",
            "date",
            "datetime",
            "number",
            "table",
            "upload",
            "button",
            "textarea",
            "checkbox",
            "radio",
            "tree",
            "gantt",
            "relation",
            "display",
            "binary",
            "many2many_tags"
          ]
        },
        "fieldCode": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "componentKey": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "componentConfig": {
          "type": "object"
        },
        "ownerContainerId": {"$ref": "#/$defs/id"},
        "nativeLocator": {"type": "string", "minLength": 1},
        "occurrenceIndex": {"type": "integer", "minimum": 1},
        "sourcePosition": {"type": "integer", "minimum": 0},
        "fieldDescriptor": {
          "type": "object"
        },
        "formStructureRole": {
          "$ref": "#/$defs/formStructureRole"
        }
      }
    },
    "formStructureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "structureVersion",
        "model",
        "viewType",
        "mode",
        "layoutPolicy",
        "objectProfile",
        "navigation",
        "slots",
        "fieldRoles",
        "sourceAuthority"
      ],
      "properties": {
        "source": {
          "const": "ui.contract.v2.form_structure_contract"
        },
        "structureVersion": {
          "enum": ["1.0", "1.1"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "viewType": {
          "const": "form"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "presentationMode": {
          "enum": ["task", "workspace"]
        },
        "layoutPolicy": {
          "type": "string",
          "minLength": 1
        },
        "columns": {"type": "integer", "minimum": 1},
        "objectProfile": {
          "$ref": "#/$defs/formStructureObjectProfile"
        },
        "navigation": {
          "$ref": "#/$defs/formStructureNavigation"
        },
        "sourceSectionTitles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "fieldLabels": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formStructureSlot"
          }
        },
        "fieldRoles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/formStructureRole"
          }
        },
        "sourceAuthority": {
          "$ref": "#/$defs/formStructureSourceAuthority"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"structureVersion": {"const": "1.1"}}},
          "then": {"required": ["presentationMode"]}
        },
        {
          "if": {"properties": {"structureVersion": {"const": "1.0"}}},
          "then": {"not": {"required": ["presentationMode"]}}
        }
      ]
    },
    "formStructureObjectProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "kind", "factAuthority"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "kind": {"const": "business_form"},
        "factAuthority": {"type": "string", "minLength": 1}
      }
    },
    "formStructureNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {"title": {"type": "string"}}
    },
    "formStructureSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "title",
        "role"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/formStructureRoleName"
        },
        "readonly": {
          "type": "boolean"
        },
        "fieldRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formStructureGroup"
          }
        }
      }
    },
    "formStructureGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "role",
        "fieldRefs"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/formStructureRoleName"
        },
        "fieldRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "fieldLabels": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "columns": {"type": "integer", "minimum": 1}
      }
    },
    "formStructureRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "slot",
        "group"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/formStructureRoleName"
        },
        "slot": {
          "$ref": "#/$defs/id"
        },
        "group": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "formStructureRoleName": {
      "enum": [
        "summary", "task", "context", "risk", "relation", "activity", "audit"
      ]
    },
    "formStructureSourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "runtime_carrier", "projection_only", "no_business_fact_authority",
        "governed_form_structure", "governance_source"
      ],
      "properties": {
        "kind": {"const": "unified_page_contract_v2"},
        "runtime_carrier": {"const": "ui.contract.v2.form_structure_contract"},
        "projection_only": {"const": true},
        "no_business_fact_authority": {"const": true},
        "governed_form_structure": {"const": true},
        "governance_source": {"$ref": "#/$defs/formStructureGovernanceSource"}
      }
    },
    "formStructureGovernanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "ownerLayer": {"type": "string", "minLength": 1},
        "businessConfigContracts": {
          "type": "array",
          "items": {"$ref": "#/$defs/formStructureGovernanceContract"}
        },
        "legacyFieldPolicyOverlay": {"type": "boolean"},
        "formLayoutOverlay": {"type": "boolean"},
        "formStructureAuthority": {"type": "string"},
        "fieldNames": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "fieldLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "fieldSemanticRoles": {
          "type": "object",
          "additionalProperties": {"enum": ["summary", "task", "context", "risk", "relation", "activity", "audit"]}
        },
        "sectionSemanticRoles": {
          "type": "object",
