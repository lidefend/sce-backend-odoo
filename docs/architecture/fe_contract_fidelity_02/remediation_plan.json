  "batches": [
    {
      "id": "FCF-02-1",
      "title": "Unified business semantic authority",
      "priority": "P1",
      "status": "planned",
      "depends_on": [],
      "findings": [
        "FCF-01",
        "FCF-06",
        "FCF-07",
        "FCF-08"
      ],
      "surfaces": [
        "form",
        "list",
        "kanban",
        "readonly_detail",
        "shared_value_interpreters",
        "one2many_regression"
      ],
      "objectives": [
        "Make the contract-aware path the only business semantic decision authority.",
        "Preserve componentKey and field descriptors through generic and professional readonly controls.",
        "Fail closed on unknown selection values instead of exposing storage keys.",
        "Preserve relation identity and apply field descriptors to Kanban title fallback."
      ],
      "acceptance": [
        "unknown selection negative tests enter a contract-gap state and never render raw keys",
        "relation tuple, object and bare-ID negative tests preserve identity or fail closed",
        "componentKey propagation tests cover money, percentage, duration and status",
        "empty, zero, negative, boolean and unknown values have discriminating tests",
        "affected component browser checks pass at 1440 and 390",
        "One2many edit, dirtyFields, onchange, row identity and save payload regressions remain unchanged"
      ],
      "exit_criteria": [
        "FCF-01, FCF-06, FCF-07 and FCF-08 are closed",
        "production bypasses of the semantic authority are removed or explicitly classified"
      ]
    },
    {
      "id": "FCF-02-2",
      "title": "Preserve semantic transport",
      "priority": "P1",
      "status": "planned",
      "depends_on": [
        "FCF-02-1",
        "CFG-GAP-02",
        "CFG-GAP-04",
        "CFG-GAP-05"
      ],
      "findings": [
        "FCF-02",
        "FCF-03"
      ],
      "surfaces": [
        "readonly_detail",
        "page_blocks",
        "form",
        "one2many",
        "dialog_drawer"
      ],
      "objectives": [
        "Stop stringifying business values in readonly collection and page-block bridges.",
        "Transport raw value, field identity and presentation context together.",
        "Make the final renderer consume semantic facts rather than reconstruct them from text.",
        "Move genuinely absent declarations to a P0 producer-layer gap."
      ],
      "acceptance": [
        "rawValue retains the original backend type through bridge-to-renderer transport",
        "the field descriptor retains every applicable type, widget, componentKey, digits, currency, unit, selection, temporal and attachment semantic",
        "relation identity includes verifiable record identity and the authoritative display label",
        "attachment identity, record ownership, semantic role, authorized action and failure feedback each have an explicit contract source",
        "Page Block action target, permission result, disabled reason, error reason code, message and trace identity survive bridge-to-renderer transport",
        "currency and timezone come from authoritative runtime context rather than display labels or browser defaults",
        "display values never become ORM write values",
        "ordinary integers and textual URLs do not trigger attachment behavior",
        "missing page-block declarations fail closed with a visible contract gap",
        "read-only browser journeys create no persistent business-write intent",
        "1440 and 390 layout checks show no horizontal overflow"
      ],
      "design_gate": [
        "raw_value_type_preservation",
        "complete_field_descriptor",
        "verifiable_relation_identity",
        "complete_attachment_identity_and_actions",
        "page_block_action_and_feedback_identity",
        "authoritative_currency_and_timezone",
        "display_write_separation"
      ],
      "exit_criteria": [
        "FCF-02 and FCF-03 are closed",
        "no unregistered adapter stringifies a declared business value"
      ]
    },
    {
      "id": "FCF-02-3",
      "title": "Remove frontend-invented business rules",
      "priority": "P1",
      "status": "planned",
      "depends_on": [
        "FCF-02-1",
        "FCF-02-2",
        "CFG-GAP-03"
      ],
      "findings": [
        "FCF-04",
        "FCF-05"
      ],
      "surfaces": [
        "page_blocks",
        "my_work"
      ],
      "objectives": [
        "Remove the percent fallback, value clamping and rounding from Progress Summary.",
        "Remove the default two-decimal precision from My Work.",
        "Consume declared percentage, currency, selection, relation and duration facts.",
        "Fail closed when a required declaration is missing."
      ],
      "acceptance": [
        "missing unit, precision, percentage identity or currency enters a contract-gap state",
        "zero, negative and greater-than-100 raw facts are not altered by the frontend",
        "the same money value shares currency and scale across My Work, List, Form and One2many",
        "My Work percentage uses a percentage semantic instead of generic string output",
        "My Work action, sorting, grouping and target routing regressions remain unchanged"
      ],
      "exit_criteria": [
        "FCF-04 and FCF-05 are closed",
        "no unregistered frontend default supplies a business unit or precision"
      ]
    },
