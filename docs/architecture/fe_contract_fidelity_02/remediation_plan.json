    "Contract V2 schema decode",
    "field modifiers and readonly/required projection",
    "action status, target, reason and executor",
    "canonical navigation and route authority",
    "semantic registry",
    "List aggregate currency identity",
    "One2many relation identity, percentage identity and declared digits"
