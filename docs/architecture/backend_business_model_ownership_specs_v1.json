        {
          "action_xmlid": "smart_construction_core.action_sc_settlement_order_income",
          "required_domain_tokens": ["contract_source_kind", "general_contract"]
        },
        {
          "action_xmlid": "smart_construction_core.action_sc_settlement_order_expense",
          "required_domain_tokens": ["contract_source_kind", "general_contract"]
        }
      ],
      "conservation_invariants": [
        "one_settlement_has_exactly_one_contract_source_when_submitted",
        "general_contract_direction_determines_settlement_direction",
        "project_company_partner_and_currency_match_the_source_contract",
        "payment_and_invoice_retain_the_settlement_contract_source_identity"
      ],
      "authority_carriers": [
        "addons/smart_construction_core/models/core/daily_contract_settlement.py",
        "addons/smart_construction_core/security/contract_settlement_capability_bridge.xml",
        "addons/smart_construction_core/views/menu_product_contract_completion_v1.xml",
        "addons/smart_construction_core/data/daily_contract_settlement_contract.xml"
      ],
      "frontend_policy": "contract_renderer_only"
    },
    {
