{
  "schema": "backend_business_model_ownership_specs_v1",
  "status": "draft architecture audit",
  "purpose": "Declare ownership boundaries for model families where current architecture is reasonable but overlap risk remains.",
  "ownership_specs": [
    {
      "spec": "contract_ownership_split",
      "risk_family": "contract execution",
      "business_object": "bilateral_mixed",
      "fact_source_model": ["construction.contract", "construction.contract.income", "construction.contract.expense", "sc.general.contract"],
      "allowed_support_models": ["construction.contract.professional.mixin", "construction.contract.line", "sc.contract.event", "sc.contract.recon.summary"],
      "projection_models": ["sc.contract.recon.summary"],
      "boundary_rule": "Project construction contracts own project commercial commitments; professional income/expense models specialize direction; general contracts own procurement/general commitments outside the project contract center.",
      "forbidden_drift": "Do not let sc.general.contract, construction.contract, and construction.contract.income/expense independently own the same commitment without a declared direction and source record.",
      "decision": "Keep all four surfaces for now, but require new contract fields to declare whether they describe income commitment, expense commitment, general procurement, or derived reconciliation."
    },
    {
      "spec": "treasury_account_reconciliation_ledger_split",
      "risk_family": "treasury account operations",
      "business_object": "bilateral_mixed",
      "fact_source_model": ["sc.fund.account", "sc.treasury.reconciliation"],
      "allowed_support_models": ["sc.fund.account.operation"],
      "projection_models": ["sc.treasury.ledger", "sc.fund.daily.summary", "sc.account.income.expense.summary"],
      "boundary_rule": "Fund account is account master data; treasury reconciliation is an auditable reconciliation document; treasury ledger and fund summaries are rebuildable read models.",
      "forbidden_drift": "Do not write cash movement workflow facts directly into ledger/summary models, and do not use fund account master as a transaction table.",
      "decision": "Keep account master, reconciliation, and ledger separate; add new treasury behavior only to the layer that owns the fact."
    },
    {
      "spec": "material_product_catalog_split",
      "risk_family": "product and material identity",
      "business_object": "expense",
      "fact_source_model": ["product.template", "sc.material.catalog"],
      "allowed_support_models": ["sc.material.price", "sc.legacy.material.category", "sc.legacy.material.detail"],
      "projection_models": ["sc.material.stock.summary"],
      "boundary_rule": "Native product owns product identity and integration; material catalog owns construction-visible classification, legacy material surface, and industry search semantics.",
      "forbidden_drift": "Do not create a second independent product identity in sc.material.catalog; catalog records must map or project to native product identity when operational flow requires it.",
      "decision": "Treat product.template as identity root and material catalog as construction-industry surface."
    },
    {
      "spec": "payment_request_execution_split",
      "risk_family": "payment request and execution",
      "business_object": "expense",
      "fact_source_model": ["payment.request", "sc.payment.execution"],
      "allowed_support_models": ["payment.request.line", "sc.expense.claim"],
      "projection_models": ["sc.ar.ap.project.summary", "sc.ar.ap.company.summary", "sc.expense.reimbursement.summary"],
      "boundary_rule": "Payment request owns business intent and approval; payment execution owns confirmed payment fact; expense claim owns reimbursement/deposit/deduction claims before settlement or execution.",
      "forbidden_drift": "Do not mark a payment request as the final cash fact unless sc.payment.execution or an accounting integration fact exists.",
      "decision": "Keep request, claim, and execution separate, with projections aggregating their state instead of replacing them."
    },
    {
      "spec": "project_salary_calculation_payment_split",
      "risk_family": "project salary calculation and payment",
      "business_object": "expense",
      "fact_source_model": ["sc.hr.payroll.document", "sc.hr.salary.payment"],
      "allowed_support_models": ["project.project", "res.users"],
      "projection_models": ["sc.salary.summary", "sc.comprehensive.cost.summary"],
      "boundary_rule": "Payroll calculation owns the recognized project salary cost and payable amount; salary payment owns each confirmed cash-payment evidence row and may only reduce the payable balance through a conserved relation to a completed calculation.",
      "forbidden_drift": "Do not reuse payroll calculation as a payment register, write payment facts directly into summary projections, let a menu or frontend contract choose another fact owner, or recognize draft calculations as project cost.",
      "decision": "Keep calculation and payment as separate P1 fact models linked one-to-many; expose them through distinct governed entries and action-scoped rendering contracts.",
      "formal_product_layer": "P1",
      "layer_target": "L2_industry_standard",
      "module": "smart_construction_core",
      "standard_vs_user_specific": "construction_industry_standard",
      "separation_policy": "distinct_fact_models",
      "fact_roles": {
        "calculation": "recognized_salary_cost_and_payable_authority",
        "payment": "confirmed_salary_payment_evidence_authority",
        "projection": "rebuildable_management_visibility_only",
        "contract": "action_scoped_rendering_only"
      },
      "entry_bindings": [
        {
          "intent": "salary_calculation",
          "menu_xmlid": "smart_construction_core.menu_sc_product_project_payroll_v1",
          "action_xmlid": "smart_construction_core.action_sc_product_project_payroll_v1",
          "fact_model": "sc.hr.payroll.document",
          "view_contract_xmlid": "smart_construction_core.business_config_contract_project_payroll_productized_form_v1"
        },
        {
          "intent": "salary_payment",
          "menu_xmlid": "smart_construction_core.menu_sc_product_project_salary_payment_v1",
          "action_xmlid": "smart_construction_core.action_sc_product_project_salary_payment_v1",
          "fact_model": "sc.hr.salary.payment",
          "view_contract_xmlid": "smart_construction_core.business_config_contract_project_salary_payment_productized_form_v1"
        }
      ],
      "conservation_invariants": [
        "confirmed_payment_total_must_not_exceed_completed_payroll_net_salary",
        "calculation_cost_recognition_requires_done_state",
        "payment_cancellation_recomputes_payroll_payment_balance"
      ],
      "authority_carriers": [
        "addons/smart_construction_core/models/core/hr_payroll_document.py",
        "addons/smart_construction_core/security/ir.model.access.csv",
        "addons/smart_construction_core/security/sc_record_rules.xml",
        "addons/smart_construction_core/views/menu_product_contract_completion_v1.xml",
        "addons/smart_construction_core/data/hr_payroll_form_productization_contract.xml"
      ],
      "frontend_policy": "contract_renderer_only"
    },
    {
      "spec": "daily_contract_settlement_source_bridge",
      "risk_family": "general contract and settlement execution",
      "business_object": "bilateral_mixed",
      "fact_source_model": ["sc.general.contract", "sc.settlement.order"],
      "allowed_support_models": ["sc.settlement.order.line", "payment.request", "sc.invoice.registration"],
      "projection_models": ["sc.expense.contract.ledger", "sc.income.contract.ledger"],
      "boundary_rule": "General contract owns the daily contract commitment; settlement order owns settlement workflow and amounts. The two explicit source relations are mutually exclusive and downstream payment or invoice documents identify the general contract through the settlement source projection.",
      "forbidden_drift": "Do not cast a general contract into construction.contract, create a parallel daily settlement model, allow both source relations on one settlement, or infer the source model in frontend code.",
      "decision": "Extend the canonical settlement order with an explicit general-contract source while preserving the existing construction-contract relation and one settlement workflow.",
      "formal_product_layer": "P1",
      "layer_target": "L2_industry_standard",
      "module": "smart_construction_core",
      "standard_vs_user_specific": "construction_industry_standard",
      "entry_bindings": [
        {
          "intent": "daily_contract_settlement",
          "menu_xmlid": "smart_construction_core.menu_sc_product_general_contract_settlement_v1",
