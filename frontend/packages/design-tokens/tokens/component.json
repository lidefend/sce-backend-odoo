  "badge": {
    "radius": "{radius.pill}",
    "padding_x": "{space.xs}",
    "padding_y": "{space.2xs}",
    "font_size": "{font.size_sm}"
  },
  "tag": {
    "radius": "{radius.sm}",
    "padding_x": "{space.xs}",
    "padding_y": "{space.2xs}"
