{
  "button": {
    "height_sm": 30,
    "height_md": 36,
    "height_lg": 42,
    "loading_duration": "{motion.slow}",
    "disabled_opacity": "{opacity.disabled}",
    "overflow_z_index": "{z_index.dropdown}",
    "radius": "{radius.md}",
    "padding_x": "{space.md}",
    "padding_y": "{space.xs}",
    "font_size": "{font.size_md}"
  },
  "panel": {
    "radius": "{radius.md}",
    "padding": "{space.md}",
    "border_width": 1
  },
  "card": {
    "radius": "{radius.md}",
    "padding": "{space.md}"
  },
  "toolbar": {
    "radius": "{radius.md}",
    "padding_x": "{space.xs}",
    "padding_y": "{space.2xs}",
    "gap": "{space.xs}"
  },
  "shell": {
    "topbar_height": 48,
    "sidebar_width": 248,
    "sidebar_collapsed_width": 56,
    "navigation_item_height": 44,
    "navigation_search_icon_z_index": 1,
    "page_gutter": 24
  },
  "input": {
    "height_sm": 28,
    "height_md": 32,
    "height_lg": 40,
